module

public import PDE.Elliptic.Homogenization.Cell

/-!
# The one-dimensional Dirichlet solution

For continuous forcing `f`, integrate the flux equation once, obtaining
`a(x / ε) u'(x) = C - ∫₀ˣ f`. The second integration constructs the solution;
the right Dirichlet condition determines `C`. The resulting solution is `C¹`
even when the coefficient is only continuous, and its flux is `C¹` and solves
the divergence-form equation pointwise. An integration-by-parts theorem also
records the weak equation against continuously differentiable test functions.
-/

@[expose] public section

noncomputable section

open PDE.Analysis (primitive hasDerivAt_primitive continuous_primitive)

namespace PDE.Elliptic.Homogenization.PeriodicMedium

open MeasureTheory Set
open PDE.Analysis.PeriodicAveraging

variable (a : PeriodicMedium)

/-- Integrated reciprocal resistance at microscopic scale `ε`. -/
def resistance (ε x : ℝ) : ℝ := primitive (fun y ↦ a.reciprocal (y / ε)) x

/-- The weighted resistance generated by the primitive of the forcing. -/
def weightedResistance (f : ℝ → ℝ) (ε x : ℝ) : ℝ :=
  primitive (fun y ↦ primitive f y * a.reciprocal (y / ε)) x

/-- The flux constant selected by the two zero Dirichlet endpoints. -/
def fluxConstant (f : ℝ → ℝ) (ε : ℝ) : ℝ :=
  a.weightedResistance f ε 1 / a.resistance ε 1

/-- The constructed oscillatory Dirichlet solution on the unit interval. -/
def solution (f : ℝ → ℝ) (ε x : ℝ) : ℝ :=
  a.fluxConstant f ε * a.resistance ε x - a.weightedResistance f ε x

/-- The solution for the effective constant coefficient. -/
def homogenizedSolution (f : ℝ → ℝ) (x : ℝ) : ℝ :=
  a.meanReciprocal * (primitive (primitive f) 1 * x - primitive (primitive f) x)

/-- Continuity of the rescaled reciprocal coefficient. -/
theorem continuous_rescaled_reciprocal (ε : ℝ) :
    Continuous (fun y ↦ a.reciprocal (y / ε)) :=
  a.continuous_reciprocal.comp (continuous_id.div_const ε)

/-- The total resistance is strictly positive. -/
theorem resistance_one_pos (ε : ℝ) : 0 < a.resistance ε 1 := by
  exact intervalIntegral.integral_pos zero_lt_one
    (a.continuous_rescaled_reciprocal ε).continuousOn
    (fun y _ ↦ (a.reciprocal_pos (y / ε)).le)
    ⟨0, by simp, a.reciprocal_pos (0 / ε)⟩

/-- The derivative of the resistance is the rescaled reciprocal. -/
theorem hasDerivAt_resistance (ε x : ℝ) :
    HasDerivAt (a.resistance ε) (a.reciprocal (x / ε)) x :=
  hasDerivAt_primitive (a.continuous_rescaled_reciprocal ε) x

/-- The derivative of the weighted resistance is its continuous integrand. -/
theorem hasDerivAt_weightedResistance {f : ℝ → ℝ} (hf : Continuous f) (ε x : ℝ) :
    HasDerivAt (a.weightedResistance f ε)
      (primitive f x * a.reciprocal (x / ε)) x :=
  hasDerivAt_primitive
    ((continuous_primitive hf).mul (a.continuous_rescaled_reciprocal ε)) x

/-- The flux formula supplies the derivative of the constructed solution. -/
theorem hasDerivAt_solution {f : ℝ → ℝ} (hf : Continuous f) (ε x : ℝ) :
    HasDerivAt (a.solution f ε)
      ((a.fluxConstant f ε - primitive f x) * a.reciprocal (x / ε)) x := by
  unfold solution
  convert ((a.hasDerivAt_resistance ε x).const_mul (a.fluxConstant f ε)).fun_sub
    (a.hasDerivAt_weightedResistance hf ε x) using 1
  ring

/-- The oscillatory solution has a continuous first derivative. -/
theorem contDiff_solution {f : ℝ → ℝ} (hf : Continuous f) (ε : ℝ) :
    ContDiff ℝ 1 (a.solution f ε) := by
  rw [contDiff_one_iff_deriv]
  refine ⟨fun x ↦ (a.hasDerivAt_solution hf ε x).differentiableAt, ?_⟩
  have hd : deriv (a.solution f ε) =
      fun x ↦ (a.fluxConstant f ε - primitive f x) * a.reciprocal (x / ε) :=
    funext fun x ↦ (a.hasDerivAt_solution hf ε x).deriv
  rw [hd]
  exact (continuous_const.sub (continuous_primitive hf)).mul
    (a.continuous_rescaled_reciprocal ε)

/-- The left endpoint vanishes by normalization of the primitives. -/
@[simp] theorem solution_zero (f : ℝ → ℝ) (ε : ℝ) : a.solution f ε 0 = 0 := by
  simp [solution, resistance, weightedResistance]

/-- The flux constant imposes the right endpoint. -/
@[simp] theorem solution_one (f : ℝ → ℝ) (ε : ℝ) : a.solution f ε 1 = 0 := by
  unfold solution fluxConstant
  rw [div_mul_cancel₀ _ (a.resistance_one_pos ε).ne', sub_self]

/-- The physical flux is the primitive dictated by the source. -/
theorem solution_flux {f : ℝ → ℝ} (hf : Continuous f) (ε x : ℝ) :
    a.coefficient (x / ε) * deriv (a.solution f ε) x =
      a.fluxConstant f ε - primitive f x := by
  rw [(a.hasDerivAt_solution hf ε x).deriv]
  dsimp [reciprocal]
  have ha := (a.positive (x / ε)).ne'
  field_simp

/-- The constructed solution satisfies `-(a(x/ε) u')' = f` in classical flux form. -/
theorem hasDerivAt_solution_flux {f : ℝ → ℝ} (hf : Continuous f) (ε x : ℝ) :
    HasDerivAt (fun y ↦ a.coefficient (y / ε) * deriv (a.solution f ε) y) (-f x) x := by
  simp_rw [a.solution_flux hf]
  convert (hasDerivAt_primitive hf x).const_sub (a.fluxConstant f ε) using 1

/-- The divergence-form equation written using the derivative of the physical flux. -/
theorem solution_equation {f : ℝ → ℝ} (hf : Continuous f) (ε x : ℝ) :
    -deriv (fun y ↦ a.coefficient (y / ε) * deriv (a.solution f ε) y) x = f x := by
  rw [(a.hasDerivAt_solution_flux hf ε x).deriv, neg_neg]

/-- The weak equation against any `C¹` test function vanishing at both endpoints. -/
theorem solution_weak_equation {f φ ψ : ℝ → ℝ} (hf : Continuous f)
    (hφ : ∀ x, HasDerivAt φ (ψ x) x) (hψ : Continuous ψ)
    (hφ0 : φ 0 = 0) (hφ1 : φ 1 = 0) (ε : ℝ) :
    (∫ x in (0 : ℝ)..1, a.coefficient (x / ε) * deriv (a.solution f ε) x * ψ x) =
      ∫ x in (0 : ℝ)..1, f x * φ x := by
  simp_rw [a.solution_flux hf]
  have hφc : Continuous φ :=
    (show Differentiable ℝ φ from fun x ↦ (hφ x).differentiableAt).continuous
  have hd (x : ℝ) :
      HasDerivAt (fun y ↦ a.fluxConstant f ε - primitive f y) (-f x) x := by
    convert (hasDerivAt_primitive hf x).const_sub (a.fluxConstant f ε) using 1
  rw [intervalIntegral.integral_mul_deriv_eq_deriv_mul_of_hasDerivAt
    (u := fun y ↦ a.fluxConstant f ε - primitive f y) (v := φ)
    (continuous_const.sub (continuous_primitive hf)).continuousOn hφc.continuousOn
    (fun x _ ↦ hd x) (fun x _ ↦ hφ x) (hf.neg.intervalIntegrable 0 1)
    (hψ.intervalIntegrable 0 1), hφ1, hφ0]
  simp only [mul_zero, sub_self, zero_sub, neg_mul, intervalIntegral.integral_neg, neg_neg]

/-- The effective solution vanishes at the left endpoint. -/
@[simp] theorem homogenizedSolution_zero (f : ℝ → ℝ) : a.homogenizedSolution f 0 = 0 := by
  simp [homogenizedSolution]

/-- The effective solution vanishes at the right endpoint. -/
@[simp] theorem homogenizedSolution_one (f : ℝ → ℝ) : a.homogenizedSolution f 1 = 0 := by
  simp [homogenizedSolution]

/-- The effective solution has the expected gradient. -/
theorem hasDerivAt_homogenizedSolution {f : ℝ → ℝ} (hf : Continuous f) (x : ℝ) :
    HasDerivAt (a.homogenizedSolution f)
      (a.meanReciprocal * (primitive (primitive f) 1 - primitive f x)) x := by
  unfold homogenizedSolution
  convert (((hasDerivAt_id x).const_mul (primitive (primitive f) 1)).fun_sub
    (hasDerivAt_primitive (continuous_primitive hf) x)).const_mul a.meanReciprocal using 1 <;>
    simp

/-- The effective solution has a continuous first derivative. -/
theorem contDiff_homogenizedSolution {f : ℝ → ℝ} (hf : Continuous f) :
    ContDiff ℝ 1 (a.homogenizedSolution f) := by
  rw [contDiff_one_iff_deriv]
  refine ⟨fun x ↦ (a.hasDerivAt_homogenizedSolution hf x).differentiableAt, ?_⟩
  have hd : deriv (a.homogenizedSolution f) =
      fun x ↦ a.meanReciprocal * (primitive (primitive f) 1 - primitive f x) :=
    funext fun x ↦ (a.hasDerivAt_homogenizedSolution hf x).deriv
  rw [hd]
  exact continuous_const.mul (continuous_const.sub (continuous_primitive hf))

/-- The effective solution's flux is the averaged flux. -/
theorem homogenizedSolution_flux {f : ℝ → ℝ} (hf : Continuous f) (x : ℝ) :
    a.effective * deriv (a.homogenizedSolution f) x =
      primitive (primitive f) 1 - primitive f x := by
  rw [(a.hasDerivAt_homogenizedSolution hf x).deriv]
  simp only [effective, ← mul_assoc, inv_mul_cancel₀ a.meanReciprocal_pos.ne', one_mul]

/-- The effective Dirichlet solution solves the homogenized equation. -/
theorem homogenizedSolution_equation {f : ℝ → ℝ} (hf : Continuous f) (x : ℝ) :
    -deriv (fun y ↦ a.effective * deriv (a.homogenizedSolution f) y) x = f x := by
  simp_rw [a.homogenizedSolution_flux hf]
  have hd : HasDerivAt (fun y ↦ primitive (primitive f) 1 - primitive f y) (-f x) x := by
    convert (hasDerivAt_primitive hf x).const_sub (primitive (primitive f) 1) using 1
  rw [hd.deriv, neg_neg]

end PDE.Elliptic.Homogenization.PeriodicMedium
