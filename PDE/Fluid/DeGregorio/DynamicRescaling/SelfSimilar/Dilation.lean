module

public import PDE.Fluid.DeGregorio.DynamicRescaling.SelfSimilar.WeakProfile
import PDE.Spaces.Sobolev.Calculus.Slicing.LineRepresentative.ContinuousDerivative

/-!
# Dilating a self-similar profile

The self-similar equation (1.4) of Chen, Hou and Huang is invariant under
`Ω ↦ Ω(λ ·)` for `λ > 0` when the velocity changes to `U(λ ·) / λ`: the stationary
residual of the dilated pair at `x` is the residual of the original pair at `λ x`.
Positive dilation also preserves the Hilbert relation, so the expanding fields (1.5)
generated by a dilated stationary profile again solve the equation almost everywhere.

The dilation matters for asymptotics. With equal normalization rates and unit initial
scales, the amplitude and length scales behave like `C_ω ~ |c| (T - t)` and
`C_l ~ 1 / (|c| (T - t))`, so a dynamically rescaled limit `Ω` with rate `c` corresponds to
the field (1.5) of `Ω(|c| ·)`, not to that of `Ω` itself.

## Main results

* `stationaryResidual_comp_mul`: the stationary residual commutes with dilation.
* `expandingSelfSimilarFields_comp_mul_solves_ae`,
  `expandingSelfSimilarFields_comp_mul_solves_ae_of_h1`: the expanding fields `(1.5)` of a
  dilated stationary profile solve the equation almost everywhere.

## References

* J. Chen, T. Y. Hou, and D. Huang, "On the finite time blowup of the De Gregorio model for the 3D
  Euler equations", *Comm. Pure Appl. Math.* 74 (2021), no. 6, 1282-1350; numbering of
  arXiv:1905.06387v3, Section 1.2, (1.4) and (1.5), p. 2.
  <https://doi.org/10.1002/cpa.21991>
  <https://arxiv.org/abs/1905.06387v3>
-/

@[expose] public noncomputable section

open MeasureTheory Set PDE.Analysis SobolevSpace.GraphSpace
open scoped Sobolev

namespace DeGregorio

variable {a cl cw : ℝ} {ω u : ℝ → ℝ} {l : ℝ}

/-- Dilation invariance of the stationary residual: the dilated pair
`(ω(l ·), u(l ·) / l)` has at `x` the residual of `(ω, u)` at `l x`. -/
theorem stationaryResidual_comp_mul (a cl cw : ℝ) (ω u : ℝ → ℝ) (hl : l ≠ 0) (x : ℝ) :
    stationaryResidual a cl cw (fun y ↦ ω (l * y)) (fun y ↦ u (l * y) / l) x =
      stationaryResidual a cl cw ω u (l * x) := by
  simp only [stationaryResidual, deriv_div_const, deriv_comp_mul_left, smul_eq_mul]
  field_simp

/-- An almost-everywhere stationary pair stays stationary almost everywhere
after a positive dilation. -/
theorem ae_stationaryResidual_comp_mul (hl : 0 < l)
    (hs : ∀ᵐ x ∂volume, stationaryResidual a cl cw ω u x = 0) :
    ∀ᵐ x ∂volume,
      stationaryResidual a cl cw (fun y ↦ ω (l * y)) (fun y ↦ u (l * y) / l) x = 0 := by
  filter_upwards [(quasiMeasurePreserving_real_dilation hl.ne').ae hs] with x hx
  rw [stationaryResidual_comp_mul a cl cw ω u hl.ne' x]
  exact hx

/-- The expanding fields (1.5) generated by a positive dilation of an
almost-everywhere stationary profile solve the equation almost everywhere, and
satisfy the Hilbert relation, at every time before `T`. -/
theorem expandingSelfSimilarFields_comp_mul_solves_ae {F U : ℝ → ℝ} {c T t : ℝ}
    (hc : c < 0) (hl : 0 < l)
    (hF : ∀ᵐ x ∂volume, DifferentiableAt ℝ F x)
    (hU : ∀ᵐ x ∂volume, DifferentiableAt ℝ U x)
    (hstationary : ∀ᵐ x ∂volume, stationaryResidual a c c F U x = 0)
    (hpair : IsHilbertPair F (deriv U)) (ht : t < T) :
    let S := expandingSelfSimilarFields (fun y ↦ F (l * y)) (fun y ↦ U (l * y) / l) c T
    (∀ᵐ x ∂volume,
      DifferentiableAt ℝ (S.vorticity x) t ∧
      DifferentiableAt ℝ (fun y ↦ S.vorticity y t) x ∧
      DifferentiableAt ℝ (fun y ↦ S.velocity y t) x ∧
      transportResidual a S x t = 0) ∧
    IsHilbertPair (fun x ↦ S.vorticity x t) (deriv (fun x ↦ S.velocity x t)) := by
  have hdilation := quasiMeasurePreserving_real_dilation hl.ne'
  have hFl : ∀ᵐ x ∂volume, DifferentiableAt ℝ (fun y ↦ F (l * y)) x := by
    filter_upwards [hdilation.ae hF] with x hx
    exact hx.comp x ((differentiableAt_id).const_mul l)
  have hUl : ∀ᵐ x ∂volume, DifferentiableAt ℝ (fun y ↦ U (l * y) / l) x := by
    filter_upwards [hdilation.ae hU] with x hx
    exact (hx.comp x ((differentiableAt_id).const_mul l)).div_const l
  have hpairl : IsHilbertPair (fun y ↦ F (l * y)) (deriv (fun y ↦ U (l * y) / l)) := by
    have h := hpair.dilate hl
    rwa [show (fun x ↦ deriv U (l * x)) = deriv (fun y ↦ U (l * y) / l) from
      funext fun x ↦ by
        rw [deriv_div_const, deriv_comp_mul_left, smul_eq_mul, mul_div_cancel_left₀ _ hl.ne']] at h
  exact expandingSelfSimilarFields_solves_ae hc hFl hUl
    (ae_stationaryResidual_comp_mul hl hstationary) hpairl ht

/-- The H¹ form: a stationary Sobolev graph with a continuous weak velocity generates,
after any positive dilation, expanding fields (1.5) that solve the equation almost
everywhere at every time before `T`. -/
theorem expandingSelfSimilarFields_comp_mul_solves_ae_of_h1
    {F : W^{1,2}(ℝ^1)} {U : ℝ → ℝ} {c T t : ℝ} (hc : c < 0) (hl : 0 < l)
    (hU : Continuous U)
    (hweak : Evolution.HasWeakTimeDerivativeOn univ U (deriv U))
    (hstationary : ∀ᵐ x ∂volume,
      stationaryResidual a c c (realLineRepresentative F) U x = 0)
    (hpair : IsHilbertPair (realLineRepresentative F) (deriv U)) (ht : t < T) :
    let S := expandingSelfSimilarFields (fun y ↦ realLineRepresentative F (l * y))
      (fun y ↦ U (l * y) / l) c T
    (∀ᵐ x ∂volume,
      DifferentiableAt ℝ (S.vorticity x) t ∧
      DifferentiableAt ℝ (fun y ↦ S.vorticity y t) x ∧
      DifferentiableAt ℝ (fun y ↦ S.velocity y t) x ∧
      transportResidual a S x t = 0) ∧
    IsHilbertPair (fun x ↦ S.vorticity x t) (deriv (fun x ↦ S.velocity x t)) := by
  have hF := SobolevSpace.Slices.ae_hasDerivAt_lineRepresentative_of_locallyIntegrable
    (f := realLineCoordinateCLM (baseIndex 1 1) F)
    (locallyIntegrableOn_univ.mp
      (hasWeakTimeDerivativeOn_realLineCoordinates F).locallyIntegrable_g)
  exact expandingSelfSimilarFields_comp_mul_solves_ae hc hl
    (hF.mono fun _ hx ↦ hx.differentiableAt)
    ((hweak.ae_hasDerivAt_of_continuous hU).mono fun _ hx ↦ hx.differentiableAt)
    hstationary hpair ht

end DeGregorio
