module

public import PDE.Fluid.DeGregorio.DynamicRescaling.SelfSimilar
public import PDE.Spaces.Sobolev.GraphSpace.RealLine.Representative
import PDE.Spaces.Sobolev.Calculus.Slicing.LineRepresentative.ContinuousDerivative

/-!
# The self-similar solution generated by an H¹ stationary profile

The continuous real representative of the Sobolev graph has its weak derivative
almost everywhere. The same holds for a continuous velocity with the prescribed
weak derivative. These facts supply the almost-everywhere derivative hypotheses of
`expandingSelfSimilarFields_solves_ae` for a profile in H¹.

## References

* J. Chen, T. Y. Hou, and D. Huang, "On the finite time blowup of the De Gregorio model for the 3D
  Euler equations", *Comm. Pure Appl. Math.* 74 (2021), no. 6, 1282-1350; numbering of
  arXiv:1905.06387v3, Section 1.2, (1.4) and (1.5), p. 2.
  <https://doi.org/10.1002/cpa.21991>
  <https://arxiv.org/abs/1905.06387v3>
-/

@[expose] public noncomputable section

open MeasureTheory Set PDE.Analysis SobolevSpace.GraphSpace
open scoped Sobolev

namespace DeGregorio

/-- An H¹ stationary graph and its continuous weak velocity generate the a.e.
physical solution (1.5) of Chen, Hou and Huang for equal negative rates. The profile is the
continuous representative of the given graph. -/
theorem expandingSelfSimilarFields_solves_ae_of_h1
    {F : W^{1,2}(ℝ^1)} {U : ℝ → ℝ} {a c T : ℝ}
    (hc : c < 0) (hU : Continuous U)
    (hweak : Evolution.HasWeakTimeDerivativeOn univ U (deriv U))
    (hstationary : ∀ᵐ x ∂volume,
      stationaryResidual a c c (realLineRepresentative F) U x = 0)
    (hpair : IsHilbertPair (realLineRepresentative F) (deriv U))
    {t : ℝ} (ht : t < T) :
    (∀ᵐ x ∂volume,
      DifferentiableAt ℝ
        ((expandingSelfSimilarFields (realLineRepresentative F) U c T).vorticity x) t ∧
      DifferentiableAt ℝ
        (fun y ↦ (expandingSelfSimilarFields (realLineRepresentative F) U c T).vorticity y t) x ∧
      DifferentiableAt ℝ
        (fun y ↦ (expandingSelfSimilarFields (realLineRepresentative F) U c T).velocity y t) x ∧
      transportResidual a
        (expandingSelfSimilarFields (realLineRepresentative F) U c T) x t = 0) ∧
    IsHilbertPair
      (fun x ↦ (expandingSelfSimilarFields (realLineRepresentative F) U c T).vorticity x t)
      (deriv (fun x ↦
        (expandingSelfSimilarFields (realLineRepresentative F) U c T).velocity x t)) := by
  have hF := SobolevSpace.Slices.ae_hasDerivAt_lineRepresentative_of_locallyIntegrable
    (f := realLineCoordinateCLM (baseIndex 1 1) F)
    (locallyIntegrableOn_univ.mp
      (hasWeakTimeDerivativeOn_realLineCoordinates F).locallyIntegrable_g)
  exact expandingSelfSimilarFields_solves_ae hc
    (hF.mono fun _ hx ↦ hx.differentiableAt)
    ((hweak.ae_hasDerivAt_of_continuous hU).mono fun _ hx ↦ hx.differentiableAt)
    hstationary hpair ht

end DeGregorio
