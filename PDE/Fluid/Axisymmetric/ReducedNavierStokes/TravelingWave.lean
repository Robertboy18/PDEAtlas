module

public import PDE.Fluid.Axisymmetric.ReducedNavierStokes.RescaledSystem
public import PDE.Representations.Similarity.Pointwise
import PDE.Representations.Similarity.Calculus
import CAS.ExactTactic

/-!
# Fixed-power traveling profiles for the reduced axisymmetric system

We define the backward fixed-power ansatz for the reduced axisymmetric Euler and
Navier–Stokes equations. If `T` is the candidate
singular time, `λ` is the spatial exponent, and `z_c(t)` is an axial center,
the similarity coordinates are

```text
R = r / (T - t)^λ,
Z = (z - z_c(t)) / (T - t)^λ.
```

For a reduced profile `(U, Ω, Ψ)`, the physical reduced fields are

```text
u₁(r,z,t) = (T - t)⁻¹       U(R,Z),
ω₁(r,z,t) = (T - t)⁻¹⁻λ    Ω(R,Z),
ψ₁(r,z,t) = (T - t)⁻¹⁺λ    Ψ(R,Z).
```

The profile rates are therefore `cᵤ = -1` and `cω = -(1 + λ)`.  A nonzero constant
viscosity produces an autonomous profile equation only at the parabolic
exponent `λ = 1/2`; arbitrary `λ` remains available for Euler.

The definitions reuse `ReducedProfile`, `ReducedFields`, and the generic
similarity calculus.

## Main results

* `reducedTravelingCoordinates`, `reducedTravelingWaveAnsatz`: the similarity coordinates and
  the physical reduced fields generated by a fixed profile, with pointwise formulas
  `reducedTravelingWaveAnsatz_swirl`, `_vorticity`, `_streamFunction`.
* `SatisfiesReducedTravelingCenterODEAt`, `powerLawReducedTravelingCenter_satisfies_centerODEAt`:
  the center law `z_c'(t) = -C (T - t)^(λ - 1)` and its explicit power-law solution.
* `reducedTravelingEnergyExponent`, `reducedTravelingEnergyScale` and the limits
  `tendsto_reducedTravelingEnergyScale_atTop`, `tendsto_reducedTravelingEnergyScale_zero`: the
  scalar factor `(T - t)^(5λ - 2)` by which the weighted energy `∫ (|u₁|² + |∇ψ₁|²) r³ dr dz`
  of an exact traveling core would scale, and its behaviour as `t → T` on either side of
  `λ = 2/5`. The integral itself does not appear; only its scaling factor is computed.
* `reducedSwirlProfileResidual_travelingRate`, `reducedVorticityProfileResidual_travelingRate`:
  the rescaled profile residuals of `RescaledSystem` expanded at the traveling rates
  `cᵤ = -1`, `cω = -(1 + λ)`.

## References

* V. Duruisseaux, A. Ganeshram, R. J. George and A. Anandkumar, "Stability Framework for the
  Singularity of the Euler Equations on ℝ³", arXiv:2609.10860v1, Section 2.2, pp. 7-8, for the Euler
  ansatz: (13)-(16) give the fields and coordinates, (18) gives the center law and (20) fixes the
  exponents.
  <https://arxiv.org/abs/2609.10860v1>
-/

@[expose] public section

namespace AxisymmetricFlow

open EuclideanSpace
open Filter Topology
open PDE.Representations.Similarity

set_option linter.missingDocs true

noncomputable section

/-- Similarity coordinates centered at the moving axial point
`z_c(t)e_z`. -/
def reducedTravelingCoordinates
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ)
    (x : ℝ^2) (t : ℝ) : ℝ^2 :=
  centeredDilation
    (backwardPowerScale spatialExponent singularTime t)
    (axialCenter t • axialUnit) x

/-- The radial traveling coordinate is
`(T-t)⁻λ r`. -/
@[simp]
theorem reducedTravelingCoordinates_radial
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ)
    (x : ℝ^2) (t : ℝ) :
    reducedTravelingCoordinates spatialExponent singularTime axialCenter x t
        (0 : Fin 2) =
      backwardPowerScale spatialExponent singularTime t *
        x (0 : Fin 2) := by
  simp [reducedTravelingCoordinates, centeredDilation, smul_eq_mul]

/-- The axial traveling coordinate is
`(T-t)⁻λ (z-z_c(t))`. -/
@[simp]
theorem reducedTravelingCoordinates_axial
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ)
    (x : ℝ^2) (t : ℝ) :
    reducedTravelingCoordinates spatialExponent singularTime axialCenter x t
        (1 : Fin 2) =
      backwardPowerScale spatialExponent singularTime t *
        (x (1 : Fin 2) - axialCenter t) := by
  simp [reducedTravelingCoordinates, centeredDilation, smul_eq_mul]

/-- The center law from §2.2, equation (18), of the cited Euler paper:
`z_c'(t) = -C (T-t)^(λ-1)` at one physical time. -/
def SatisfiesReducedTravelingCenterODEAt
    (axialCenter : ℝ → ℝ)
    (spatialExponent axialDrift singularTime t : ℝ) : Prop :=
  HasDerivAt axialCenter
    (-axialDrift *
      backwardPowerScale (1 - spatialExponent) singularTime t) t

/-- Explicit power-law center. It approaches `limitingCenter` as `t → T⁻`
when `λ > 0`; for `λ < 0` and nonzero drift the correction diverges. -/
def powerLawReducedTravelingCenter
    (spatialExponent axialDrift singularTime limitingCenter : ℝ)
    (t : ℝ) : ℝ :=
  limitingCenter +
    (axialDrift / spatialExponent) *
      backwardPowerScale (-spatialExponent) singularTime t

/-- The explicit power-law center satisfies this center ODE before
the singular time whenever `λ ≠ 0`. -/
theorem powerLawReducedTravelingCenter_satisfies_centerODEAt
    {spatialExponent axialDrift singularTime limitingCenter t : ℝ}
    (hexponent : spatialExponent ≠ 0) (ht : t < singularTime) :
    SatisfiesReducedTravelingCenterODEAt
      (powerLawReducedTravelingCenter spatialExponent axialDrift
        singularTime limitingCenter)
      spatialExponent axialDrift singularTime t := by
  have hbase : 0 < singularTime - t := sub_pos.mpr ht
  unfold SatisfiesReducedTravelingCenterODEAt powerLawReducedTravelingCenter
    backwardPowerScale
  cas using hbase

/-- Convert a fixed reduced profile into physical backward traveling fields. -/
def reducedTravelingWaveAnsatz
    (profile : ReducedProfile)
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ) :
    ReducedFields where
  swirl x t :=
    backwardPowerScale 1 singularTime t *
      profile.swirl
        (reducedTravelingCoordinates spatialExponent singularTime
          axialCenter x t)
  vorticity x t :=
    backwardPowerScale (1 + spatialExponent) singularTime t *
      profile.vorticity
        (reducedTravelingCoordinates spatialExponent singularTime
          axialCenter x t)
  streamFunction x t :=
    backwardPowerScale (1 - spatialExponent) singularTime t *
      profile.streamFunction
        (reducedTravelingCoordinates spatialExponent singularTime
          axialCenter x t)

/-- Pointwise reduced-swirl formula for the traveling ansatz. -/
theorem reducedTravelingWaveAnsatz_swirl
    (profile : ReducedProfile)
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ)
    (x : ℝ^2) (t : ℝ) :
    (reducedTravelingWaveAnsatz profile spatialExponent singularTime
      axialCenter).swirl x t =
      backwardPowerScale 1 singularTime t *
        profile.swirl
          (reducedTravelingCoordinates spatialExponent singularTime
            axialCenter x t) :=
  rfl

/-- Pointwise reduced-vorticity formula for the traveling ansatz. -/
theorem reducedTravelingWaveAnsatz_vorticity
    (profile : ReducedProfile)
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ)
    (x : ℝ^2) (t : ℝ) :
    (reducedTravelingWaveAnsatz profile spatialExponent singularTime
      axialCenter).vorticity x t =
      backwardPowerScale (1 + spatialExponent) singularTime t *
        profile.vorticity
          (reducedTravelingCoordinates spatialExponent singularTime
            axialCenter x t) :=
  rfl

/-- Pointwise reduced-streamfunction formula for the traveling ansatz. -/
theorem reducedTravelingWaveAnsatz_streamFunction
    (profile : ReducedProfile)
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ)
    (x : ℝ^2) (t : ℝ) :
    (reducedTravelingWaveAnsatz profile spatialExponent singularTime
      axialCenter).streamFunction x t =
      backwardPowerScale (1 - spatialExponent) singularTime t *
        profile.streamFunction
          (reducedTravelingCoordinates spatialExponent singularTime
            axialCenter x t) :=
  rfl

/-- The zero profile generates exactly the zero reduced fields. -/
@[simp]
theorem reducedTravelingWaveAnsatz_zero
    (spatialExponent singularTime : ℝ) (axialCenter : ℝ → ℝ) :
    reducedTravelingWaveAnsatz zeroReducedProfile spatialExponent singularTime
      axialCenter =
      zeroReducedFields := by
  change ReducedFields.mk _ _ _ = ReducedFields.mk _ _ _
  rw [ReducedFields.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> funext x t <;>
    simp [zeroReducedProfile]

/-- Swirl rate in the fixed-power traveling profile equation. -/
def reducedTravelingSwirlRate : ℝ :=
  -1

/-- Vorticity rate in the fixed-power traveling profile equation. -/
def reducedTravelingVorticityRate (spatialExponent : ℝ) : ℝ :=
  -(1 + spatialExponent)

/-- At the parabolic exponent, the vorticity rate is `-3/2`. -/
@[simp]
theorem reducedTravelingVorticityRate_one_half :
    reducedTravelingVorticityRate (2⁻¹ : ℝ) = -(3 / 2 : ℝ) := by
  norm_num [reducedTravelingVorticityRate]

/-- Exponent of the physical weighted energy under the traveling ansatz.

Both `|u₁|²` and `|∇ψ₁|²` contribute `(T-t)⁻²`, while
`r³ dr dz` contributes `(T-t)^(5λ)`. -/
def reducedTravelingEnergyExponent (spatialExponent : ℝ) : ℝ :=
  2 - 5 * spatialExponent

/-- Multiplicative factor relating the physical and profile weighted
energies after the traveling change of variables. -/
def reducedTravelingEnergyScale
    (spatialExponent singularTime t : ℝ) : ℝ :=
  backwardPowerScale
    (reducedTravelingEnergyExponent spatialExponent) singularTime t

/-- The energy scale is the square of the swirl amplitude times the fifth
power of the physical length scale. -/
theorem reducedTravelingEnergyScale_eq_amplitude_sq_mul_length_pow
    (spatialExponent singularTime : ℝ) {t : ℝ} (ht : t < singularTime) :
    reducedTravelingEnergyScale spatialExponent singularTime t =
      backwardPowerScale 1 singularTime t ^ 2 *
        backwardPowerScale (-spatialExponent) singularTime t ^ 5 := by
  unfold reducedTravelingEnergyScale reducedTravelingEnergyExponent
  rw [backward_power_scale_pow 2 ht, backward_power_scale_pow 5 ht,
    backward_power_scale_mul ht]
  congr 1
  ring

/-- The energy exponent is nonpositive exactly at the bounded-energy
threshold `λ ≥ 2/5`. -/
theorem reducedTravelingEnergyExponent_nonpos_iff
    (spatialExponent : ℝ) :
    reducedTravelingEnergyExponent spatialExponent ≤ 0 ↔
      (2 / 5 : ℝ) ≤ spatialExponent := by
  change 2 - 5 * spatialExponent ≤ 0 ↔
    (2 / 5 : ℝ) ≤ spatialExponent
  constructor <;> intro h <;> linarith

/-- At the critical exponent `λ = 2/5`, the energy scale is identically
one. -/
@[simp]
theorem reducedTravelingEnergyScale_two_fifths
    (singularTime t : ℝ) :
    reducedTravelingEnergyScale (2 / 5) singularTime t = 1 := by
  norm_num [reducedTravelingEnergyScale, reducedTravelingEnergyExponent]

/-- Below `λ = 2/5`, the energy scale diverges at the candidate singular
time. -/
theorem tendsto_reducedTravelingEnergyScale_atTop
    {spatialExponent singularTime : ℝ}
    (hexponent : spatialExponent < 2 / 5) :
    Tendsto (reducedTravelingEnergyScale spatialExponent singularTime)
      (nhdsWithin singularTime (Set.Iio singularTime)) atTop := by
  apply tendsto_backward_power_scale_at_top
  change 0 < 2 - 5 * spatialExponent
  linarith

/-- Above `λ = 2/5`, the energy contribution of an exact traveling core
tends to zero. -/
theorem tendsto_reducedTravelingEnergyScale_zero
    {spatialExponent singularTime : ℝ}
    (hexponent : 2 / 5 < spatialExponent) :
    Tendsto (reducedTravelingEnergyScale spatialExponent singularTime)
      (nhdsWithin singularTime (Set.Iio singularTime)) (𝓝 0) := by
  apply tendsto_backward_power_scale_zero
  change 2 - 5 * spatialExponent < 0
  linarith

/-- Expanded swirl-profile defect with the traveling rate `cᵤ = -1`.

This theorem makes the sign convention in `rescaledReducedSwirlResidual`
explicit: vanishing says that `U + (λx + Ce_z + u)·∇U` equals the nonlinear
source plus viscosity. -/
theorem reducedSwirlProfileResidual_travelingRate
    (profile : ReducedProfile)
    (viscosity spatialExponent axialDrift : ℝ) (x : ℝ^2) :
    reducedSwirlProfileResidual profile viscosity spatialExponent axialDrift
        reducedTravelingSwirlRate x =
      profile.swirl x +
        rescaledReducedAdvection profile.stationaryFields
          (fun _ ↦ spatialExponent) (fun _ ↦ axialDrift)
          profile.swirl x 0 -
        reducedSwirlSource profile.stationaryFields x 0 -
        viscosity * radialFourAxialLaplacian profile.swirl x := by
  simp [reducedSwirlProfileResidual, reducedTravelingSwirlRate]
  ring

/-- Expanded vorticity-profile defect with traveling rate
`cω = -(1 + λ)`. -/
theorem reducedVorticityProfileResidual_travelingRate
    (profile : ReducedProfile)
    (viscosity spatialExponent axialDrift : ℝ) (x : ℝ^2) :
    reducedVorticityProfileResidual profile viscosity spatialExponent
        axialDrift (reducedTravelingVorticityRate spatialExponent) x =
      (1 + spatialExponent) * profile.vorticity x +
        rescaledReducedAdvection profile.stationaryFields
          (fun _ ↦ spatialExponent) (fun _ ↦ axialDrift)
          profile.vorticity x 0 -
        reducedVorticitySource profile.stationaryFields x 0 -
        viscosity * radialFourAxialLaplacian profile.vorticity x := by
  simp [reducedVorticityProfileResidual,
    reducedTravelingVorticityRate]
  ring

end

end AxisymmetricFlow
