/-!
# Axisymmetric streamfunctions on the meridian half-plane

An axisymmetric incompressible flow is described by a scalar streamfunction on the
meridian half-plane, and the identities below are the algebraic part of that
description. Meridian coordinates are ordered as `(r,z)`.
The formulas are stated on `ℝ^2`; every result involving division by `r`
therefore carries an explicit off-axis hypothesis.

The streamfunction convention is

```text
r u_r = -∂_z ψ,    r u_z = ∂_r ψ.
```

It makes the conservative incompressibility equation

```text
∂_r (r u_r) + ∂_z (r u_z) = 0
```

an immediate consequence of equality of mixed partial derivatives. The
associated scalar operator is

```text
Lψ = ∂_{rr}ψ - r⁻¹∂_rψ + ∂_{zz}ψ.
```

For `ψ(r,z) = r² φ(r,z)`, the identity

```text
Lψ = r² (∂_{rr}φ + 3r⁻¹∂_rφ + ∂_{zz}φ)
```

exhibits the Laplacian in four radial dimensions and one axial dimension.
These formulas are standard in the axisymmetric Euler and Navier-Stokes literature.

## References

* A. J. Majda and A. L. Bertozzi, *Vorticity and Incompressible Flow*, Cambridge Texts in Applied
  Mathematics 27, Cambridge University Press, 2001.
  <https://doi.org/10.1017/CBO9780511613203>
* M. R. Ukhovskii and V. I. Yudovich, "Axially symmetric flows of ideal and viscous fluids filling
  the whole space", J. Appl. Math. Mech. 32 (1968), no. 1, 52-62.
  <https://doi.org/10.1016/0021-8928(68)90147-0>
-/

@[expose] public section

open PDE (laplacian divergence)

namespace AxisymmetricFlow

open EuclideanSpace
open PDE.CoordinateSystems

noncomputable section

/-- Package a radial and an axial scalar flux as a vector field on meridian space. -/
def meridianFlux (qR qZ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ^2 :=
  WithLp.toLp 2 ![qR x, qZ x]

/-- Radial conservative flux `r u_r = -∂_z ψ` generated by a streamfunction. -/
def streamfunctionRadialFlux (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  -(∂[(1 : Fin 2)] ψ) x

/-- Axial conservative flux `r u_z = ∂_r ψ` generated by a streamfunction. -/
def streamfunctionAxialFlux (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  (∂[(0 : Fin 2)] ψ) x

/-- Streamfunction fluxes have zero Euclidean divergence whenever the displayed
mixed partial derivatives agree. -/
theorem divergence_streamfunctionFlux_eq_zero
    (ψ : ℝ^2 → ℝ) (x : ℝ^2)
    (hmixed :
      (∂[(0 : Fin 2)]
          (fun y ↦ (∂[(1 : Fin 2)] ψ) y)) x =
        (∂[(1 : Fin 2)]
          (fun y ↦ (∂[(0 : Fin 2)] ψ) y)) x) :
    ∇·
        (meridianFlux
          (streamfunctionRadialFlux ψ)
          (streamfunctionAxialFlux ψ)) x = 0 := by
  simp only [divergence, meridianFlux, Fin.sum_univ_two]
  change
    (∂[(0 : Fin 2)]
          (-(fun y ↦ (∂[(1 : Fin 2)] ψ) y))) x +
        (∂[(1 : Fin 2)]
          (fun y ↦ (∂[(0 : Fin 2)] ψ) y)) x = 0
  rw [PDE.partialDeriv_neg]
  rw [hmixed]
  ring

/-- A `C²` streamfunction generates conservative fluxes with zero meridian
divergence. -/
theorem divergence_streamfunctionFlux_eq_zero_of_contDiff
    (ψ : ℝ^2 → ℝ) (hψ : ContDiff ℝ 2 ψ) (x : ℝ^2) :
    ∇·
        (meridianFlux
          (streamfunctionRadialFlux ψ)
          (streamfunctionAxialFlux ψ)) x = 0 :=
  divergence_streamfunctionFlux_eq_zero ψ x
    (PDE.partialDeriv_partialDeriv_comm (0 : Fin 2) (1 : Fin 2) hψ x)

/-- Off-axis radial velocity `u_r = -r⁻¹∂_z ψ` reconstructed from a
streamfunction. The expression is totalized at `r = 0`; analytic uses should
carry an explicit nonzero-radius hypothesis. -/
def reconstructedRadialVelocity (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  -(∂[(1 : Fin 2)] ψ) x / x (0 : Fin 2)

/-- Off-axis axial velocity `u_z = r⁻¹∂_r ψ` reconstructed from a
streamfunction. The expression is totalized at `r = 0`; analytic uses should
carry an explicit nonzero-radius hypothesis. -/
def reconstructedAxialVelocity (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  (∂[(0 : Fin 2)] ψ) x / x (0 : Fin 2)

/-- Meridian velocity reconstruction `(u_r,u_z)` from a streamfunction.

This is the forward algebraic reconstruction from a given streamfunction. -/
def streamfunctionVelocityReconstruction
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ^2 :=
  meridianFlux
    (reconstructedRadialVelocity ψ)
    (reconstructedAxialVelocity ψ) x

/-- The radial component of the reconstructed meridian velocity is `u_r = -r⁻¹ ∂_z ψ`. -/
@[simp]
theorem streamfunctionVelocityReconstruction_radial
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    streamfunctionVelocityReconstruction ψ x (0 : Fin 2) =
      reconstructedRadialVelocity ψ x := by
  simp [streamfunctionVelocityReconstruction, meridianFlux]

/-- The axial component of the reconstructed meridian velocity is `u_z = r⁻¹ ∂_r ψ`. -/
@[simp]
theorem streamfunctionVelocityReconstruction_axial
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    streamfunctionVelocityReconstruction ψ x (1 : Fin 2) =
      reconstructedAxialVelocity ψ x := by
  simp [streamfunctionVelocityReconstruction, meridianFlux]

/-- Away from the axis, the reconstructed radial velocity has conservative
flux `-∂_z ψ`. -/
theorem radial_mul_reconstructedRadialVelocity
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) (hr : x (0 : Fin 2) ≠ 0) :
    x (0 : Fin 2) * reconstructedRadialVelocity ψ x =
      streamfunctionRadialFlux ψ x := by
  simp only [reconstructedRadialVelocity, streamfunctionRadialFlux]
  field_simp

/-- Away from the axis, the reconstructed axial velocity has conservative
flux `∂_r ψ`. -/
theorem radial_mul_reconstructedAxialVelocity
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) (hr : x (0 : Fin 2) ≠ 0) :
    x (0 : Fin 2) * reconstructedAxialVelocity ψ x =
      streamfunctionAxialFlux ψ x := by
  simp only [reconstructedAxialVelocity, streamfunctionAxialFlux]
  field_simp

/-- Scalar azimuthal vorticity `ω_θ = ∂_z u_r - ∂_r u_z` of a meridian
velocity pair. -/
def azimuthalVorticity
    (uR uZ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  (∂[(1 : Fin 2)] uR) x - (∂[(0 : Fin 2)] uZ) x

/-- Axisymmetric stream operator
`Lψ = ∂_{rr}ψ - r⁻¹∂_rψ + ∂_{zz}ψ`. -/
def axisymmetricStreamOperator
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  (∂[(0 : Fin 2)]
      (fun y ↦ (∂[(0 : Fin 2)] ψ) y)) x -
    (∂[(0 : Fin 2)] ψ) x / x (0 : Fin 2) +
    (∂[(1 : Fin 2)]
      (fun y ↦ (∂[(1 : Fin 2)] ψ) y)) x

/-- `ψ` satisfies the meridian streamfunction equation for azimuthal
vorticity `ω`, away from the symmetry axis. -/
def IsStreamfunctionForAzimuthalVorticity
    (ω ψ : ℝ^2 → ℝ) : Prop :=
  ∀ x, x (0 : Fin 2) ≠ 0 →
    axisymmetricStreamOperator ψ x = -x (0 : Fin 2) * ω x

/-- Vorticity reconstructed algebraically from a streamfunction away from the axis.

This is the forward expression `ω_θ = -Lψ/r`. -/
def reconstructedAzimuthalVorticity
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  -axisymmetricStreamOperator ψ x / x (0 : Fin 2)

/-- The forward reconstructed vorticity satisfies the streamfunction equation off the axis. -/
theorem isStreamfunctionForAzimuthalVorticity_reconstructed
    (ψ : ℝ^2 → ℝ) :
    IsStreamfunctionForAzimuthalVorticity
      (reconstructedAzimuthalVorticity ψ) ψ := by
  intro x hx
  simp only [reconstructedAzimuthalVorticity]
  field_simp

/-- The meridian operator corresponding to a Laplacian in four radial dimensions and one
axial dimension:
`∂_{rr}φ + 3r⁻¹∂_rφ + ∂_{zz}φ`. -/
def radialFourAxialLaplacian
    (φ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  (∂[(0 : Fin 2)]
      (fun y ↦ (∂[(0 : Fin 2)] φ) y)) x +
    3 / x (0 : Fin 2) * (∂[(0 : Fin 2)] φ) x +
    (∂[(1 : Fin 2)]
      (fun y ↦ (∂[(1 : Fin 2)] φ) y)) x

/-- The stream operator is the planar Laplacian with the radial correction `-(∂_r ψ)/r`. -/
theorem axisymmetricStreamOperator_eq_laplacian_sub
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    axisymmetricStreamOperator ψ x =
      laplacian ψ x -
        (∂[(0 : Fin 2)] ψ) x / x (0 : Fin 2) := by
  simp [axisymmetricStreamOperator, laplacian, Fin.sum_univ_two]
  ring

/-- Radial lift `ψ(r,z) = r² φ(r,z)` used to expose the radial-four-plus-axial
Laplacian structure of the stream operator. -/
def streamfunctionRadialLift
    (φ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ :=
  (x (0 : Fin 2)) ^ 2 * φ x

/-- Lifting `r²φ` to three dimensions multiplies the lifted profile by the
square of the cylindrical radius. -/
theorem meridianLift_streamfunctionRadialLift
    (φ : ℝ^2 → ℝ) (x : ℝ^3) :
    meridianLift (streamfunctionRadialLift φ) x =
      cylindricalRadiusSq x * meridianLift φ x := by
  simp only [meridianLift, streamfunctionRadialLift, meridianCoordinates_apply_zero]
  rw [show cylindricalRadius x ^ 2 = cylindricalRadiusSq x by
    simp [cylindricalRadius, Real.sq_sqrt, cylindricalRadiusSq_nonneg]]

/-- For `ψ = r²φ`, the axisymmetric stream operator is `r²` times the
radial-four-plus-axial Laplacian, away from the axis. -/
theorem axisymmetricStreamOperator_radialLift
    (φ : ℝ^2 → ℝ) (hφ : ContDiff ℝ 2 φ)
    (x : ℝ^2) (hr : x (0 : Fin 2) ≠ 0) :
    axisymmetricStreamOperator (streamfunctionRadialLift φ) x =
      (x (0 : Fin 2)) ^ 2 * radialFourAxialLaplacian φ x := by
  have hφd : Differentiable ℝ φ := hφ.differentiable (by norm_num)
  have hφ' (i : Fin 2) : Differentiable ℝ (∂[i] φ) :=
    (PDE.contDiff_partialDeriv_of_succ (m := 1) hφ).differentiable (by norm_num)
  have hlin : Differentiable ℝ (fun y : ℝ^2 ↦ 2 * y (0 : Fin 2)) := by cas
  have hsq : Differentiable ℝ (fun y : ℝ^2 ↦ (y (0 : Fin 2)) ^ 2) := by cas
  have hsq' (i : Fin 2) (y : ℝ^2) : (∂[i] (fun z : ℝ^2 ↦ (z (0 : Fin 2)) ^ 2)) y =
      2 * y (0 : Fin 2) * if i = (0 : Fin 2) then 1 else 0 := by
    fin_cases i <;> cas
  have hlin' (y : ℝ^2) : (∂[(0 : Fin 2)] (fun z : ℝ^2 ↦ 2 * z (0 : Fin 2))) y = 2 := by
    cas
  have hfirstR (y : ℝ^2) : (∂[(0 : Fin 2)] (streamfunctionRadialLift φ)) y =
      2 * y (0 : Fin 2) * φ y + (y (0 : Fin 2)) ^ 2 * (∂[(0 : Fin 2)] φ) y := by
    rw [show streamfunctionRadialLift φ = fun z ↦ (z (0 : Fin 2)) ^ 2 * φ z from rfl,
      PDE.partialDeriv_mul (hsq y) (hφd y), hsq']
    simp
  have hfirstZ (y : ℝ^2) : (∂[(1 : Fin 2)] (streamfunctionRadialLift φ)) y =
      (y (0 : Fin 2)) ^ 2 * (∂[(1 : Fin 2)] φ) y := by
    rw [show streamfunctionRadialLift φ = fun z ↦ (z (0 : Fin 2)) ^ 2 * φ z from rfl,
      PDE.partialDeriv_mul (hsq y) (hφd y), hsq']
    simp
  have hsecondR : (∂[(0 : Fin 2)] (fun y ↦ (∂[(0 : Fin 2)] (streamfunctionRadialLift φ)) y)) x =
      2 * φ x + 4 * x (0 : Fin 2) * (∂[(0 : Fin 2)] φ) x +
        (x (0 : Fin 2)) ^ 2 * (∂[(0 : Fin 2)] (fun y ↦ (∂[(0 : Fin 2)] φ) y)) x := by
    simp_rw [hfirstR]
    rw [PDE.partialDeriv_add (f := fun y ↦ 2 * y (0 : Fin 2) * φ y)
      (g := fun y ↦ (y (0 : Fin 2)) ^ 2 * (∂[(0 : Fin 2)] φ) y) ((hlin.mul hφd) x)
      ((hsq.mul (hφ' 0)) x), PDE.partialDeriv_mul (hlin x) (hφd x),
      PDE.partialDeriv_mul (hsq x) (hφ' 0 x), hlin', hsq']
    simp only [ite_eq_left]
    ring
  have hsecondZ : (∂[(1 : Fin 2)] (fun y ↦ (∂[(1 : Fin 2)] (streamfunctionRadialLift φ)) y)) x =
      (x (0 : Fin 2)) ^ 2 * (∂[(1 : Fin 2)] (fun y ↦ (∂[(1 : Fin 2)] φ) y)) x := by
    simp_rw [hfirstZ]
    rw [PDE.partialDeriv_mul (hsq x) (hφ' 1 x), hsq']
    simp
  rw [axisymmetricStreamOperator, radialFourAxialLaplacian, hsecondR, hfirstR, hsecondZ]
  field_simp
  ring

end

end AxisymmetricFlow
