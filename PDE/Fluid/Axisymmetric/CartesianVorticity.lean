module

public import PDE.Fluid.Axisymmetric.CartesianReconstruction
import CAS.ExactTactic
import PDE.Symbolic.PDEDerivatives
import Mathlib.Analysis.Calculus.ContDiff.WithLp

/-!
# Cartesian vorticity of axis-regular velocity fields

The three-dimensional curl of the Cartesian velocity fields reconstructed from
squared-radius profiles in `PDE.Fluid.Axisymmetric.CartesianReconstruction` is
again a polynomial expression in squared-radius lifts.

For `s = x₁² + x₂²`, set

```text
K(s,z) = Ψ_zz(s,z) + 8 Ψ_s(s,z) + 4 s Ψ_ss(s,z).
```

The meridional and swirl contributions to vorticity are respectively

```text
(x₂ K, -x₁ K, 0),
(-x₁ U_z, -x₂ U_z, 2 U + 2 s U_s).
```

These are Cartesian polynomial formulas with squared-radius lifts. They are
valid on all of `ℝ^3`, including the symmetry axis, and involve no division by
the cylindrical radius.

In cylindrical components the same formulas read `ω_θ = -r K(r², z)` for the meridional part and
`ω_r = -r U_z`, `ω_z = 2U + 2r² U_s` for the swirl part. Thus `-K` is the reduced azimuthal
vorticity `ω_θ / r` of Hou and Li, and `K` is, up to sign, the radial-four-plus-axial Laplacian
of `ReducedNavierStokes` applied to `Ψ` in the variable `s`: the stream equation `-L Ψ = Ω` of
the reduced system is exactly `Ω = -K`.

## Main results

* `meridionalVorticityCoefficient`: the coefficient `K = Ψ_zz + 8Ψ_s + 4sΨ_ss`.
* `spatialCurl_meridionalVelocity_apply_*`, `spatialCurl_swirlVelocity_apply_*`: the three
  Cartesian components of the curl of each reconstructed field.
* `spatialCurl_axisymmetricVelocity`: the full curl for a `C¹` swirl profile and a `C²`
  streamfunction profile, as a `cartesianVector` of squared-radius lifts.
* `spatialCurl_axisymmetricVelocity_transverse_eq_zero_of_mem_symmetryAxis`,
  `spatialCurl_axisymmetricVelocity_apply_two_of_mem_symmetryAxis`: on the axis the vorticity is
  purely axial with the regular value `2 U(0, z)`.

## References

* T. Y. Hou and C. Li, "Dynamic stability of the three-dimensional axisymmetric Navier-Stokes
  equations with swirl", Comm. Pure Appl. Math. 61 (2008), no. 5, 661-697, for the reduced azimuthal
  vorticity `ω_θ / r`.
  <https://doi.org/10.1002/cpa.20212>
-/

@[expose] public section

namespace AxisymmetricFlow

open EuclideanSpace
open IncompressibleFlow
open PDE.CoordinateSystems

noncomputable section

/-- The scalar coefficient of the azimuthal vorticity generated by a
normalized squared-radius streamfunction. -/
def meridionalVorticityCoefficient (Ψ : ℝ^2 → ℝ) (q : ℝ^2) : ℝ :=
  (∂[(1 : Fin 2)]
      (fun p ↦ (∂[(1 : Fin 2)] Ψ) p)) q +
    8 * (∂[(0 : Fin 2)] Ψ) q +
    4 * q 0 * (∂[(0 : Fin 2)]
      (fun p ↦ (∂[(0 : Fin 2)] Ψ) p)) q

private theorem partialDeriv_neg_coord (i j : Fin 3) (x : ℝ^3) :
    (∂[i] (fun y : ℝ^3 ↦ -y j)) x =
      if i = j then -1 else 0 := by
  fin_cases i <;> fin_cases j <;> cas

private theorem partialDeriv_one_meridionalVelocity_apply_two
    {Ψ : ℝ^2 → ℝ} (hΨ : ContDiff ℝ 2 Ψ) (x : ℝ^3) :
    (∂[(1 : Fin 3)] (fun y ↦ meridionalVelocity Ψ y 2)) x =
      x 1 * (8 * (∂[(0 : Fin 2)] Ψ) (squaredCylindricalMap x) +
        4 * cylindricalRadiusSq x * (∂[(0 : Fin 2)]
          (fun q ↦ (∂[(0 : Fin 2)] Ψ) q))
          (squaredCylindricalMap x)) := by
  have hΨone : ContDiff ℝ 1 Ψ := hΨ.of_le (by norm_num)
  have hΨS : ContDiff ℝ 1 (fun q ↦ (∂[(0 : Fin 2)] Ψ) q) :=
    PDE.contDiff_partialDeriv_of_succ hΨ
  have hψDiff : DifferentiableAt ℝ (squaredCylindricalLift Ψ) x :=
    (contDiff_squaredCylindricalLift hΨone).contDiffAt.differentiableAt_one
  have hψSDiff : DifferentiableAt ℝ
      (squaredCylindricalLift
        (fun q ↦ (∂[(0 : Fin 2)] Ψ) q)) x :=
    (contDiff_squaredCylindricalLift hΨS).contDiffAt.differentiableAt_one
  have hsDiff : DifferentiableAt ℝ cylindricalRadiusSq x := by
    change DifferentiableAt ℝ (fun y : ℝ^3 ↦ y 0 ^ 2 + y 1 ^ 2) x
    fun_prop
  have hfirst : DifferentiableAt ℝ
      (fun y ↦ 2 * squaredCylindricalLift Ψ y) x :=
    (differentiableAt_const (c := (2 : ℝ))).mul hψDiff
  have hsecond : DifferentiableAt ℝ
      (fun y ↦ 2 * cylindricalRadiusSq y *
        squaredCylindricalLift
          (fun q ↦ (∂[(0 : Fin 2)] Ψ) q) y) x :=
    ((differentiableAt_const (c := (2 : ℝ))).mul hsDiff).mul hψSDiff
  have htwoRadius : DifferentiableAt ℝ
      (fun y ↦ 2 * cylindricalRadiusSq y) x :=
    (differentiableAt_const (c := (2 : ℝ))).mul hsDiff
  simp only [meridionalVelocity_apply_two]
  rw [PDE.partialDeriv_add hfirst hsecond]
  rw [PDE.partialDeriv_mul (differentiableAt_const (c := (2 : ℝ))) hψDiff]
  rw [PDE.partialDeriv_mul htwoRadius hψSDiff]
  rw [PDE.partialDeriv_mul (differentiableAt_const (c := (2 : ℝ))) hsDiff]
  rw [partialDeriv_one_cylindricalRadiusSq]
  rw [partialDeriv_one_squaredCylindricalLift hΨone]
  rw [partialDeriv_one_squaredCylindricalLift hΨS]
  simp [cylindricalRadiusSq, squaredCylindricalLift]
  ring

private theorem partialDeriv_zero_meridionalVelocity_apply_two
    {Ψ : ℝ^2 → ℝ} (hΨ : ContDiff ℝ 2 Ψ) (x : ℝ^3) :
    (∂[(0 : Fin 3)] (fun y ↦ meridionalVelocity Ψ y 2)) x =
      x 0 * (8 * (∂[(0 : Fin 2)] Ψ) (squaredCylindricalMap x) +
        4 * cylindricalRadiusSq x * (∂[(0 : Fin 2)]
          (fun q ↦ (∂[(0 : Fin 2)] Ψ) q))
          (squaredCylindricalMap x)) := by
  have hΨone : ContDiff ℝ 1 Ψ := hΨ.of_le (by norm_num)
  have hΨS : ContDiff ℝ 1 (fun q ↦ (∂[(0 : Fin 2)] Ψ) q) :=
    PDE.contDiff_partialDeriv_of_succ hΨ
  have hψDiff : DifferentiableAt ℝ (squaredCylindricalLift Ψ) x :=
    (contDiff_squaredCylindricalLift hΨone).contDiffAt.differentiableAt_one
  have hψSDiff : DifferentiableAt ℝ
      (squaredCylindricalLift
        (fun q ↦ (∂[(0 : Fin 2)] Ψ) q)) x :=
    (contDiff_squaredCylindricalLift hΨS).contDiffAt.differentiableAt_one
  have hsDiff : DifferentiableAt ℝ cylindricalRadiusSq x := by
    change DifferentiableAt ℝ (fun y : ℝ^3 ↦ y 0 ^ 2 + y 1 ^ 2) x
    fun_prop
  have hfirst : DifferentiableAt ℝ
      (fun y ↦ 2 * squaredCylindricalLift Ψ y) x :=
    (differentiableAt_const (c := (2 : ℝ))).mul hψDiff
  have hsecond : DifferentiableAt ℝ
      (fun y ↦ 2 * cylindricalRadiusSq y *
        squaredCylindricalLift
          (fun q ↦ (∂[(0 : Fin 2)] Ψ) q) y) x :=
    ((differentiableAt_const (c := (2 : ℝ))).mul hsDiff).mul hψSDiff
  have htwoRadius : DifferentiableAt ℝ
      (fun y ↦ 2 * cylindricalRadiusSq y) x :=
    (differentiableAt_const (c := (2 : ℝ))).mul hsDiff
  simp only [meridionalVelocity_apply_two]
  rw [PDE.partialDeriv_add hfirst hsecond]
  rw [PDE.partialDeriv_mul (differentiableAt_const (c := (2 : ℝ))) hψDiff]
  rw [PDE.partialDeriv_mul htwoRadius hψSDiff]
  rw [PDE.partialDeriv_mul (differentiableAt_const (c := (2 : ℝ))) hsDiff]
  rw [partialDeriv_zero_cylindricalRadiusSq]
  rw [partialDeriv_zero_squaredCylindricalLift hΨone]
  rw [partialDeriv_zero_squaredCylindricalLift hΨS]
  simp [cylindricalRadiusSq, squaredCylindricalLift]
  ring

/-- First Cartesian component of the vorticity generated by the meridional
velocity. -/
theorem spatialCurl_meridionalVelocity_apply_zero
    {Ψ : ℝ^2 → ℝ} (hΨ : ContDiff ℝ 2 Ψ) (x : ℝ^3) :
    spatialCurl (meridionalVelocity Ψ) x 0 =
      x 1 * squaredCylindricalLift
        (meridionalVorticityCoefficient Ψ) x := by
  have hΨZ : ContDiff ℝ 1 (fun q ↦ (∂[(1 : Fin 2)] Ψ) q) :=
    PDE.contDiff_partialDeriv_of_succ hΨ
  have hψZDiff : DifferentiableAt ℝ
      (squaredCylindricalLift
        (fun q ↦ (∂[(1 : Fin 2)] Ψ) q)) x :=
    (contDiff_squaredCylindricalLift hΨZ).contDiffAt.differentiableAt_one
  simp only [spatialCurl_apply_zero, meridionalVelocity_apply_one]
  rw [partialDeriv_one_meridionalVelocity_apply_two hΨ]
  rw [PDE.partialDeriv_mul (by fun_prop) hψZDiff]
  rw [partialDeriv_two_squaredCylindricalLift hΨZ]
  rw [partialDeriv_neg_coord]
  simp [meridionalVorticityCoefficient, squaredCylindricalLift]
  ring

/-- Second Cartesian component of the vorticity generated by the meridional
velocity. -/
theorem spatialCurl_meridionalVelocity_apply_one
    {Ψ : ℝ^2 → ℝ} (hΨ : ContDiff ℝ 2 Ψ) (x : ℝ^3) :
    spatialCurl (meridionalVelocity Ψ) x 1 =
      -x 0 * squaredCylindricalLift
        (meridionalVorticityCoefficient Ψ) x := by
  have hΨZ : ContDiff ℝ 1 (fun q ↦ (∂[(1 : Fin 2)] Ψ) q) :=
    PDE.contDiff_partialDeriv_of_succ hΨ
  have hψZDiff : DifferentiableAt ℝ
      (squaredCylindricalLift
        (fun q ↦ (∂[(1 : Fin 2)] Ψ) q)) x :=
    (contDiff_squaredCylindricalLift hΨZ).contDiffAt.differentiableAt_one
  simp only [spatialCurl_apply_one, meridionalVelocity_apply_zero]
  rw [PDE.partialDeriv_mul (by fun_prop) hψZDiff]
  rw [partialDeriv_two_squaredCylindricalLift hΨZ]
  rw [partialDeriv_zero_meridionalVelocity_apply_two hΨ]
  rw [partialDeriv_neg_coord]
  simp [meridionalVorticityCoefficient, squaredCylindricalLift]
  ring

/-- The meridional reconstruction has no axial vorticity component. -/
theorem spatialCurl_meridionalVelocity_apply_two
    {Ψ : ℝ^2 → ℝ} (hΨ : ContDiff ℝ 2 Ψ) (x : ℝ^3) :
    spatialCurl (meridionalVelocity Ψ) x 2 = 0 := by
  have hΨZ : ContDiff ℝ 1 (fun q ↦ (∂[(1 : Fin 2)] Ψ) q) :=
    PDE.contDiff_partialDeriv_of_succ hΨ
  have hψZDiff : DifferentiableAt ℝ
      (squaredCylindricalLift
        (fun q ↦ (∂[(1 : Fin 2)] Ψ) q)) x :=
    (contDiff_squaredCylindricalLift hΨZ).contDiffAt.differentiableAt_one
  simp only [spatialCurl_apply_two, meridionalVelocity_apply_zero,
    meridionalVelocity_apply_one]
  rw [PDE.partialDeriv_mul (by fun_prop) hψZDiff]
  rw [PDE.partialDeriv_mul (by fun_prop) hψZDiff]
  rw [partialDeriv_zero_squaredCylindricalLift hΨZ]
  rw [partialDeriv_one_squaredCylindricalLift hΨZ]
  rw [partialDeriv_neg_coord, partialDeriv_neg_coord]
  simp
  ring

/-- First Cartesian component of the vorticity generated by swirl. -/
theorem spatialCurl_swirlVelocity_apply_zero
    {U : ℝ^2 → ℝ} (hU : ContDiff ℝ 1 U) (x : ℝ^3) :
    spatialCurl (swirlVelocity U) x 0 =
      -x 0 * squaredCylindricalLift
        (fun q ↦ (∂[(1 : Fin 2)] U) q) x := by
  have huDiff : DifferentiableAt ℝ (squaredCylindricalLift U) x :=
    (contDiff_squaredCylindricalLift hU).contDiffAt.differentiableAt_one
  simp only [spatialCurl_apply_zero, swirlVelocity_apply_one,
    swirlVelocity_apply_two]
  rw [PDE.partialDeriv_const]
  rw [PDE.partialDeriv_mul (by fun_prop) huDiff]
  rw [partialDeriv_two_squaredCylindricalLift hU]
  rw [PDE.partialDeriv_coord]
  simp [squaredCylindricalLift]

/-- Second Cartesian component of the vorticity generated by swirl. -/
theorem spatialCurl_swirlVelocity_apply_one
    {U : ℝ^2 → ℝ} (hU : ContDiff ℝ 1 U) (x : ℝ^3) :
    spatialCurl (swirlVelocity U) x 1 =
      -x 1 * squaredCylindricalLift
        (fun q ↦ (∂[(1 : Fin 2)] U) q) x := by
  have huDiff : DifferentiableAt ℝ (squaredCylindricalLift U) x :=
    (contDiff_squaredCylindricalLift hU).contDiffAt.differentiableAt_one
  simp only [spatialCurl_apply_one, swirlVelocity_apply_zero,
    swirlVelocity_apply_two]
  rw [PDE.partialDeriv_const]
  rw [PDE.partialDeriv_mul (by fun_prop) huDiff]
  rw [partialDeriv_two_squaredCylindricalLift hU]
  rw [partialDeriv_neg_coord]
  simp [squaredCylindricalLift]

/-- Axial vorticity generated by swirl. The formula is regular at the
symmetry axis. -/
theorem spatialCurl_swirlVelocity_apply_two
    {U : ℝ^2 → ℝ} (hU : ContDiff ℝ 1 U) (x : ℝ^3) :
    spatialCurl (swirlVelocity U) x 2 =
      2 * squaredCylindricalLift U x +
        2 * cylindricalRadiusSq x * squaredCylindricalLift
          (fun q ↦ (∂[(0 : Fin 2)] U) q) x := by
  have huDiff : DifferentiableAt ℝ (squaredCylindricalLift U) x :=
    (contDiff_squaredCylindricalLift hU).contDiffAt.differentiableAt_one
  simp only [spatialCurl_apply_two, swirlVelocity_apply_zero,
    swirlVelocity_apply_one]
  rw [PDE.partialDeriv_mul (by fun_prop) huDiff]
  rw [PDE.partialDeriv_mul (by fun_prop) huDiff]
  rw [partialDeriv_zero_squaredCylindricalLift hU]
  rw [partialDeriv_one_squaredCylindricalLift hU]
  rw [partialDeriv_neg_coord]
  simp [cylindricalRadiusSq, squaredCylindricalLift, PDE.partialDeriv_coord]
  ring

/-- The Cartesian vorticity of the velocity reconstructed from a `C¹` swirl profile and a `C²`
streamfunction profile. -/
theorem spatialCurl_axisymmetricVelocity
    {U Ψ : ℝ^2 → ℝ} (hU : ContDiff ℝ 1 U)
    (hΨ : ContDiff ℝ 2 Ψ) (x : ℝ^3) :
    spatialCurl (axisymmetricVelocity U Ψ) x =
      cartesianVector
        (x 1 * squaredCylindricalLift
            (meridionalVorticityCoefficient Ψ) x -
          x 0 * squaredCylindricalLift
            (fun q ↦ (∂[(1 : Fin 2)] U) q) x)
        (-x 0 * squaredCylindricalLift
            (meridionalVorticityCoefficient Ψ) x -
          x 1 * squaredCylindricalLift
            (fun q ↦ (∂[(1 : Fin 2)] U) q) x)
        (2 * squaredCylindricalLift U x +
          2 * cylindricalRadiusSq x * squaredCylindricalLift
            (fun q ↦ (∂[(0 : Fin 2)] U) q) x) := by
  have hmeridional : DifferentiableAt ℝ (meridionalVelocity Ψ) x :=
    (contDiff_one_meridionalVelocity hΨ).contDiffAt.differentiableAt_one
  have hswirl : DifferentiableAt ℝ (swirlVelocity U) x :=
    (contDiff_one_swirlVelocity hU).contDiffAt.differentiableAt_one
  rw [show axisymmetricVelocity U Ψ =
    fun y ↦ meridionalVelocity Ψ y + swirlVelocity U y by rfl]
  rw [spatialCurl_add hmeridional hswirl]
  ext i
  fin_cases i
  · simp [spatialCurl_meridionalVelocity_apply_zero hΨ,
      spatialCurl_swirlVelocity_apply_zero hU]
    ring
  · simp [spatialCurl_meridionalVelocity_apply_one hΨ,
      spatialCurl_swirlVelocity_apply_one hU]
    ring
  · simp [spatialCurl_meridionalVelocity_apply_two hΨ,
      spatialCurl_swirlVelocity_apply_two hU]

/-- On the symmetry axis, the reconstructed vorticity has no transverse
components. -/
theorem spatialCurl_axisymmetricVelocity_transverse_eq_zero_of_mem_symmetryAxis
    {U Ψ : ℝ^2 → ℝ} (hU : ContDiff ℝ 1 U)
    (hΨ : ContDiff ℝ 2 Ψ) {x : ℝ^3} (hx : x ∈ symmetryAxis) :
    spatialCurl (axisymmetricVelocity U Ψ) x 0 = 0 ∧
      spatialCurl (axisymmetricVelocity U Ψ) x 1 = 0 := by
  rw [mem_symmetryAxis_iff] at hx
  rcases hx with ⟨hx0, hx1⟩
  rw [spatialCurl_axisymmetricVelocity hU hΨ]
  simp [hx0, hx1]

/-- The axial vorticity on the symmetry axis is the regular value
`2 U(0,z)`. -/
theorem spatialCurl_axisymmetricVelocity_apply_two_of_mem_symmetryAxis
    {U Ψ : ℝ^2 → ℝ} (hU : ContDiff ℝ 1 U)
    (hΨ : ContDiff ℝ 2 Ψ) {x : ℝ^3} (hx : x ∈ symmetryAxis) :
    spatialCurl (axisymmetricVelocity U Ψ) x 2 =
      2 * squaredCylindricalLift U x := by
  rw [mem_symmetryAxis_iff] at hx
  rcases hx with ⟨hx0, hx1⟩
  rw [spatialCurl_axisymmetricVelocity hU hΨ]
  simp [cylindricalRadiusSq, hx0, hx1]

end

end AxisymmetricFlow
