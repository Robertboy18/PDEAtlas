module

public import PDE.Fluid.NavierStokes.Nonuniqueness.Symmetry
public import PDE.Fluid.NavierStokes.Nonuniqueness.WeakEquations
public import PDE.Analysis.Calculus.DivergenceTrace
public import PDE.Analysis.Calculus.Laplacian.Composition

/-!
# The axisymmetry group acting on vector fields

The group generated by the rotations `R_θ` about the third coordinate axis and the equatorial
reflection `σ = diag(1, 1, -1)` consists of the maps `R_θ` and `σ R_θ`, since `σ` commutes with
every rotation. `groupElement θ false = R_θ` and `groupElement θ true = σ R_θ`. The group acts on
vector fields on `ℝ^3` by `act θ s u x = g u(g⁻¹ x)` with `g = groupElement θ s`, and `parity s`
is the character that is `-1` on the reflected elements.

A field is even axisymmetric exactly when every `act θ s` fixes it almost everywhere, and odd
axisymmetric exactly when `act θ s u = parity s • u` almost everywhere
(`isEvenAxisymmetric_iff_act`, `isOddAxisymmetric_iff_act`).

The action preserves smoothness, compact support and vanishing divergence, so it maps smooth
compactly supported solenoidal test fields to test fields (`IsSolenoidalTestField.act`). Its
derivative is the conjugate `g ∘ Dφ(g⁻¹ x) ∘ g⁻¹`, the divergence is transported
(`divergence_act`), and the Laplacian commutes with the action (`laplacian_act`).
-/

@[expose] public noncomputable section

open MeasureTheory
open PDE.CoordinateSystems (axialRotation equatorialReflection
  measurePreserving_equatorialReflection)
open NavierStokes.Nonuniqueness

namespace NavierStokes.Symmetry

set_option linter.missingDocs true

/-- The element `R_θ` of the axisymmetry group for `s = false` and `σ R_θ` for `s = true`, where
`R_θ` is the rotation about the third coordinate axis and `σ` the equatorial reflection. -/
def groupElement (θ : ℝ) : Bool → ℝ^3 ≃ₗᵢ[ℝ] ℝ^3
  | false => axialRotation θ
  | true => (axialRotation θ).trans equatorialReflection

/-- The action of the group element `g = groupElement θ s` on vector fields:
`act θ s u x = g u(g⁻¹ x)`. For `s = false` this is `R_θ u(R_θ⁻¹ x)`, for `s = true` it is
`σ R_θ u(R_θ⁻¹ σ x)`. -/
def act (θ : ℝ) (s : Bool) (u : ℝ^3 → ℝ^3) : ℝ^3 → ℝ^3 :=
  fun x ↦ groupElement θ s (u ((groupElement θ s).symm x))

/-- The character of the group that is `1` on rotations and `-1` on reflected elements. -/
def parity : Bool → ℝ
  | false => 1
  | true => -1

/-- The group element as a continuous linear map. -/
def groupCLM (θ : ℝ) (s : Bool) : ℝ^3 →L[ℝ] ℝ^3 :=
  (groupElement θ s).toContinuousLinearEquiv.toContinuousLinearMap

/-- The inverse group element as a continuous linear map. -/
def groupInvCLM (θ : ℝ) (s : Bool) : ℝ^3 →L[ℝ] ℝ^3 :=
  (groupElement θ s).symm.toContinuousLinearEquiv.toContinuousLinearMap

variable {θ : ℝ} {s : Bool} {u v φ : ℝ^3 → ℝ^3}

/-- The unreflected group elements are the rotations. -/
@[simp]
theorem groupElement_false (θ : ℝ) : groupElement θ false = axialRotation θ :=
  rfl

/-- The reflected group elements are `σ R_θ`. -/
@[simp]
theorem groupElement_true (θ : ℝ) :
    groupElement θ true = (axialRotation θ).trans equatorialReflection :=
  rfl

/-- Evaluation of the group element as a continuous linear map. -/
@[simp]
theorem groupCLM_apply (θ : ℝ) (s : Bool) (x : ℝ^3) : groupCLM θ s x = groupElement θ s x :=
  rfl

/-- Evaluation of the inverse group element as a continuous linear map. -/
@[simp]
theorem groupInvCLM_apply (θ : ℝ) (s : Bool) (x : ℝ^3) :
    groupInvCLM θ s x = (groupElement θ s).symm x :=
  rfl

/-- The character is `1` on rotations. -/
@[simp]
theorem parity_false : parity false = 1 :=
  rfl

/-- The character is `-1` on reflected elements. -/
@[simp]
theorem parity_true : parity true = -1 :=
  rfl

/-- The character squares to one. -/
theorem parity_mul_self (s : Bool) : parity s * parity s = 1 := by
  cases s <;> norm_num [parity]

/-- Evaluation of the action. -/
theorem act_apply (θ : ℝ) (s : Bool) (u : ℝ^3 → ℝ^3) (x : ℝ^3) :
    act θ s u x = groupElement θ s (u ((groupElement θ s).symm x)) :=
  rfl

/-- The rotation part of the action is `R_θ u(R_θ⁻¹ x)`. -/
theorem act_false (θ : ℝ) (u : ℝ^3 → ℝ^3) :
    act θ false u = fun x ↦ axialRotation θ (u ((axialRotation θ).symm x)) :=
  rfl

/-- The reflected part of the action conjugates the rotation part by `σ`. -/
theorem act_true_apply (θ : ℝ) (u : ℝ^3 → ℝ^3) (x : ℝ^3) :
    act θ true u x = equatorialReflection (act θ false u (equatorialReflection x)) :=
  rfl

/-- The rotation through angle zero acts trivially. -/
@[simp]
theorem act_zero_false (u : ℝ^3 → ℝ^3) : act 0 false u = u := by
  funext x
  rw [act_apply, groupElement_false, PDE.CoordinateSystems.axialRotation_zero]
  rfl

/-- The action is additive in the field. -/
theorem act_add (θ : ℝ) (s : Bool) (u v : ℝ^3 → ℝ^3) :
    act θ s (u + v) = act θ s u + act θ s v := by
  funext x
  simp only [act, Pi.add_apply, map_add]

/-- The action is homogeneous in the field. -/
theorem act_smul (θ : ℝ) (s : Bool) (c : ℝ) (u : ℝ^3 → ℝ^3) :
    act θ s (c • u) = c • act θ s u := by
  funext x
  simp only [act, Pi.smul_apply, map_smul]

/-- The action fixes the zero field. -/
@[simp]
theorem act_zero (θ : ℝ) (s : Bool) : act θ s 0 = 0 := by
  funext x
  simp only [act, Pi.zero_apply, map_zero]

/-! ### Sectors as fixed fields -/

/-- A field is even axisymmetric exactly when every element of the group fixes it almost
everywhere. -/
theorem isEvenAxisymmetric_iff_act :
    IsEvenAxisymmetric u ↔ ∀ θ s, act θ s u =ᵐ[volume] u := by
  constructor
  · intro hu θ s
    cases s
    · exact hu.1 θ
    · have h1 : (fun x ↦ act θ false u (equatorialReflection x)) =ᵐ[volume]
          fun x ↦ u (equatorialReflection x) :=
        measurePreserving_equatorialReflection.quasiMeasurePreserving.ae_eq_comp (hu.1 θ)
      filter_upwards [h1, hu.2] with x h1x h2x
      rw [act_true_apply, h1x]
      exact h2x
  · intro h
    refine ⟨fun θ ↦ h θ false, ?_⟩
    filter_upwards [h 0 true] with x hx
    rwa [act_true_apply, act_zero_false] at hx

/-- A field is odd axisymmetric exactly when every group element acts on it almost everywhere
by the character `parity`. -/
theorem isOddAxisymmetric_iff_act :
    IsOddAxisymmetric u ↔ ∀ θ s, act θ s u =ᵐ[volume] parity s • u := by
  constructor
  · intro hu θ s
    cases s
    · rw [parity_false, one_smul]
      exact hu.1 θ
    · have h1 : (fun x ↦ act θ false u (equatorialReflection x)) =ᵐ[volume]
          fun x ↦ u (equatorialReflection x) :=
        measurePreserving_equatorialReflection.quasiMeasurePreserving.ae_eq_comp (hu.1 θ)
      filter_upwards [h1, hu.2] with x h1x h2x
      rw [act_true_apply, h1x]
      simpa only [parity_true, Pi.smul_apply, neg_smul, one_smul, Pi.neg_apply] using h2x
  · intro h
    refine ⟨fun θ ↦ ?_, ?_⟩
    · have hθ := h θ false
      rw [parity_false, one_smul] at hθ
      exact hθ
    filter_upwards [h 0 true] with x hx
    rw [act_true_apply, act_zero_false] at hx
    simpa only [parity_true, Pi.smul_apply, neg_smul, one_smul, Pi.neg_apply] using hx

/-- The sector of the character `s ↦ parity (odd && s)`: the even axisymmetric fields for
`odd = false` and the odd axisymmetric fields for `odd = true`, as almost-everywhere identities
`act θ s u = parity (odd && s) • u`. -/
def IsInSector (odd : Bool) (u : ℝ^3 → ℝ^3) : Prop :=
  ∀ θ s, act θ s u =ᵐ[volume] parity (odd && s) • u

/-- The sector with `odd = false` consists of the even axisymmetric fields. -/
theorem isInSector_false_iff : IsInSector false u ↔ IsEvenAxisymmetric u := by
  simp only [IsInSector, Bool.false_and, parity_false, one_smul, isEvenAxisymmetric_iff_act]

/-- The sector with `odd = true` consists of the odd axisymmetric fields. -/
theorem isInSector_true_iff : IsInSector true u ↔ IsOddAxisymmetric u := by
  simp only [IsInSector, Bool.true_and, isOddAxisymmetric_iff_act]

/-- A sector field is equivariant almost everywhere up to the character:
`u(g x) = parity (odd && s) • g u(x)`. -/
theorem IsInSector.ae_comp_groupElement {odd : Bool} (hu : IsInSector odd u) (θ : ℝ)
    (s : Bool) :
    ∀ᵐ x ∂volume, u (groupElement θ s x) = parity (odd && s) • groupElement θ s (u x) := by
  have hsq : parity (odd && s) * parity (odd && s) = 1 := parity_mul_self _
  filter_upwards [(groupElement θ s).measurePreserving.quasiMeasurePreserving.ae (hu θ s)]
    with x hx
  rw [act_apply, LinearIsometryEquiv.symm_apply_apply, Pi.smul_apply] at hx
  rw [hx, smul_smul, hsq, one_smul]

/-! ### Change of variables -/

/-- Lebesgue integrals are invariant under every group element. -/
theorem integral_comp_groupElement {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (θ : ℝ) (s : Bool) (f : ℝ^3 → E) :
    ∫ x, f (groupElement θ s x) = ∫ x, f x :=
  (groupElement θ s).measurePreserving.integral_comp
    (groupElement θ s).toHomeomorph.measurableEmbedding f

/-- An almost everywhere identity can be evaluated at the image of a group element. -/
theorem ae_comp_groupElement {p : ℝ^3 → Prop} (θ : ℝ) (s : Bool) (h : ∀ᵐ x ∂volume, p x) :
    ∀ᵐ x ∂volume, p (groupElement θ s x) :=
  (groupElement θ s).measurePreserving.quasiMeasurePreserving.ae h

/-- An even axisymmetric field is equivariant almost everywhere: `u(g x) = g u(x)`. -/
theorem _root_.NavierStokes.Nonuniqueness.IsEvenAxisymmetric.ae_comp_groupElement
    (hu : IsEvenAxisymmetric u) (θ : ℝ)
    (s : Bool) : ∀ᵐ x ∂volume, u (groupElement θ s x) = groupElement θ s (u x) := by
  filter_upwards [Symmetry.ae_comp_groupElement θ s (isEvenAxisymmetric_iff_act.mp hu θ s)]
    with x hx
  rw [act_apply, LinearIsometryEquiv.symm_apply_apply] at hx
  exact hx.symm

/-- An odd axisymmetric field is equivariant almost everywhere up to the character:
`u(g x) = parity s • g u(x)`. -/
theorem _root_.NavierStokes.Nonuniqueness.IsOddAxisymmetric.ae_comp_groupElement
    (hu : IsOddAxisymmetric u) (θ : ℝ)
    (s : Bool) :
    ∀ᵐ x ∂volume, u (groupElement θ s x) = parity s • groupElement θ s (u x) := by
  filter_upwards [Symmetry.ae_comp_groupElement θ s (isOddAxisymmetric_iff_act.mp hu θ s)]
    with x hx
  rw [act_apply, LinearIsometryEquiv.symm_apply_apply, Pi.smul_apply] at hx
  rw [hx, smul_smul, parity_mul_self, one_smul]

/-! ### Test fields -/

/-- The action preserves smoothness. -/
theorem contDiff_act {n : WithTop ℕ∞} (hφ : ContDiff ℝ n φ) : ContDiff ℝ n (act θ s φ) :=
  (groupElement θ s).contDiff.comp (hφ.comp (groupElement θ s).symm.contDiff)

/-- The action preserves compact support. -/
theorem hasCompactSupport_act (hφ : HasCompactSupport φ) : HasCompactSupport (act θ s φ) :=
  (hφ.comp_homeomorph (groupElement θ s).symm.toHomeomorph).comp_left (map_zero _)

/-- The derivative of a transformed field is the conjugate `g ∘ Dφ(g⁻¹ x) ∘ g⁻¹`. -/
theorem hasFDerivAt_act {x : ℝ^3} (hφ : DifferentiableAt ℝ φ ((groupElement θ s).symm x)) :
    HasFDerivAt (act θ s φ)
      ((groupCLM θ s).comp ((fderiv ℝ φ ((groupElement θ s).symm x)).comp
        (groupInvCLM θ s))) x :=
  (groupCLM θ s).hasFDerivAt.comp x (hφ.hasFDerivAt.comp x (groupInvCLM θ s).hasFDerivAt)

/-- The derivative of a transformed field is the conjugate `g ∘ Dφ(g⁻¹ x) ∘ g⁻¹`. -/
theorem fderiv_act {x : ℝ^3} (hφ : DifferentiableAt ℝ φ ((groupElement θ s).symm x)) :
    fderiv ℝ (act θ s φ) x =
      (groupCLM θ s).comp ((fderiv ℝ φ ((groupElement θ s).symm x)).comp
        (groupInvCLM θ s)) :=
  (hasFDerivAt_act hφ).fderiv

/-- The divergence of a transformed field is the transported divergence. -/
theorem divergence_act {x : ℝ^3} (hφ : DifferentiableAt ℝ φ ((groupElement θ s).symm x)) :
    PDE.divergence (act θ s φ) x = PDE.divergence φ ((groupElement θ s).symm x) := by
  have h1 := PDE.Analysis.divergence_eq_trace_fderiv (hasFDerivAt_act hφ).differentiableAt
  have h2 := PDE.Analysis.divergence_eq_trace_fderiv hφ
  refine h1.trans (Eq.trans ?_ h2.symm)
  rw [fderiv_act hφ]
  have hconj := LinearMap.trace_conj' (fderiv ℝ φ ((groupElement θ s).symm x)).toLinearMap
    (groupElement θ s).toLinearEquiv
  refine Eq.trans ?_ hconj
  congr 1

/-- The coordinate Laplacian commutes with the action on `C²` fields. -/
theorem laplacian_act (hφ : ContDiff ℝ 2 φ) (x : ℝ^3) :
    PDE.laplacian (act θ s φ) x =
      groupElement θ s (PDE.laplacian φ ((groupElement θ s).symm x)) := by
  rw [(contDiff_act hφ).contDiffAt.coordinate_laplacian_eq_laplacian,
    hφ.contDiffAt.coordinate_laplacian_eq_laplacian]
  have hform : act θ s φ =
      ⇑(groupElement θ s).toContinuousLinearEquiv ∘ (φ ∘ ⇑(groupElement θ s).symm) :=
    rfl
  rw [hform, InnerProductSpace.laplacian_CLE_comp_left, Function.comp_apply,
    InnerProductSpace.laplacian_comp_linearIsometryEquiv]
  rfl

/-- The action maps smooth compactly supported solenoidal test fields to test fields. -/
theorem _root_.NavierStokes.Nonuniqueness.IsSolenoidalTestField.act
    (hφ : IsSolenoidalTestField φ) (θ : ℝ) (s : Bool) : IsSolenoidalTestField (act θ s φ) := by
  refine ⟨contDiff_act hφ.1, hasCompactSupport_act hφ.2.1, fun x ↦ ?_⟩
  rw [divergence_act ((hφ.1.differentiable (by simp)) _)]
  exact hφ.2.2 _

end NavierStokes.Symmetry
