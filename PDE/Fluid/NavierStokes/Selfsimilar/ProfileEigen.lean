/-!
# Weak eigenfunctions are eigenvectors of the profile evolution

Let the transport coefficients `bᵢ` of the profile evolution `S` be the base functions of fields
`Bᵢ ∈ W^{1,∞}(ℝ³)`, with stretching coefficients `cⱼᵢ = ∂ᵢBⱼ`, and let `U` be a pointwise
representative of `b`. Then `S` is generated by `A₀ - Π B`, where `A₀ = Δ + ½ x·∇ + ½`
generates the free self-similar evolution `S₀` and `B v = (b·∇)v + (v·∇)B`; this is the
linearized self-similar operator `L_U`. A divergence-free `v ∈ H¹(ℝ³)³` solving the weak
eigenvalue equation `L_U v = μ v` of `Nonuniqueness.WeakEigenEquation` is an eigenvector of the
evolution: `S(t) v = e^{μt} v` for every `t ≥ 0` and every real `μ`
(`profileSemigroup0_apply_of_weakEigenEquation`). For an unstable profile this is
`profileSemigroup_apply_of_weakEigen`, and the weak eigenfunction of `UnstableProfile.unstable`
gives an eigenvector of `S` with an unstable eigenvalue
(`UnstableProfile.exists_profileSemigroup_eigenvector`).

The hypothesis `div v = 0` cannot be dropped. The weak equation is tested against
divergence-free fields only, so it constrains only the Leray projection of `L_U v - μ v`: for
`U = 0` every gradient field in `H¹` satisfies it, while the free evolution contracts `L²`, so for
`μ > 0` no nonzero gradient field is an eigenvector.

## How it works

We identify resolvents instead of solving the free equation in Fourier variables. Integration by
parts, with the convection terms moved back by `convectionForm_testFieldH1`, turns the weak
eigenvalue equation into the weak form of `(μ - A₀) v = -Π B v` against divergence-free test fields
(`Stationary.WeakShiftedEquation`). For `ν > 1/2` the free resolvent `(ν - A₀)⁻¹` applied to
`(ν - μ) v - Π B v` solves the same equation, so it equals `v` by uniqueness of divergence-free weak
solutions. Hence `v` lies in the generator domain of `S₀` with `A₀ v = μ v + Π B v`
(`Stationary.hasGeneratorAt_vectorLower_of_weak`). Variation of constants gives
`e^{μt} v = S₀(t) v - ∫₀ᵗ e^{μs} S₀(t - s) Π B v ds`, so the path `t ↦ e^{μt} v` solves the `H¹`
Duhamel equation of `S`, and uniqueness of its solutions (`eq_profileGain0_of_duhamel`) identifies
the path with the gaining path of `S`.
-/

@[expose] public noncomputable section

open MeasureTheory Set Filter Topology SobolevSpace SobolevSpace.GraphSpace IncompressibleFlow
open HeatEquation.WholeSpace PDE.Analysis.Evolution
open scoped ENNReal NNReal Sobolev ContDiff SobolevSpace.WholeSpaceHilbert

namespace NavierStokes.Selfsimilar

open Stationary

variable (B : Fin 3 → W^{1,∞}(ℝ^3)) {b : Fin 3 → DerivLp 3 ∞ univ}
  {c : Fin 3 → Fin 3 → DerivLp 3 ∞ univ}

/-- The weak eigenvalue equation `L_U v = μ v` is the weak form of `(μ - A₀) v = -Π B v` tested
by the free resolvent: `Σᵢ ∫ vᵢ ((μ + 1) φᵢ + ½ (Dφ(x) x)ᵢ - Δφᵢ) = -Σᵢ ∫ (B v)ᵢ φᵢ` for
divergence-free test fields `φ`, when `bᵢ` is the base function of `Bᵢ ∈ W^{1,∞}`,
`c j i = ∂ᵢBⱼ` and `U` represents `b`. -/
theorem weakShiftedEquation_of_weakEigenEquation
    (hB : ∀ i, wkpBaseCoordinateCLM (B i) = b i)
    (hc : ∀ j i, c j i = wkpCoordinateCLM (singleDerivIndex 3 i) (B j)) {U : ℝ^3 → ℝ^3}
    (hU : ∀ i, (b i : ℝ^3 → ℝ) =ᵐ[volume] fun x ↦ U x i) {μ : ℝ}
    {v : PiLp 2 (fun _ : Fin 3 ↦ H¹(ℝ^3))} (hv : Nonuniqueness.WeakEigenEquation U μ v) :
    WeakShiftedEquation μ v (-BoundedTransport.transport b c v) := by
  intro φ hφ hcφ hdiv
  obtain ⟨-, h0⟩ := hv φ ⟨hφ, hcφ, hdiv⟩
  rw [(integral_weakEigenDensity U b hU μ v hφ hcφ).2, boundedPart_apply,
    gradientForm_testFieldH1, convectionForm_testFieldH1 B hB hc, massPairing_testFieldH1] at h0
  have hdrift := sum_integral_base_mul_fderiv_apply_self v hφ hcφ
  rw [massPairing_testFieldH1] at hdrift
  have hneg : ∀ i, ∫ x, (wkpBaseCoordinateCLM ((-BoundedTransport.transport b c v) i) :
      ℝ^3 → ℝ) x * φ x i = -∫ x, (wkpBaseCoordinateCLM (BoundedTransport.transport b c v i) :
        ℝ^3 → ℝ) x * φ x i := by
    intro i
    rw [← integral_neg]
    apply integral_congr_ae
    have h := Lp.coeFn_neg (wkpBaseCoordinateCLM (BoundedTransport.transport b c v i))
    rw [← map_neg] at h
    simp only [domainMeasure, Measure.restrict_univ] at h
    filter_upwards [h] with x hx
    rw [PiLp.neg_apply, hx, Pi.neg_apply, neg_mul]
  simp only [integral_mul_shiftedAdjoint _ _ hφ hcφ, hneg, Finset.sum_add_distrib,
    Finset.sum_sub_distrib, Finset.sum_neg_distrib, ← Finset.mul_sum]
  push_cast at hdrift
  linear_combination h0 + (1 / 2 : ℝ) * hdrift

/-- A divergence-free weak eigenfunction `v` of `L_U` with eigenvalue `μ` lies in the generator
domain of the free self-similar evolution on `L²`, with `A₀ v = μ v + Π B v`. -/
theorem hasGeneratorAt_vectorLower_of_weakEigenEquation
    (hB : ∀ i, wkpBaseCoordinateCLM (B i) = b i)
    (hc : ∀ j i, c j i = wkpCoordinateCLM (singleDerivIndex 3 i) (B j)) {U : ℝ^3 → ℝ^3}
    (hU : ∀ i, (b i : ℝ^3 → ℝ) =ᵐ[volume] fun x ↦ U x i) {μ : ℝ}
    {v : PiLp 2 (fun _ : Fin 3 ↦ H¹(ℝ^3))} (hvdiv : divergenceCLM v = 0)
    (hv : Nonuniqueness.WeakEigenEquation U μ v) :
    (vectorSelfsimilarHeatSemigroup 3 0).HasGeneratorAt (vectorLower 3 0 v)
      (μ • vectorLower 3 0 v + BoundedTransport.projectedTransport b c v) := by
  have h := hasGeneratorAt_vectorLower_of_weak v hvdiv (-BoundedTransport.transport b c v)
    (weakShiftedEquation_of_weakEigenEquation B hB hc hU hv)
  rw [map_neg, sub_neg_eq_add] at h
  exact h

/-- The path `t ↦ e^{μt} v` of a divergence-free weak eigenfunction is the gaining path of the
profile evolution: `e^{μt} v = profileGain0 b c t v` in `H¹` for `t > 0`. -/
theorem exp_smul_eq_profileGain0_of_weakEigenEquation
    (hB : ∀ i, wkpBaseCoordinateCLM (B i) = b i)
    (hc : ∀ j i, c j i = wkpCoordinateCLM (singleDerivIndex 3 i) (B j)) {U : ℝ^3 → ℝ^3}
    (hU : ∀ i, (b i : ℝ^3 → ℝ) =ᵐ[volume] fun x ↦ U x i) {μ : ℝ}
    {v : PiLp 2 (fun _ : Fin 3 ↦ H¹(ℝ^3))} (hvdiv : divergenceCLM v = 0)
    (hv : Nonuniqueness.WeakEigenEquation U μ v) {t : ℝ} (ht : 0 < t) :
    Real.exp (μ * t) • v = profileGain0 b c t (vectorLower 3 0 v) := by
  have hgen := hasGeneratorAt_vectorLower_of_weakEigenEquation B hB hc hU hvdiv hv
  set w : ℝ → VectorH 3 1 := fun s ↦ Real.exp (μ * s) • v with hw
  have hwc : ContinuousOn w (Ioi 0) := (by fun_prop : Continuous w).continuousOn
  have hwb : ∀ s, 0 < s → ‖w s‖ ≤ ‖v‖ * s ^ (-(1 / 2 : ℝ)) * Real.exp ((|μ| + 1) * s) := by
    intro s hs
    have hs1 : Real.sqrt s ≤ s + 1 := by
      rw [show s + 1 = Real.sqrt ((s + 1) ^ 2) from (Real.sqrt_sq (by linarith)).symm]
      exact Real.sqrt_le_sqrt (by nlinarith)
    have hsq : Real.sqrt s ≤ Real.exp s := hs1.trans (by linarith [Real.add_one_le_exp s])
    have hmu : Real.exp (μ * s) ≤ Real.exp (|μ| * s) :=
      Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (le_abs_self μ) hs.le)
    have hsqrt : 0 < Real.sqrt s := Real.sqrt_pos.mpr hs
    have key : Real.exp (μ * s) ≤ (Real.sqrt s)⁻¹ * Real.exp ((|μ| + 1) * s) := by
      rw [le_inv_mul_iff₀ hsqrt, add_mul, one_mul, Real.exp_add]
      calc Real.sqrt s * Real.exp (μ * s) ≤ Real.exp s * Real.exp (|μ| * s) :=
            mul_le_mul hsq hmu (Real.exp_pos _).le (Real.exp_pos _).le
        _ = Real.exp (|μ| * s) * Real.exp s := mul_comm _ _
    rw [hw, norm_smul, Real.norm_of_nonneg (Real.exp_pos _).le, rpow_neg_one_half_eq_inv_sqrt hs.le]
    calc Real.exp (μ * s) * ‖v‖ = ‖v‖ * Real.exp (μ * s) := mul_comm _ _
      _ ≤ ‖v‖ * ((Real.sqrt s)⁻¹ * Real.exp ((|μ| + 1) * s)) :=
        mul_le_mul_of_nonneg_left key (norm_nonneg v)
      _ = _ := by ring
  refine eq_profileGain0_of_duhamel b c hwc hwb (fun τ hτ ↦ ?_) ht
  have hint : IntervalIntegrable (fun s ↦ projectedSelfsimilarHeatGainKernel 3 0 (τ - s)
      (BoundedTransport.transport b c (w s))) volume 0 τ :=
    intervalIntegrable_forwardIntegrand
      (continuousOn_transportKernel_apply (BoundedTransport.transport b c))
      (fun _ hr ↦ norm_transportKernel_le _ hr) hwc hwb hτ.le
  have hD := (vectorSelfsimilarHeatSemigroup 3 0).exp_smul_eq_sub_integral_of_hasGeneratorAt hgen
    hτ.le
  have key : vectorLower 3 0 (w τ) = vectorLower 3 0
      (vectorSelfsimilarHeatGainKernel 3 0 τ (vectorLower 3 0 v) -
        ∫ s in (0 : ℝ)..τ, projectedSelfsimilarHeatGainKernel 3 0 (τ - s)
          (BoundedTransport.transport b c (w s))) := by
    rw [map_sub, vectorLower_vectorSelfsimilarHeatGainKernel hτ,
      ← (vectorLower 3 0).intervalIntegral_comp_comm hint, hw, map_smul, hD,
      vectorSelfsimilarHeatSemigroup_apply]
    congr 1
    apply intervalIntegral.integral_congr_ae
    filter_upwards [Measure.ae_ne volume τ] with s hsτ hs
    rw [uIoc_of_le hτ.le] at hs
    have hpos : 0 < τ - s := sub_pos.mpr (lt_of_le_of_ne hs.2 hsτ)
    rw [vectorLower_projectedSelfsimilarHeatGainKernel hpos, vectorSelfsimilarHeatSemigroup_apply]
    simp only [map_smul]
    rw [leraySobolev_vectorSelfsimilarHeat]
    rfl
  exact vectorLower_injective 3 0 key

/-- A divergence-free weak eigenfunction `v` of the linearized self-similar operator `L_U` with
eigenvalue `μ` is an eigenvector of the profile evolution: `S(t) v = e^{μt} v` for `t ≥ 0`. The
transport coefficients `bᵢ` are the base functions of `Bᵢ ∈ W^{1,∞}`, the stretching
coefficients are `c j i = ∂ᵢBⱼ`, and `U` represents `b`. The hypothesis `div v = 0` cannot be
dropped, since the weak equation is tested against divergence-free fields only. -/
theorem profileSemigroup0_apply_of_weakEigenEquation
    (hB : ∀ i, wkpBaseCoordinateCLM (B i) = b i)
    (hc : ∀ j i, c j i = wkpCoordinateCLM (singleDerivIndex 3 i) (B j))
    (hk : ProfileCoefficientBounds 0 b c) {U : ℝ^3 → ℝ^3}
    (hU : ∀ i, (b i : ℝ^3 → ℝ) =ᵐ[volume] fun x ↦ U x i) {μ : ℝ}
    {v : PiLp 2 (fun _ : Fin 3 ↦ H¹(ℝ^3))} (hvdiv : divergenceCLM v = 0)
    (hv : Nonuniqueness.WeakEigenEquation U μ v) (t : ℝ≥0) :
    profileSemigroup0 b c hk t (vectorLower 3 0 v) = Real.exp (μ * t) • vectorLower 3 0 v := by
  rcases eq_zero_or_pos t with rfl | ht
  · simp
  rw [← vectorLower_comp_profileGain0 b c hk ht, ContinuousLinearMap.comp_apply,
    ← exp_smul_eq_profileGain0_of_weakEigenEquation B hB hc hU hvdiv hv (NNReal.coe_pos.mpr ht),
    map_smul]

/-- A divergence-free weak eigenfunction `v` of the linearization at an unstable profile, with
eigenvalue `μ`, is an eigenvector of the profile evolution on `L²`: `S(t) v = e^{μt} v` for all
`t ≥ 0`. The statement holds for every real `μ`. The hypothesis `div v = 0` cannot be dropped:
the weak eigenvalue equation is tested against divergence-free fields only. -/
theorem profileSemigroup_apply_of_weakEigen (D : Nonuniqueness.UnstableProfile)
    (hk : ProfileCoefficientBounds 0 D.transportCoefficients D.stretchingCoefficients)
    {μ : ℝ} {v : PiLp 2 (fun _ : Fin 3 ↦ H¹(ℝ^3))} (hvdiv : divergenceCLM v = 0)
    (hv : Nonuniqueness.WeakEigenEquation D.U μ v) (t : ℝ≥0) :
    profileSemigroup0 D.transportCoefficients D.stretchingCoefficients hk t (vectorLower 3 0 v) =
      Real.exp (μ * t) • vectorLower 3 0 v := by
  refine profileSemigroup0_apply_of_weakEigenEquation D.velocitySobolev (fun i ↦ rfl)
    (fun j i ↦ ?_) hk D.transportCoefficients_ae hvdiv hv t
  rw [Nonuniqueness.UnstableProfile.stretchingCoefficients, wkpBaseCoordinateCLM_partialDerivCLM,
    firstDerivIndex_one]

end NavierStokes.Selfsimilar

namespace NavierStokes.Nonuniqueness.UnstableProfile

open Selfsimilar

/-- The evolution around an unstable profile has a divergence-free eigenvector on `L²` with an
unstable eigenvalue: there are `μ > 0` and a nonzero Leray-fixed `u` with `S(t) u = e^{μt} u`
for all `t ≥ 0`. The eigenvector is the `L²` field of the weak eigenfunction of
`UnstableProfile.unstable`. -/
theorem exists_profileSemigroup_eigenvector (D : UnstableProfile)
    (hk : ProfileCoefficientBounds 0 D.transportCoefficients D.stretchingCoefficients) :
    ∃ μ : ℝ, 0 < μ ∧ ∃ u : VectorH 3 0, u ≠ 0 ∧ leraySobolev 3 0 u = u ∧
      ∀ t : ℝ≥0, profileSemigroup0 D.transportCoefficients D.stretchingCoefficients hk t u =
        Real.exp (μ * t) • u := by
  obtain ⟨μ, hμ, v, hv0, hvdiv, hv⟩ := D.unstable
  exact ⟨μ, hμ, vectorLower 3 0 v,
    fun h ↦ hv0 (vectorLower_injective 3 0 (h.trans (map_zero _).symm)),
    leraySobolev_vectorLower_of_sum_firstDerivatives_eq_zero v
      ((Stationary.divergenceCLM_apply v).symm.trans hvdiv),
    profileSemigroup_apply_of_weakEigen D hk hvdiv hv⟩

end NavierStokes.Nonuniqueness.UnstableProfile
