module

public import PDE.Fluid.Incompressible.Vorticity
import Mathlib.Analysis.Calculus.ContDiff.WithLp
import PDE.FDeriv.Calculus

/-!
# Planar streamfunctions

The planar streamfunction convention is

```text
u = (-∂₂ψ, ∂₁ψ).
```

The resulting velocity `planarStreamVelocity ψ` is divergence free when mixed partials commute. Its
counterclockwise scalar curl is `Δψ`, whereas its clockwise scalar curl is
`-Δψ`. Keeping both signs explicit prevents accidental identification of
different vorticity conventions in the literature. Chen and Hou, Part I, (2.3c), use this
streamfunction convention with the clockwise vorticity `ω = -Δψ`.

## References

* J. Chen and T. Y. Hou, "Stable nearly self-similar blowup of the 2D Boussinesq and 3D Euler
  equations with smooth data I: Analysis", arXiv:2210.07191v4, Section 2, (2.3c), p. 5.
  <https://arxiv.org/abs/2210.07191v4>
-/

@[expose] public section

open PDE (laplacian divergence)

namespace IncompressibleFlow

set_option linter.missingDocs true

noncomputable section

/-- Planar velocity `(-∂₂ψ, ∂₁ψ)` generated by a streamfunction `ψ`. -/
def planarStreamVelocity (ψ : ℝ^2 → ℝ) (x : ℝ^2) : ℝ^2 :=
  WithLp.toLp 2 ![
    -(∂[(1 : Fin 2)] ψ) x,
    (∂[(0 : Fin 2)] ψ) x]

/-- The first streamfunction-velocity component is `-∂₂ψ`. -/
@[simp]
theorem planarStreamVelocity_apply_zero
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    planarStreamVelocity ψ x 0 = -(∂[(1 : Fin 2)] ψ) x := by
  simp [planarStreamVelocity]

/-- The second streamfunction-velocity component is `∂₁ψ`. -/
@[simp]
theorem planarStreamVelocity_apply_one
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    planarStreamVelocity ψ x 1 = (∂[(0 : Fin 2)] ψ) x := by
  simp [planarStreamVelocity]

open scoped Gradient in
/-- Rotating the streamfunction gradient preserves its Euclidean norm. -/
theorem norm_planarStreamVelocity (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    ‖planarStreamVelocity ψ x‖ = ‖∇ ψ x‖ := by
  apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
  simp only [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two,
    planarStreamVelocity_apply_zero, planarStreamVelocity_apply_one,
    PDE.gradient_apply_eq_partialDeriv, neg_sq, add_comm]

/-- Taking the planar streamfunction velocity lowers finite spatial
regularity by one derivative. -/
theorem contDiff_planarStreamVelocity
    {m : ℕ} (ψ : ℝ^2 → ℝ) (hψ : ContDiff ℝ (m + 1) ψ) :
    ContDiff ℝ m (planarStreamVelocity ψ) := by
  apply (contDiff_piLp (p := (2 : ENNReal))).2
  intro i
  fin_cases i
  · simpa [planarStreamVelocity] using
      (PDE.contDiff_partialDeriv_of_succ
        (i := (1 : Fin 2)) hψ).neg
  · simpa [planarStreamVelocity] using
      PDE.contDiff_partialDeriv_of_succ
        (i := (0 : Fin 2)) hψ

/-- Multiplying a streamfunction by an amplitude and dilating its argument
multiplies the reconstructed velocity by amplitude times spatial scale. -/
theorem planarStreamVelocity_const_smul_comp_smul
    (ψ : ℝ^2 → ℝ) (amplitude scale : ℝ) (x : ℝ^2)
    (hψ : DifferentiableAt ℝ ψ (scale • x)) :
    planarStreamVelocity
        (fun y ↦ amplitude *
          ψ (scale • y)) x =
      (amplitude * scale) •
        planarStreamVelocity ψ (scale • x) := by
  have hscale (i j : Fin 2) :
      (∂[i] (fun y : ℝ^2 ↦ (scale • y) j)) x =
        scale * if i = j then 1 else 0 := by
    rw [show (fun y : ℝ^2 ↦ (scale • y) j) =
        fun y ↦ scale • y j by rfl]
    rw [PDE.partialDeriv_const_smul]
    simp [PDE.partialDeriv_coord, smul_eq_mul]
  have hpartial (i : Fin 2) :
      (∂[i] (fun y : ℝ^2 ↦ amplitude * ψ (scale • y))) x =
        amplitude * scale * (∂[i] ψ) (scale • x) := by
    rw [show (fun y : ℝ^2 ↦ amplitude * ψ (scale • y)) =
        fun y ↦ amplitude • ψ (scale • y) by
      funext y
      simp [smul_eq_mul]]
    rw [PDE.partialDeriv_const_smul]
    simp only [smul_eq_mul]
    rw [PDE.partialDeriv_comp i ψ (fun y : ℝ^2 ↦ scale • y) x hψ
      (by fun_prop)]
    simp_rw [hscale]
    fin_cases i <;> simp <;> ring
  ext i
  fin_cases i <;>
    simp [planarStreamVelocity, hpartial, smul_eq_mul]

/-- A `C²` planar streamfunction generates an incompressible velocity. -/
theorem divergence_planarStreamVelocity_eq_zero
    (ψ : ℝ^2 → ℝ) (hψ : ContDiff ℝ 2 ψ) (x : ℝ^2) :
    ∇· (planarStreamVelocity ψ) x = 0 := by
  simp only [divergence, Fin.sum_univ_two]
  change
    (∂[(0 : Fin 2)]
          (fun y ↦ -(∂[(1 : Fin 2)] ψ) y)) x +
        (∂[(1 : Fin 2)]
          (fun y ↦ (∂[(0 : Fin 2)] ψ) y)) x = 0
  rw [show (fun y ↦ -(∂[(1 : Fin 2)] ψ) y) =
      -(fun y ↦ (∂[(1 : Fin 2)] ψ) y) by rfl]
  rw [PDE.partialDeriv_neg]
  rw [PDE.partialDeriv_partialDeriv_comm (0 : Fin 2) (1 : Fin 2) hψ x]
  ring

/-- The standard counterclockwise curl of `(-∂₂ψ, ∂₁ψ)` is `Δψ`. -/
theorem spatialPlanarVorticity_planarStreamVelocity
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    spatialPlanarVorticity (planarStreamVelocity ψ) x =
      laplacian ψ x := by
  simp only [spatialPlanarVorticity, planarStreamVelocity_apply_zero,
    planarStreamVelocity_apply_one, laplacian, Fin.sum_univ_two]
  rw [show (fun y ↦ -(∂[(1 : Fin 2)] ψ) y) =
      -(fun y ↦ (∂[(1 : Fin 2)] ψ) y) by rfl]
  rw [PDE.partialDeriv_neg]
  ring

/-- The clockwise curl of `(-∂₂ψ, ∂₁ψ)` is `-Δψ`. -/
theorem spatialPlanarClockwiseVorticity_planarStreamVelocity
    (ψ : ℝ^2 → ℝ) (x : ℝ^2) :
    spatialPlanarClockwiseVorticity (planarStreamVelocity ψ) x =
      -laplacian ψ x := by
  rw [spatialPlanarClockwiseVorticity_eq_neg_spatialPlanarVorticity,
    spatialPlanarVorticity_planarStreamVelocity]

end

end IncompressibleFlow
