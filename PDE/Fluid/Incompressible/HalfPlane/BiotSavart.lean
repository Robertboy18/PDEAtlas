module

public import PDE.Fluid.Incompressible.StreamFunction
public import PDE.Elliptic.PotentialTheory.GreenFunction.HalfSpace.BiotSavart
import PDE.Elliptic.PotentialTheory.GreenFunction.HalfSpace.GradientBounds

/-!
# The half-plane Biot–Savart law and the principal-value form of the velocity gradient

For a vorticity `ω` on the upper half-plane `ℝ²₊ = {x₁ > 0}` the velocity
`halfPlaneVelocity ω = (u, v) = (-∂₁φ, ∂₀φ)` is generated by the Dirichlet Green potential
`φ = halfSpaceGreenPotential ω`, so `-Δφ = ω`, `φ = 0` on the boundary, `v = 0` on the boundary
and `ω = ∂₁u - ∂₀v` (the clockwise vorticity of Chen and Hou, Part I, (2.3c)).

With `W` the odd extension of `ω` across the boundary, `K₁ = hessianKernel 0 1 = y₀y₁/|y|⁴`,
`K₂ = hessianKernel 0 0 = (y₀² - y₁²)/(2|y|⁴)` and disc-truncated principal values, at every
point `x` of the open half-plane and for compactly supported `C²` vorticity:

* `u_x(x) = -π⁻¹ P.V.∫ K₁(x - y) W(y) dy`,
* `u_y(x) = π⁻¹ P.V.∫ K₂(x - y) W(y) dy + ω(x)/2`,
* `v_x(x) = π⁻¹ P.V.∫ K₂(x - y) W(y) dy - ω(x)/2`,
* `v_y(x) = π⁻¹ P.V.∫ K₁(x - y) W(y) dy`,

the unlocalized forms of Part I, (3.1)-(3.4). The local terms `± ω/2` come from the delta part of
`∂₀² G = π⁻¹ P.V. K₂ - δ/2`. The localized operators `u_x(x, a, b₁, b₂)`, `u_y(x, a)` and
`v_x(x, a)` of (3.4) are principal values over the boxes `Q_{a,b₁,b₂}(x)`; they keep the local
terms and differ from the velocity gradient by absolutely convergent far integrals.

## Main definitions

* `halfPlaneVelocity`: the Biot–Savart velocity `(-∂₁φ, ∂₀φ)`, with `φ` the Dirichlet Green
  potential of the vorticity.
* `velocityBox`: the box `Q_{a,b₁,b₂}(x) = [x₀ - a, x₀ + a] × [x₁ - b₁, x₁ + b₂]` of (3.4).
* `localVelocityUx`: the localized `u_x(x, a, b₁, b₂)`; `localVelocityUy` and `localVelocityVx`
  are the localized `u_y(x, a)` and `v_x(x, a)`.

## Main results

* `halfPlaneVelocity_dx_eq`: the formula after (3.3), `u_x(x) = -π⁻¹ P.V.∫ K₁(x - y) W(y) dy`.
* `halfPlaneVelocity_dy_eq`: unlocalized (3.4), `u_y(x) = π⁻¹ P.V.∫ K₂(x - y) W(y) dy + ω(x)/2`.
* `halfPlaneVelocity_vertical_dx_eq`: unlocalized (3.4),
  `v_x(x) = π⁻¹ P.V.∫ K₂(x - y) W(y) dy - ω(x)/2`.
* `hasPrincipalValueAt_halfPlaneVelocity_one_dy`: `v_y = π⁻¹ P.V.∫ K₁(x - y) W(y) dy`.
* `halfPlaneVelocity_dx_eq_local`: the principal value over `Q_{a,b₁,b₂}(x)` exists and
  `u_x(x) = u_x(x, a, b₁, b₂) - π⁻¹ ∫_{ℝ² \ Q} K₁(x - y) W(y) dy`.
* `halfPlaneVelocity_dy_eq_local`: `u_y(x) = u_y(x, a) + π⁻¹ ∫_{ℝ² \ Q_a} K₂(x - y) W(y) dy`; the
  same localization of `v_x` is `halfPlaneVelocity_vertical_dx_eq_local`.

## How it works

Near a point of the open half-plane the potential `φ` is `C²` and solves `-Δφ = ω`
(`halfSpaceGreenPotential_local_poisson`). The equation turns `u_y = -∂₁∂₁φ` into `ω + ∂₀∂₀φ`, and
the symmetry of mixed partials turns `u_x = -∂₀∂₁φ` into `-∂₁∂₀φ`. Both `∂₀∂₀φ` and `∂₁∂₀φ` are
principal values of Hessian kernels against `W`, the first with the local term `W/2`
(`hasPrincipalValueAt_partialDeriv_partialDeriv_zero`, from the Green function development), and the
four formulas rearrange these two identities. For the localized operators the box `Q_{a,b₁,b₂}(x)`
contains the disc of radius `r = min a (min b₁ b₂)` around `x` (`ball_subset_velocityBox`). Off that
disc the kernels are at most `1/(2r²)` (`abs_hessianKernel_le`), so the far integral converges
absolutely (`integrableOn_hessianKernel_compl_velocityBox`), and the principal value over the box
differs from the one over the plane by exactly that integral
(`PDE.Analysis.hasPrincipalValueAt_iff_of_ball_subset`).

## References

* J. Chen and T. Y. Hou, "Stable nearly self-similar blowup of the 2D Boussinesq and 3D Euler
  equations with smooth data I: Analysis", arXiv:2210.07191v4, Section 2, (2.3c), p. 5, for the
  clockwise vorticity, and Section 3, (3.1)-(3.4), p. 27, for the kernels, the odd extension and the
  localized velocities.
  <https://arxiv.org/abs/2210.07191v4>
-/

@[expose] public section

noncomputable section

open MeasureTheory Filter Topology Set
open GreenFunction PotentialTheory.Planar SobolevSpace

namespace IncompressibleFlow

/-- The Biot–Savart velocity `(-∂₁φ, ∂₀φ)` of a vorticity on the upper half-plane, with `φ` its
Dirichlet Green potential. -/
def halfPlaneVelocity (ω : ℝ^2 → ℝ) : ℝ^2 → ℝ^2 :=
  planarStreamVelocity (halfSpaceGreenPotential ω)

/-- The horizontal velocity is `-∂₁φ`. -/
theorem halfPlaneVelocity_zero (ω : ℝ^2 → ℝ) :
    (fun y ↦ halfPlaneVelocity ω y 0) =
      -(∂[(1 : Fin 2)] (halfSpaceGreenPotential ω)) := by
  funext y; simp [halfPlaneVelocity]

/-- The vertical velocity is `∂₀φ`. -/
theorem halfPlaneVelocity_one (ω : ℝ^2 → ℝ) :
    (fun y ↦ halfPlaneVelocity ω y 1) = ∂[(0 : Fin 2)] (halfSpaceGreenPotential ω) := by
  funext y; simp [halfPlaneVelocity]

/-- The odd extension is continuous at points of the open half-plane. -/
theorem continuousAt_oddHalfSpaceExtension_of_mem_upper {ω : ℝ^2 → ℝ} (hω : Continuous ω)
    {x : ℝ^2} (hx : x ∈ HalfSpace.upper 2) : ContinuousAt (oddHalfSpaceExtension ω) x :=
  continuousAt_oddHalfSpaceExtension hω (fun h ↦ by
    have h1 : x PDE.Common.lastIndex = 0 := h
    have h2 : (0 : ℝ) < x PDE.Common.lastIndex := hx
    linarith)

/-- The kernel `K₁ = hessianKernel 0 1` as a two-point kernel. -/
local notation "𝐊₁" => fun x y ↦ hessianKernel 0 1 (x - y)

/-- The kernel `K₂ = hessianKernel 0 0` as a two-point kernel. -/
local notation "𝐊₂" => fun x y ↦ hessianKernel 0 0 (x - y)

variable {ω : ℝ^2 → ℝ} {x : ℝ^2}

section Interior

variable (hω : ContDiff ℝ 2 ω) (hc : HasCompactSupport ω) (hx : x ∈ HalfSpace.upper 2)
include hω hc hx

/-- At a point of the open half-plane the first derivatives of the velocity `(u, v)` are second
derivatives of the Green potential `φ`: `∂₀u = -∂₁∂₀φ`, `∂₁u = ω + ∂₀∂₀φ`, `∂₀v = ∂₀∂₀φ` and
`∂₁v = ∂₁∂₀φ`. -/
private theorem second_derivatives :
    (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x =
        -(∂[(1 : Fin 2)] (∂[(0 : Fin 2)] (halfSpaceGreenPotential ω))) x ∧
      (∂[(1 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x =
        ω x + (∂[(0 : Fin 2)] (∂[(0 : Fin 2)] (halfSpaceGreenPotential ω))) x ∧
      (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 1)) x =
        (∂[(0 : Fin 2)] (∂[(0 : Fin 2)] (halfSpaceGreenPotential ω))) x ∧
      (∂[(1 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 1)) x =
        (∂[(1 : Fin 2)] (∂[(0 : Fin 2)] (halfSpaceGreenPotential ω))) x := by
  obtain ⟨hreg, hpoisson⟩ :=
    halfSpaceGreenPotential_local_poisson hω.continuous hc hx hω.contDiffAt
  have hswap := PDE.partialDeriv_partialDeriv_comm_at (0 : Fin 2) (1 : Fin 2) hreg
  simp only [PDE.laplacian, Fin.sum_univ_two] at hpoisson
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [halfPlaneVelocity_zero, PDE.partialDeriv_neg]
    exact congrArg Neg.neg hswap
  · rw [halfPlaneVelocity_zero, PDE.partialDeriv_neg]
    linarith
  · rw [halfPlaneVelocity_one]
  · rw [halfPlaneVelocity_one]

/-- **Part I, after (3.3), `u_x`**: `P.V.∫ K₁(x - y) W(y) dy = -π u_x(x)`. -/
theorem hasPrincipalValueAt_halfPlaneVelocity_zero_dx :
    PDE.Analysis.HasPrincipalValueAt univ 𝐊₁ (oddHalfSpaceExtension ω) x
      (-Real.pi * (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x) := by
  have h := hasPrincipalValueAt_partialDeriv_partialDeriv_zero 1 (hω.of_le (by norm_num)) hc
    (continuousAt_oddHalfSpaceExtension_of_mem_upper hω.continuous hx)
  rw [(second_derivatives hω hc hx).1]
  rw [ite_eq_right (show ¬((0 : Fin 2) = 1) by decide), add_zero] at h
  convert h using 1
  ring

/-- **Part I, unlocalized (3.4), `u_y`**: `P.V.∫ K₂(x - y) W(y) dy = π (u_y(x) - ω(x)/2)`. -/
theorem hasPrincipalValueAt_halfPlaneVelocity_zero_dy :
    PDE.Analysis.HasPrincipalValueAt univ 𝐊₂ (oddHalfSpaceExtension ω) x
      (Real.pi * ((∂[(1 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x - ω x / 2)) := by
  have h := hasPrincipalValueAt_partialDeriv_partialDeriv_zero 0 (hω.of_le (by norm_num)) hc
    (continuousAt_oddHalfSpaceExtension_of_mem_upper hω.continuous hx)
  rw [(second_derivatives hω hc hx).2.1]
  rw [ite_eq_left (rfl : (0 : Fin 2) = 0), oddHalfSpaceExtension_eqOn ω hx] at h
  convert h using 1
  ring

/-- **Part I, unlocalized (3.4), `v_x`**: `P.V.∫ K₂(x - y) W(y) dy = π (v_x(x) + ω(x)/2)`. -/
theorem hasPrincipalValueAt_halfPlaneVelocity_one_dx :
    PDE.Analysis.HasPrincipalValueAt univ 𝐊₂ (oddHalfSpaceExtension ω) x
      (Real.pi * ((∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 1)) x + ω x / 2)) := by
  have h := hasPrincipalValueAt_partialDeriv_partialDeriv_zero 0 (hω.of_le (by norm_num)) hc
    (continuousAt_oddHalfSpaceExtension_of_mem_upper hω.continuous hx)
  rw [(second_derivatives hω hc hx).2.2.1]
  rwa [ite_eq_left (rfl : (0 : Fin 2) = 0), oddHalfSpaceExtension_eqOn ω hx] at h

/-- `v_y = π⁻¹ P.V.∫ K₁(x - y) W(y) dy`. -/
theorem hasPrincipalValueAt_halfPlaneVelocity_one_dy :
    PDE.Analysis.HasPrincipalValueAt univ 𝐊₁ (oddHalfSpaceExtension ω) x
      (Real.pi * (∂[(1 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 1)) x) := by
  have h := hasPrincipalValueAt_partialDeriv_partialDeriv_zero 1 (hω.of_le (by norm_num)) hc
    (continuousAt_oddHalfSpaceExtension_of_mem_upper hω.continuous hx)
  rw [(second_derivatives hω hc hx).2.2.2]
  rwa [ite_eq_right (show ¬((0 : Fin 2) = 1) by decide), add_zero] at h

/-- **Part I, after (3.3)**: `u_x(x) = -π⁻¹ P.V.∫ K₁(x - y) W(y) dy`. -/
theorem halfPlaneVelocity_dx_eq :
    (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x =
      -(1 / Real.pi) * PDE.Analysis.principalValue univ 𝐊₁ (oddHalfSpaceExtension ω) x := by
  rw [(hasPrincipalValueAt_halfPlaneVelocity_zero_dx hω hc hx).principalValue_eq]
  field_simp

/-- **Part I, unlocalized (3.4)**: `u_y(x) = π⁻¹ P.V.∫ K₂(x - y) W(y) dy + ω(x)/2`. -/
theorem halfPlaneVelocity_dy_eq :
    (∂[(1 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x =
      1 / Real.pi * PDE.Analysis.principalValue univ 𝐊₂ (oddHalfSpaceExtension ω) x +
        ω x / 2 := by
  rw [(hasPrincipalValueAt_halfPlaneVelocity_zero_dy hω hc hx).principalValue_eq]
  field_simp
  ring

/-- **Part I, unlocalized (3.4)**: `v_x(x) = π⁻¹ P.V.∫ K₂(x - y) W(y) dy - ω(x)/2`. -/
theorem halfPlaneVelocity_vertical_dx_eq :
    (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 1)) x =
      1 / Real.pi * PDE.Analysis.principalValue univ 𝐊₂ (oddHalfSpaceExtension ω) x -
        ω x / 2 := by
  rw [(hasPrincipalValueAt_halfPlaneVelocity_one_dx hω hc hx).principalValue_eq]
  field_simp
  ring

end Interior

/-! ### The localized operators of Part I (3.4) -/

/-- The box `Q_{a,b₁,b₂}(x) = [x₀ - a, x₀ + a] × [x₁ - b₁, x₁ + b₂]` of Part I (3.4). -/
def velocityBox (x : ℝ^2) (a b₁ b₂ : ℝ) : Set (ℝ^2) :=
  {y | |y 0 - x 0| ≤ a ∧ x 1 - b₁ ≤ y 1 ∧ y 1 ≤ x 1 + b₂}

/-- The localized `u_x(x, a, b₁, b₂) = -π⁻¹ P.V.∫_{Q_{a,b₁,b₂}(x)} K₁(x - y) W(y) dy`. -/
def localVelocityUx (ω : ℝ^2 → ℝ) (x : ℝ^2) (a b₁ b₂ : ℝ) : ℝ :=
  -(1 / Real.pi) * PDE.Analysis.principalValue (velocityBox x a b₁ b₂) 𝐊₁
    (oddHalfSpaceExtension ω) x

/-- The localized `u_y(x, a) = π⁻¹ P.V.∫_{Q_a(x)} K₂(x - y) W(y) dy + ω(x)/2`. -/
def localVelocityUy (ω : ℝ^2 → ℝ) (x : ℝ^2) (a : ℝ) : ℝ :=
  1 / Real.pi * PDE.Analysis.principalValue (velocityBox x a a a) 𝐊₂ (oddHalfSpaceExtension ω) x +
    ω x / 2

/-- The localized `v_x(x, a) = π⁻¹ P.V.∫_{Q_a(x)} K₂(x - y) W(y) dy - ω(x)/2`. -/
def localVelocityVx (ω : ℝ^2 → ℝ) (x : ℝ^2) (a : ℝ) : ℝ :=
  1 / Real.pi * PDE.Analysis.principalValue (velocityBox x a a a) 𝐊₂ (oddHalfSpaceExtension ω) x -
    ω x / 2

/-- The box `Q_{a,b₁,b₂}(x)` is measurable. -/
theorem measurableSet_velocityBox (x : ℝ^2) (a b₁ b₂ : ℝ) :
    MeasurableSet (velocityBox x a b₁ b₂) := by
  have h0 : Continuous fun y : ℝ^2 ↦ y 0 := (EuclideanSpace.proj (0 : Fin 2)).continuous
  have h1 : Continuous fun y : ℝ^2 ↦ y 1 := (EuclideanSpace.proj (1 : Fin 2)).continuous
  have hclosed : IsClosed (velocityBox x a b₁ b₂) :=
    (isClosed_le ((h0.sub continuous_const).abs) continuous_const).inter
      ((isClosed_le continuous_const h1).inter (isClosed_le h1 continuous_const))
  exact hclosed.measurableSet

/-- The box `Q_{a,b₁,b₂}(x)` contains the open disc of radius `min a (min b₁ b₂)` around `x`. -/
theorem ball_subset_velocityBox (x : ℝ^2) {a b₁ b₂ : ℝ} :
    Metric.ball x (min a (min b₁ b₂)) ⊆ velocityBox x a b₁ b₂ := by
  intro y hy
  rw [Metric.mem_ball, dist_eq_norm] at hy
  have hc (i : Fin 2) : |y i - x i| ≤ ‖y - x‖ := by
    simpa using PiLp.norm_apply_le (y - x) i
  have h0 := hc 0
  have h1 := hc 1
  have hm1 : min a (min b₁ b₂) ≤ a := min_le_left _ _
  have hm2 : min a (min b₁ b₂) ≤ b₁ := (min_le_right _ _).trans (min_le_left _ _)
  have hm3 : min a (min b₁ b₂) ≤ b₂ := (min_le_right _ _).trans (min_le_right _ _)
  refine ⟨by linarith, ?_, ?_⟩
  · have := neg_abs_le (y 1 - x 1); linarith
  · have := le_abs_self (y 1 - x 1); linarith

/-- The far part of a Hessian-kernel integral against an integrable density is integrable off
every box around the evaluation point. -/
theorem integrableOn_hessianKernel_compl_velocityBox (i j : Fin 2) {W : ℝ^2 → ℝ}
    (hW : Integrable W) (x : ℝ^2) {a b₁ b₂ : ℝ} (hr : 0 < min a (min b₁ b₂)) :
    IntegrableOn (fun y ↦ hessianKernel i j (x - y) * W y) (univ \ velocityBox x a b₁ b₂) := by
  set r := min a (min b₁ b₂)
  have hkm : Measurable fun y ↦ hessianKernel i j (x - y) :=
    (measurable_hessianKernel i j).comp (measurable_const.sub measurable_id)
  refine (hW.integrableOn).bdd_mul (c := 1 / (2 * r ^ 2)) hkm.aestronglyMeasurable.restrict ?_
  filter_upwards [ae_restrict_mem (MeasurableSet.univ.diff (measurableSet_velocityBox x a b₁ b₂))]
    with y hy
  have hyb : y ∉ Metric.ball x r := fun h ↦ hy.2 (ball_subset_velocityBox x h)
  rw [Metric.mem_ball, not_lt, dist_eq_norm, norm_sub_rev] at hyb
  rw [Real.norm_eq_abs]
  refine (abs_hessianKernel_le i j (x - y)).trans ?_
  gcongr

section Localized

variable (hω : ContDiff ℝ 2 ω) (hc : HasCompactSupport ω) (hx : x ∈ HalfSpace.upper 2)
  {a b₁ b₂ : ℝ} (ha : 0 < a) (hb₁ : 0 < b₁) (hb₂ : 0 < b₂)
include hω hc hx ha hb₁ hb₂

omit hx in
/-- A Hessian-kernel principal value of `W` over the box `Q_{a,b₁,b₂}(x)` equals `v` exactly when
the principal value over the plane equals `v` plus the far integral over the complement of the
box. -/
private theorem local_iff {k : ℝ^2 → ℝ^2 → ℝ} {i j : Fin 2}
    (hk : k = fun x y ↦ hessianKernel i j (x - y)) {v : ℝ} :
    PDE.Analysis.HasPrincipalValueAt (velocityBox x a b₁ b₂) k (oddHalfSpaceExtension ω) x v ↔
      PDE.Analysis.HasPrincipalValueAt univ k (oddHalfSpaceExtension ω) x
        (v + ∫ y in univ \ velocityBox x a b₁ b₂, k x y * oddHalfSpaceExtension ω y) := by
  subst hk
  have hr : 0 < min a (min b₁ b₂) := lt_min ha (lt_min hb₁ hb₂)
  exact PDE.Analysis.hasPrincipalValueAt_iff_of_ball_subset (measurableSet_velocityBox x a b₁ b₂)
    MeasurableSet.univ (subset_univ _) hr (ball_subset_velocityBox x)
    (integrableOn_hessianKernel_compl_velocityBox i j
      (integrable_oddHalfSpaceExtension hω.continuous hc) x hr)

/-- **Localization of `u_x`** (Part I (3.4)): the principal value over `Q_{a,b₁,b₂}(x)` exists
and `u_x(x) = u_x(x, a, b₁, b₂) - π⁻¹ ∫_{ℝ² \ Q} K₁(x - y) W(y) dy`. -/
theorem halfPlaneVelocity_dx_eq_local :
    (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x =
      localVelocityUx ω x a b₁ b₂ -
        1 / Real.pi * ∫ y in univ \ velocityBox x a b₁ b₂,
          hessianKernel 0 1 (x - y) * oddHalfSpaceExtension ω y := by
  set F := ∫ y in univ \ velocityBox x a b₁ b₂,
    hessianKernel 0 1 (x - y) * oddHalfSpaceExtension ω y
  set D := (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x
  have hglob := hasPrincipalValueAt_halfPlaneVelocity_zero_dx hω hc hx
  have hloc : PDE.Analysis.HasPrincipalValueAt (velocityBox x a b₁ b₂) 𝐊₁
      (oddHalfSpaceExtension ω) x (-Real.pi * D - F) := by
    rw [local_iff hω hc ha hb₁ hb₂ rfl]
    convert hglob using 1
    ring
  unfold localVelocityUx
  rw [hloc.principalValue_eq]
  field_simp
  ring

omit hb₁ hb₂ in
/-- **Localization of `u_y`** (Part I (3.4), `b₁ = b₂ = a`):
`u_y(x) = u_y(x, a) + π⁻¹ ∫_{ℝ² \ Q_a} K₂(x - y) W(y) dy`. -/
theorem halfPlaneVelocity_dy_eq_local :
    (∂[(1 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x =
      localVelocityUy ω x a +
        1 / Real.pi * ∫ y in univ \ velocityBox x a a a,
          hessianKernel 0 0 (x - y) * oddHalfSpaceExtension ω y := by
  set F := ∫ y in univ \ velocityBox x a a a,
    hessianKernel 0 0 (x - y) * oddHalfSpaceExtension ω y
  set D := (∂[(1 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 0)) x
  have hglob := hasPrincipalValueAt_halfPlaneVelocity_zero_dy hω hc hx
  have hloc : PDE.Analysis.HasPrincipalValueAt (velocityBox x a a a) 𝐊₂
      (oddHalfSpaceExtension ω) x (Real.pi * (D - ω x / 2) - F) := by
    rw [local_iff hω hc ha ha ha rfl]
    convert hglob using 1
    ring
  unfold localVelocityUy
  rw [hloc.principalValue_eq]
  field_simp
  ring

omit hb₁ hb₂ in
/-- **Localization of `v_x`** (Part I (3.4), `b₁ = b₂ = a`):
`v_x(x) = v_x(x, a) + π⁻¹ ∫_{ℝ² \ Q_a} K₂(x - y) W(y) dy`. -/
theorem halfPlaneVelocity_vertical_dx_eq_local :
    (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 1)) x =
      localVelocityVx ω x a +
        1 / Real.pi * ∫ y in univ \ velocityBox x a a a,
          hessianKernel 0 0 (x - y) * oddHalfSpaceExtension ω y := by
  set F := ∫ y in univ \ velocityBox x a a a,
    hessianKernel 0 0 (x - y) * oddHalfSpaceExtension ω y
  set D := (∂[(0 : Fin 2)] (fun y ↦ halfPlaneVelocity ω y 1)) x
  have hglob := hasPrincipalValueAt_halfPlaneVelocity_one_dx hω hc hx
  have hloc : PDE.Analysis.HasPrincipalValueAt (velocityBox x a a a) 𝐊₂
      (oddHalfSpaceExtension ω) x (Real.pi * (D + ω x / 2) - F) := by
    rw [local_iff hω hc ha ha ha rfl]
    convert hglob using 1
    ring
  unfold localVelocityVx
  rw [hloc.principalValue_eq]
  field_simp
  ring

end Localized

end IncompressibleFlow
