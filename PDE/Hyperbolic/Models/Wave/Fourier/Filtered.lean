module

public import PDE.Analysis.Fourier.Schwartz.EvenDerivatives
public import PDE.Hyperbolic.Models.Wave.Fourier.Representation

/-!
# Polynomial filters in the one-dimensional wave formula

An even frequency filter can be transferred to even derivatives of the initial
data. The Fourier/d'Alembert identity then evaluates the inverse
transform using endpoint values and an interval integral. Oriented interval
integration makes the same formula valid for negative time.
-/

@[expose] public noncomputable section

open MeasureTheory FourierTransform
open scoped SchwartzMap

namespace WaveEquation.Fourier

private theorem even_filter_coefficient (k : ℕ) (σ : ℝ) :
    ((-1 : ℝ) ^ k / (2 * Real.pi) ^ (2 * k)) *
      ((-1 : ℝ) ^ k * (2 * Real.pi) ^ (2 * k) * σ ^ (2 * k)) = σ ^ (2 * k) := by
  have hsign : (-1 : ℝ) ^ k * (-1 : ℝ) ^ k = 1 := by
    rw [← pow_add, ← two_mul, pow_mul]
    norm_num
  have hc : (2 * Real.pi) ^ (2 * k) ≠ 0 := by positivity
  calc
    _ = ((-1 : ℝ) ^ k * (-1 : ℝ) ^ k) * σ ^ (2 * k) := by
      field_simp [hc]
    _ = _ := by rw [hsign, one_mul]

/-- Filtering the Fourier wave by `σ^(2k)` is the wave generated by the
`2k`-th derivatives of its data, with the Fourier normalization constant. -/
theorem filtered_fourierSolution_eq_iteratedDeriv (g h : 𝓢(ℝ, ℂ)) (k : ℕ) (s t : ℝ) :
    𝓕⁻ (fun σ : ℝ ↦ σ ^ (2 * k) •
      ((Real.cos (2 * Real.pi * σ * t) : ℂ) * 𝓕 (g : ℝ → ℂ) σ +
        (t * Real.sinc (2 * Real.pi * σ * t) : ℝ) * 𝓕 (h : ℝ → ℂ) σ)) s =
      ((-1 : ℝ) ^ k / (2 * Real.pi) ^ (2 * k)) •
        fourierSolution (iteratedDeriv (2 * k) g) (iteratedDeriv (2 * k) h) s t := by
  simp only [fourierSolution, Real.fourierInv_eq]
  rw [← integral_smul]
  apply integral_congr_ae
  filter_upwards [] with σ
  rw [g.fourier_iteratedDeriv_even, h.fourier_iteratedDeriv_even]
  simp only [Complex.real_smul, Circle.smul_def]
  have hc := congrArg Complex.ofReal (even_filter_coefficient k σ)
  have he := congrArg (fun z : ℂ ↦ (Real.fourierChar (inner ℝ σ s) : ℂ) *
    ((Real.cos (2 * Real.pi * σ * t) : ℂ) * 𝓕 (g : ℝ → ℂ) σ +
      (t * Real.sinc (2 * Real.pi * σ * t) : ℝ) * 𝓕 (h : ℝ → ℂ) σ) * z) hc
  push_cast at he ⊢
  linear_combination -he

/-- The filtered wave is given by the d'Alembert formula applied to differentiated
data. The interval integral retains its orientation for every real time. -/
theorem filtered_fourierSolution_eq_characteristicIntegral (g h : 𝓢(ℝ, ℂ)) (k : ℕ) (s t : ℝ) :
    𝓕⁻ (fun σ : ℝ ↦ σ ^ (2 * k) •
      ((Real.cos (2 * Real.pi * σ * t) : ℂ) * 𝓕 (g : ℝ → ℂ) σ +
        (t * Real.sinc (2 * Real.pi * σ * t) : ℝ) * 𝓕 (h : ℝ → ℂ) σ)) s =
      ((-1 : ℝ) ^ k / (2 * Real.pi) ^ (2 * k)) •
        ((iteratedDeriv (2 * k) g (s + t) + iteratedDeriv (2 * k) g (s - t)) / 2 +
          (1 / 2 : ℂ) * ∫ y in s - t..s + t, iteratedDeriv (2 * k) h y) := by
  rw [filtered_fourierSolution_eq_iteratedDeriv]
  congr 1
  let G := (SchwartzMap.derivCLM ℂ ℂ : 𝓢(ℝ, ℂ) → 𝓢(ℝ, ℂ))^[2 * k] g
  let H := (SchwartzMap.derivCLM ℂ ℂ : 𝓢(ℝ, ℂ) → 𝓢(ℝ, ℂ))^[2 * k] h
  have hG : (G : ℝ → ℂ) = iteratedDeriv (2 * k) g := g.coe_iterate_derivCLM ℂ (2 * k)
  have hH : (H : ℝ → ℂ) = iteratedDeriv (2 * k) h := h.coe_iterate_derivCLM ℂ (2 * k)
  rw [← hG, ← hH]
  exact fourierSolution_eq_characteristicIntegral G.integrable H.integrable
    G.continuous H.continuous (𝓕 G).integrable (𝓕 H).integrable s t

end WaveEquation.Fourier
