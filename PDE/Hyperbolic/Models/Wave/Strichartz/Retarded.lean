module

public import Mathlib.Analysis.Fourier.LpSpace
public import PDE.Analysis.MeasureTheory.Integral.OperatorFamily
public import PDE.Analysis.MeasureTheory.Lp.Cutoff
public import PDE.Analysis.MeasureTheory.Lp.Modulation
public import PDE.Hyperbolic.Models.Wave.Strichartz.Homogeneous

/-!
# The retarded wave operator on L1L2 forcing

A Fourier L2 transform and the signed sine/cosine rotation give the energy
impulse at time s. Apply the homogeneous operator and restrict its output to
the future half-line. Joint continuity and the uniform TT* bound give
Bochner integrability for L1-in-time L2 forcing, defining a bounded operator
into L4-in-time L12 space.

The integral and quotient operators are constructed here; their identification
with the physical Duhamel solution is in `Strichartz.Duhamel`.
-/

@[expose] public section

open MeasureTheory FourierTransform
open scoped ENNReal SchwartzMap

namespace WaveEquation.Strichartz

/-- Frequency of the massless three-dimensional wave propagator. -/
noncomputable def waveFrequency : ℝ^3 → ℝ := fun ξ ↦ 2 * Real.pi * ‖ξ‖

/-- The frequency function is measurable, including at the origin. -/
theorem measurable_waveFrequency : Measurable waveFrequency :=
  (continuous_const.mul continuous_norm).measurable

/-- The homogeneous wave generated by a forcing impulse at time s,
restricted to its future. Fourier transformation and the sine/cosine energy
column are L2 operators. -/
noncomputable def retardedWaveAt (s : ℝ) :
    Lp ℂ 2 (volume : Measure (ℝ^3)) →L[ℝ]
      Lp (Lp ℝ 12 (volume : Measure (ℝ^3))) 4 (volume : Measure ℝ) :=
  (Lp.indicatorCLM ℝ (s := Set.Ici s) measurableSet_Ici).comp
    (homogeneousWaveOperator.comp
      ((Lp.rotationColumn measurable_waveFrequency s).comp
        ((Lp.fourierTransformₗᵢ (ℝ^3) ℂ).toContinuousLinearEquiv.toContinuousLinearMap
          |>.restrictScalars ℝ)))

/-- The retarded impulse has the proved TT* bound, uniformly in its time. -/
theorem norm_retardedWaveAt_apply_le (s : ℝ) (u : Lp ℂ 2 (volume : Measure (ℝ^3))) :
    ‖retardedWaveAt s u‖ ≤ energyAdjointBound * ‖u‖ := by
  change ‖Lp.indicatorCLM ℝ (s := Set.Ici s) measurableSet_Ici
    (homogeneousWaveOperator (Lp.rotationColumn measurable_waveFrequency s (𝓕 u)))‖ ≤ _
  calc
    _ ≤ ‖homogeneousWaveOperator (Lp.rotationColumn measurable_waveFrequency s (𝓕 u))‖ :=
      Lp.norm_indicatorCLM_apply_le measurableSet_Ici _
    _ ≤ energyAdjointBound * ‖Lp.rotationColumn measurable_waveFrequency s (𝓕 u)‖ :=
      (homogeneousWaveOperator.le_opNorm _).trans
        (mul_le_mul_of_nonneg_right norm_homogeneousWaveOperator_le (norm_nonneg _))
    _ = _ := by rw [Lp.norm_rotationColumn, Lp.norm_fourier_eq]

/-- The retarded impulse depends jointly continuously on time and its L2 datum. -/
theorem continuous_retardedWaveAt :
    Continuous (fun z : ℝ × Lp ℂ 2 (volume : Measure (ℝ^3)) ↦ retardedWaveAt z.1 z.2) := by
  have hf : Continuous (fun z : ℝ × Lp ℂ 2 (volume : Measure (ℝ^3)) ↦ (z.1, 𝓕 z.2)) :=
    continuous_fst.prodMk ((Lp.fourierTransformₗᵢ (ℝ^3) ℂ).continuous.comp continuous_snd)
  have hc := homogeneousWaveOperator.continuous.comp
    ((Lp.continuous_rotationColumn measurable_waveFrequency).comp hf)
  exact (Lp.continuous_indicatorCLM_Ici_apply (𝕜 := ℝ)
    (by norm_num : (4 : ℝ≥0∞) ≠ ∞)).comp (continuous_fst.prodMk hc)

/-- Each fixed forcing impulse has a strongly measurable time trajectory. -/
theorem aestronglyMeasurable_retardedWaveAt (u : Lp ℂ 2 (volume : Measure (ℝ^3))) :
    AEStronglyMeasurable (fun s : ℝ ↦ retardedWaveAt s u) volume := by
  have hc : Continuous (fun s : ℝ ↦ retardedWaveAt s u) :=
    continuous_retardedWaveAt.comp (continuous_id.prodMk continuous_const)
  exact hc.aestronglyMeasurable

/-- L1L2 forcing gives a Bochner-integrable retarded impulse family. -/
theorem integrable_retardedWaveAt {f : ℝ → Lp ℂ 2 (volume : Measure (ℝ^3))}
    (hf : Integrable f) : Integrable (fun s ↦ retardedWaveAt s (f s)) :=
  hf.apply_operatorFamily retardedWaveAt aestronglyMeasurable_retardedWaveAt
    (.of_forall norm_retardedWaveAt_apply_le)

/-- The retarded Bochner integral has the L1L2 to L4L12 estimate. -/
theorem norm_integral_retardedWaveAt_le
    (f : Lp (Lp ℂ 2 (volume : Measure (ℝ^3))) 1 (volume : Measure ℝ)) :
    ‖∫ s, retardedWaveAt s (f s)‖ ≤ energyAdjointBound * ‖f‖ :=
  norm_integral_operatorFamily_le retardedWaveAt (.of_forall norm_retardedWaveAt_apply_le) f

/-- The retarded spacetime operator on L1-in-time L2 forcing. -/
noncomputable def retardedWaveOperator :
    Lp (Lp ℂ 2 (volume : Measure (ℝ^3))) 1 (volume : Measure ℝ) →L[ℝ]
      Lp (Lp ℝ 12 (volume : Measure (ℝ^3))) 4 (volume : Measure ℝ) :=
  Lp.integralOperator retardedWaveAt aestronglyMeasurable_retardedWaveAt
    (.of_forall norm_retardedWaveAt_apply_le)

/-- The retarded operator is the Bochner integral of the future impulses. -/
theorem retardedWaveOperator_apply
    (f : Lp (Lp ℂ 2 (volume : Measure (ℝ^3))) 1 (volume : Measure ℝ)) :
    retardedWaveOperator f = ∫ s, retardedWaveAt s (f s) := rfl

/-- Its operator norm is controlled by the proved homogeneous TT* constant. -/
theorem norm_retardedWaveOperator_le : ‖retardedWaveOperator‖ ≤ energyAdjointBound :=
  Lp.norm_integralOperator_le retardedWaveAt aestronglyMeasurable_retardedWaveAt
    (Real.sqrt_nonneg _) (.of_forall norm_retardedWaveAt_apply_le)

end WaveEquation.Strichartz
