module

public import PDE.Analysis.Fourier.Radon.EvenDimension
public import PDE.Hyperbolic.Models.Wave.Fourier.HilbertFilter
public import PDE.Hyperbolic.Models.Wave.Radon.Representation

/-!
# Radon wave formulas in even dimension

In dimension `2k+2`, each Radon slice is filtered by the Hilbert transform
of its `(2k+1)`-st derivative. The wave then evolves these filtered data by
the one-dimensional characteristic formula, and integration over directions
recovers the original solution.

The Hilbert principal values converge for every slice and evaluation point;
this follows from the real Schwartz Radon map. We use Euclidean surface
measure on the full sphere. In the plane the coefficient is `1/(8π)`,
with the Hilbert transform already carrying its own `1/π` normalization.
The formula holds at every real time and represents the classical Fourier
solution with the assigned displacement and velocity.
-/

@[expose] public noncomputable section

open MeasureTheory FourierTransform
open scoped RealInnerProductSpace SchwartzMap

namespace WaveEquation.Fourier

open PDE.Analysis.Fourier

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

/-- In even dimension, the characteristic integrals of Hilbert-filtered
Radon data reconstruct the classical wave generated by real Schwartz data. -/
theorem cauchySolution_eq_integral_hilbertPV_iteratedDeriv_radonTransform (g h : 𝓢(E, ℝ)) (k : ℕ)
    (hdim : Module.finrank ℝ E = 2 * k + 2) (t : ℝ) (x : E) :
    cauchySolution (g.postcompCLM Complex.ofRealCLM)
      (h.postcompCLM Complex.ofRealCLM) (t, x) =
      (((-1 : ℝ) ^ k / (4 * (2 * Real.pi) ^ (2 * k + 1))) *
        ∫ θ : Metric.sphere (0 : E) 1,
          PDE.Analysis.hilbertPV (iteratedDeriv (2 * k + 1) (radonTransform g (θ : E)))
              (⟪(θ : E), x⟫ + t) +
            PDE.Analysis.hilbertPV (iteratedDeriv (2 * k + 1) (radonTransform g (θ : E)))
              (⟪(θ : E), x⟫ - t) +
            (∫ y in ⟪(θ : E), x⟫ - t..⟪(θ : E), x⟫ + t,
              PDE.Analysis.hilbertPV
                (iteratedDeriv (2 * k + 1) (radonTransform h (θ : E))) y)
          ∂(volume : Measure E).toSphere : ℝ) := by
  have : Nontrivial E := Module.nontrivial_of_finrank_pos (R := ℝ) (by omega)
  have he (θ : Metric.sphere (0 : E) 1) : 𝓕⁻ (fun σ : ℝ ↦ |σ| ^ (2 * k + 1) •
        waveValue (2 * Real.pi * |σ|)
          (𝓕 (radonTransform (g.postcompCLM Complex.ofRealCLM) (θ : E)) σ)
          (𝓕 (radonTransform (h.postcompCLM Complex.ofRealCLM) (θ : E)) σ) t) ⟪(θ : E), x⟫ =
      (((-1 : ℝ) ^ k / (2 * (2 * Real.pi) ^ (2 * k + 1))) *
        (PDE.Analysis.hilbertPV (iteratedDeriv (2 * k + 1) (radonTransform g (θ : E)))
            (⟪(θ : E), x⟫ + t) +
          PDE.Analysis.hilbertPV (iteratedDeriv (2 * k + 1) (radonTransform g (θ : E)))
            (⟪(θ : E), x⟫ - t) + ∫ y in ⟪(θ : E), x⟫ - t..⟪(θ : E), x⟫ + t, PDE.Analysis.hilbertPV
              (iteratedDeriv (2 * k + 1) (radonTransform h (θ : E))) y) : ℝ) := by
    let G := SchwartzMap.radonTransformRealCLM (θ := (θ : E)) (by simp) g
    let H := SchwartzMap.radonTransformRealCLM (θ := (θ : E)) (by simp) h
    have hG : (G : ℝ → ℝ) = radonTransform g (θ : E) :=
      SchwartzMap.radonTransformRealCLM_apply (by simp) g
    have hH : (H : ℝ → ℝ) = radonTransform h (θ : E) :=
      SchwartzMap.radonTransformRealCLM_apply (by simp) h
    have hg : radonTransform (g.postcompCLM Complex.ofRealCLM) (θ : E) =
        fun y ↦ (G y : ℂ) := by
      funext y
      rw [hG]
      exact radonTransform_ofReal g (θ : E) y
    have hh : radonTransform (h.postcompCLM Complex.ofRealCLM) (θ : E) =
        fun y ↦ (H y : ℂ) := by
      funext y
      rw [hH]
      exact radonTransform_ofReal h (θ : E) y
    simp_rw [waveValue_real_frequency, hg, hh, ← hG, ← hH]
    exact hilbertFiltered_fourierSolution_eq_characteristicIntegral G H k _ t
  have hw := cauchySolution_eq_integral_filtered_radonTransform
    (g.postcompCLM Complex.ofRealCLM) (h.postcompCLM Complex.ofRealCLM) t x
  rw [hdim, show 2 * k + 2 - 1 = 2 * k + 1 by omega] at hw
  simp_rw [he] at hw
  rw [integral_complex_ofReal, integral_const_mul] at hw
  rw [hw]
  simp only [Complex.real_smul, ← Complex.ofReal_mul]
  congr 1
  ring

/-- In the plane, the wave formula uses Hilbert transforms of first derivatives
of the Radon data, with coefficient `1/(8π)` for the full unit circle. -/
theorem cauchySolution_eq_integral_hilbertPV_deriv_radonTransform
    (g h : 𝓢(E, ℝ)) (hdim : Module.finrank ℝ E = 2) (t : ℝ) (x : E) :
    cauchySolution (g.postcompCLM Complex.ofRealCLM)
      (h.postcompCLM Complex.ofRealCLM) (t, x) =
      ((1 / (8 * Real.pi)) * ∫ θ : Metric.sphere (0 : E) 1,
        PDE.Analysis.hilbertPV (deriv (radonTransform g (θ : E))) (⟪(θ : E), x⟫ + t) +
          PDE.Analysis.hilbertPV (deriv (radonTransform g (θ : E))) (⟪(θ : E), x⟫ - t) +
          (∫ y in ⟪(θ : E), x⟫ - t..⟪(θ : E), x⟫ + t,
            PDE.Analysis.hilbertPV (deriv (radonTransform h (θ : E))) y)
        ∂(volume : Measure E).toSphere : ℝ) := by
  have hw := cauchySolution_eq_integral_hilbertPV_iteratedDeriv_radonTransform g h 0 hdim t x
  norm_num only [Nat.mul_zero, zero_add, pow_zero, pow_one,
    iteratedDeriv_succ, iteratedDeriv_zero] at hw
  convert hw using 1
  congr 2
  ring

end WaveEquation.Fourier
