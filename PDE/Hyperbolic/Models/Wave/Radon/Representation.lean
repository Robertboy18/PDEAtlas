module

public import PDE.Analysis.Fourier.Radon.Backprojection
public import PDE.Hyperbolic.Models.Wave.Fourier.Schwartz.Integrability
public import PDE.Hyperbolic.Models.Wave.Fourier.Schwartz.Regularity

/-!
# The wave solution as filtered Radon backprojection

The Fourier slice theorem identifies each frequency line with the transform of
the corresponding hyperplane integral. Signed polar coordinates then reconstruct
the wave by averaging one-dimensional waves over directions, with the radial
Jacobian `|σ|^(n-1)` as a filter.

The sphere carries full Euclidean surface measure. Each frequency is counted
twice by signed polar coordinates, which explains the factor `1/2`.
-/

@[expose] public noncomputable section

open MeasureTheory FourierTransform
open scoped RealInnerProductSpace SchwartzMap

namespace WaveEquation.Fourier

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] [Nontrivial E]

/-- The Fourier Cauchy solution equals the filtered backprojection of
the one-dimensional waves generated by the Radon transforms of its data. -/
theorem cauchySolution_eq_integral_filtered_radonTransform (g h : 𝓢(E, ℂ)) (t : ℝ) (x : E) :
    cauchySolution g h (t, x) =
      (1 / 2 : ℝ) • ∫ θ : Metric.sphere (0 : E) 1,
        𝓕⁻ (fun σ : ℝ ↦ |σ| ^ (Module.finrank ℝ E - 1) •
          waveValue (2 * Real.pi * |σ|)
            (𝓕 (PDE.Analysis.Fourier.radonTransform g (θ : E)) σ)
            (𝓕 (PDE.Analysis.Fourier.radonTransform h (θ : E)) σ) t) ⟪(θ : E), x⟫
          ∂(volume : Measure E).toSphere := by
  have hphase : Integrable (fun ξ : E ↦ 𝐞 ⟪ξ, x⟫ •
      waveValue (2 * Real.pi * ‖ξ‖) (𝓕 g ξ) (𝓕 h ξ) t) := by
    simpa only [inner_neg_right, neg_neg] using (Real.fourierIntegral_convergent_iff (-x)).mpr
        (integrable_waveValue (𝓕 g) (𝓕 h) t)
  have hpolar := PDE.Analysis.integral_polar_addHaar_signedRadius volume hphase
  have hrec : (∫ ξ : E, 𝐞 ⟪ξ, x⟫ • waveValue (2 * Real.pi * ‖ξ‖) (𝓕 g ξ) (𝓕 h ξ) t) =
      cauchySolution g h (t, x) := by
    rw [← Real.fourierInv_eq]
    rfl
  rw [hrec] at hpolar
  calc
    cauchySolution g h (t, x) =
        (1 / 2 : ℝ) • ((2 : ℝ) • cauchySolution g h (t, x)) := by
      rw [smul_smul]
      norm_num
    _ = _ := by
      rw [← hpolar]
      congr 1
      apply integral_congr_ae
      filter_upwards [] with θ
      rw [Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards [] with σ
      rw [PDE.Analysis.Fourier.fourier_radonTransform g.integrable (by simp),
        PDE.Analysis.Fourier.fourier_radonTransform h.integrable (by simp),
        real_inner_smul_left, Real.inner_apply, norm_smul, Real.norm_eq_abs]
      simp only [norm_eq_of_mem_sphere, mul_one]
      exact smul_comm _ _ _

end WaveEquation.Fourier
