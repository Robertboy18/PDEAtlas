module

public import PDE.Analysis.Evolution.Galerkin.TrialProjection
public import PDE.Hyperbolic.Variational.GelfandGalerkin.AutonomousDifferentiation

/-!
# Finite differentiated Galerkin families

Time derivatives of a Galerkin trajectory for the autonomous abstract wave equation
`q'' + B q = ell(t)` on a Gelfand triple, taken to any finite order. If `q` solves the equation
with forcing `ell` and `ell` is absolutely continuous with derivative `ell'`, then `q'` solves it
with forcing `ell'` and data `(q'(a), q''(a)) = (p₀, -B q₀ + ell(a))`; this is the single step
`timeDerivative` from `PDE.Hyperbolic.Variational.GelfandGalerkin.AutonomousDifferentiation`.
Iterating it along a chain of forcings `ell_m, ell_{m-1} = ell_m', …, ell_0` produces the finite
differentiated family used for higher time regularity of weak solutions of second-order
hyperbolic equations in Evans, §7.2.3.

The indexing is reversed relative to differentiation order: `Fin.last m` is the supplied
trajectory, and `U r.castSucc` is the time derivative of `U r.succ`, so `U 0` is the `m`-th
derivative.

## Main results

* `initialAcceleration_eq_projection_of_ritz`: if the initial displacement is the Ritz
  (energy) projection of `q` and the compatibility condition `ell(t) - B q = J* h` holds, the
  Galerkin acceleration at time `t` is the `H`-projection of `h` onto the trial space. This is
  the basis-free form of the initial-coefficient computation in Evans, §7.2.3.
* `exists_finiteTimeDerivativeFamily`: from one trajectory and a chain of absolutely continuous
  forcings with almost-everywhere derivatives, construct trajectories at every level, with
  each level's initial position and velocity equal to the initial velocity and acceleration of
  its successor, and with the displacement and velocity link identities stated pointwise.

## Implementation notes

The family is returned as a dependent function `U : (r : Fin (m + 1)) → SecondOrderSolutionOn …`
whose types depend on the initial data `q0 r`, `p0 r`; the relations to the supplied trajectory
and to `timeDerivative` are therefore stated with `HEq`. The pointwise equalities
`(U r.castSucc).displacement = (U r.succ).velocity` are the form used elsewhere.

## References

* L. C. Evans, *Partial Differential Equations*, 2nd ed., Graduate Studies in Mathematics 19,
  American Mathematical Society, 2010, §7.2.3, Theorem 6, compatibility conditions (62), and
  equation (69).
  <https://doi.org/10.1090/gsm/019>
-/

@[expose] public section

noncomputable section

namespace Hyperbolic.Variational.GelfandGalerkin

variable {V H : Type*}
  [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/--
The Galerkin acceleration generated by compatible Ritz-projected initial
data is the pivot projection of the next Evans compatibility value.

The Ritz identity removes the spatial projection error, while pivot
orthogonality identifies the remaining mass equation.  This is the
basis-free form of the initial-coefficient calculation in Evans, §7.2.3.
-/
theorem initialAcceleration_eq_projection_of_ritz
    (T : PDE.Analysis.Evolution.GelfandTriple (V := V) (H := H)) (S : Submodule ℝ V)
    [FiniteDimensional ℝ S] [CompleteSpace S] {K : NNReal}
    (P : PDE.Analysis.Evolution.StableTrialProjection T S K) (B : V →L[ℝ] StrongDual ℝ V)
    (forcing : ℝ → StrongDual ℝ V) (t : ℝ) (q : V) (h : H)
    (hRitz : ∀ w : S, B (q - (P.energyProjection q : V)) (w : V) = 0)
    (hcompat : forcing t - B q = T.pivotToDual h) :
    -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B) (P.energyProjection q) +
        PDE.Analysis.Evolution.gelfandGalerkinForcing T S forcing t = P.projection h := by
  rw [PDE.Analysis.Evolution.neg_gelfandGalerkinOperator_add_forcing T S (fun _ ↦ B) forcing t
    (P.energyProjection q)]
  let d : S := PDE.Analysis.Evolution.gelfandGalerkinVectorField T S (fun _ ↦ B) forcing t
    (P.energyProjection q)
  let w : S := d - P.projection h
  have hequation := PDE.Analysis.Evolution.gelfandGalerkinVectorField_equation T S (fun _ ↦ B)
    forcing t (P.energyProjection q) w
  have hritz := hRitz w
  have hcompatAt := congrArg (fun L : StrongDual ℝ V ↦ L (w : V)) hcompat
  have hpivot := P.pivotOrthogonal w h
  simp only [map_sub, sub_apply, PDE.Analysis.Evolution.GelfandTriple.pivotToDual_apply,
    inner_sub_right] at hritz hcompatAt hpivot
  have hzero : inner ℝ (T.inclusion (w : V)) (T.inclusion (w : V)) = 0 := by
    have hsplit : inner ℝ (T.inclusion (w : V)) (T.inclusion (w : V)) =
        inner ℝ (T.inclusion (d : V)) (T.inclusion (w : V)) -
          inner ℝ (T.inclusion (P.projection h : V)) (T.inclusion (w : V)) := by
      rw [← inner_sub_left, ← map_sub, ← Submodule.coe_sub]
    rw [hsplit]
    linarith [real_inner_comm (T.inclusion (w : V)) h,
      real_inner_comm (T.inclusion (w : V)) (T.inclusion (P.projection h : V))]
  simp only [inner_self_eq_zero] at hzero
  exact sub_eq_zero.mp (Subtype.ext (T.injective (by simpa only [Submodule.coe_zero,
    map_zero] using hzero)))

/--
Construct all finite time derivatives of one autonomous Galerkin trajectory.
Each differentiated level carries the initial velocity and acceleration of
its successor as its initial position and velocity.
-/
theorem exists_finiteTimeDerivativeFamily
    (T : PDE.Analysis.Evolution.GelfandTriple (V := V) (H := H)) (S : Submodule ℝ V)
    [FiniteDimensional ℝ S] [CompleteSpace S] (B : V →L[ℝ] StrongDual ℝ V) {m : ℕ}
    (forcing : Fin (m + 1) → ℝ → StrongDual ℝ V) {a b : ℝ}
    (hforcingAC : ∀ r : Fin m, AbsolutelyContinuousOnInterval (forcing r.succ) a b)
    (hforcingDeriv : ∀ r : Fin m, ∀ᵐ t ∂MeasureTheory.volume.restrict (Set.Ioc a b),
      HasDerivAt (forcing r.succ) (forcing r.castSucc t) t)
    {q₀ p₀ : S}
    (Ulast : SecondOrderSolutionOn (fun _ ↦ PDE.Analysis.Evolution.gelfandGalerkinOperator T S B)
      (PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing (Fin.last m))) a b q₀ p₀) :
    ∃ (q0 p0 : Fin (m + 1) → S)
        (U : (r : Fin (m + 1)) → SecondOrderSolutionOn
          (fun _ ↦ PDE.Analysis.Evolution.gelfandGalerkinOperator T S B)
          (PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r)) a b (q0 r) (p0 r)),
      q0 (Fin.last m) = q₀ ∧ p0 (Fin.last m) = p₀ ∧ HEq (U (Fin.last m)) Ulast ∧
      ∀ r : Fin m,
        q0 r.castSucc = p0 r.succ ∧
        p0 r.castSucc = -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B) (q0 r.succ) +
          PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r.succ) a ∧
        HEq (U r.castSucc) (timeDerivative T S B (U r.succ) (hforcingAC r) (hforcingDeriv r)) ∧
        (U r.castSucc).displacement = (U r.succ).velocity ∧
        (U r.castSucc).velocity = fun t ↦
          -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B) ((U r.succ).displacement t) +
            PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r.succ) t := by
  let chain : (r : Fin (m + 1)) → Σ q0r : S, Σ p0r : S, SecondOrderSolutionOn
      (fun _ ↦ PDE.Analysis.Evolution.gelfandGalerkinOperator T S B)
      (PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r)) a b q0r p0r :=
    Fin.reverseInduction ⟨q₀, p₀, Ulast⟩ (fun r next ↦ ⟨next.2.1,
      -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B) next.1 +
        PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r.succ) a,
      timeDerivative T S B next.2.2 (hforcingAC r) (hforcingDeriv r)⟩)
  have chain_last : chain (Fin.last m) = ⟨q₀, p₀, Ulast⟩ := by
    simp only [chain, Fin.reverseInduction_last]
  have chain_castSucc (r : Fin m) : chain r.castSucc = ⟨(chain r.succ).2.1,
      -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B) (chain r.succ).1 +
        PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r.succ) a,
      timeDerivative T S B (chain r.succ).2.2 (hforcingAC r) (hforcingDeriv r)⟩ := by
    simp only [chain, Fin.reverseInduction_castSucc]
  refine ⟨fun r ↦ (chain r).1, fun r ↦ (chain r).2.1, fun r ↦ (chain r).2.2, ?_, ?_, ?_, fun r ↦ ?_⟩
  all_goals beta_reduce
  · rw [chain_last]
  · rw [chain_last]
  · rw [chain_last]
  · rw [chain_castSucc]
    exact ⟨rfl, rfl, HEq.rfl, rfl, rfl⟩

end Hyperbolic.Variational.GelfandGalerkin
