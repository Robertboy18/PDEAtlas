module

public import PDE.Analysis.Evolution.Galerkin.Gelfand.VectorField
public import PDE.Analysis.Evolution.Galerkin.TrialProjection
import PDE.Hyperbolic.Variational.GelfandGalerkin.FiniteTimeDerivative.Galerkin

/-!
# Initial data for finite differentiated Galerkin families

Evans compatibility data determine the initial position and velocity at
every level of a recursively differentiated Galerkin family.  Ritz
orthogonality identifies each finite-dimensional value with the appropriate
energy or pivot projection.

## References

* L. C. Evans, *Partial Differential Equations*, 2nd ed., Graduate Studies in Mathematics 19,
  American Mathematical Society, 2010, §7.2.3, Theorem 6, compatibility conditions (62).
  <https://doi.org/10.1090/gsm/019>
-/

@[expose] public section

noncomputable section

namespace Hyperbolic.Variational.GelfandGalerkin

variable {V H : Type*}
  [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/--
The initial data recursively generated by a finite differentiated Galerkin
family are exactly the projections of the corresponding Evans compatibility
data.
-/
theorem finiteTimeDerivativeFamily_initialData_eq_projections
    (T : PDE.Analysis.Evolution.GelfandTriple (V := V) (H := H)) (S : Submodule ℝ V)
    [FiniteDimensional ℝ S] [CompleteSpace S] {K : NNReal}
    (P : PDE.Analysis.Evolution.StableTrialProjection T S K) (B : V →L[ℝ] StrongDual ℝ V) {m : ℕ}
    (forcing : Fin (m + 1) → ℝ → StrongDual ℝ V) (a : ℝ) (q : Fin (m + 1) → V) (p : Fin (m + 1) → H)
    (q0 p0 : Fin (m + 1) → S) (hq0Last : q0 (Fin.last m) = P.energyProjection (q (Fin.last m)))
    (hp0Last : p0 (Fin.last m) = P.projection (p (Fin.last m)))
    (hrecursive : ∀ r : Fin m, q0 r.castSucc = p0 r.succ ∧ p0 r.castSucc =
      -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B) (q0 r.succ) +
      PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r.succ) a)
    (hadjacent : ∀ r : Fin m, p r.succ = T.inclusion (q r.castSucc))
    (hcompatibility : ∀ r : Fin m, forcing r.succ a - B (q r.succ) = T.pivotToDual (p r.castSucc))
    (hRitz : ∀ r : Fin m, ∀ w : S, B (q r.succ - (P.energyProjection (q r.succ) : V)) (w : V) = 0) :
    ∀ r : Fin (m + 1), q0 r = P.energyProjection (q r) ∧ p0 r = P.projection (p r) :=
  Fin.reverseInduction (motive := fun r ↦ q0 r = P.energyProjection (q r) ∧
      p0 r = P.projection (p r)) ⟨hq0Last, hp0Last⟩
    (fun r ih ↦ by
      have hq0 :
          q0 r.castSucc = P.energyProjection (q r.castSucc) := by
        calc
          q0 r.castSucc = p0 r.succ := (hrecursive r).1
          _ = P.projection (p r.succ) := ih.2
          _ = P.projection (T.inclusion (q r.castSucc)) := by
            rw [hadjacent r]
          _ = P.energyProjection (q r.castSucc) :=
            (PDE.Analysis.Evolution.StableTrialProjection.energyProjection_apply
              P (q r.castSucc)).symm
      have hp0 :
          p0 r.castSucc = P.projection (p r.castSucc) := by
        calc
          p0 r.castSucc = -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B) (q0 r.succ) +
                PDE.Analysis.Evolution.gelfandGalerkinForcing T S (forcing r.succ) a :=
            (hrecursive r).2
          _ = -(PDE.Analysis.Evolution.gelfandGalerkinOperator T S B)
                  (P.energyProjection (q r.succ)) +
                PDE.Analysis.Evolution.gelfandGalerkinForcing T S
                  (forcing r.succ) a := by
            rw [ih.1]
          _ = P.projection (p r.castSucc) := initialAcceleration_eq_projection_of_ritz
              T S P B (forcing r.succ) a (q r.succ) (p r.castSucc) (hRitz r) (hcompatibility r)
      exact ⟨hq0, hp0⟩)

end Hyperbolic.Variational.GelfandGalerkin
