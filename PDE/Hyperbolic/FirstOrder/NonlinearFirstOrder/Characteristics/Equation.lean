module

public import PDE.Common.Euclidean
public import PDE.Problem.Equation.Satisfaction
public import Mathlib.Analysis.Calculus.Gradient.Basic
import Mathlib.Tactic.Positivity.Finset

/-!
# Nonlinear first-order equations

Equations of the form `F(Du, u, x) = 0`, their residual and classical solution predicates,
and their translation to LeanPDE's `PDEProblem`. The equation is (1) of Evans, §3.2.1, with
the same variables `F(p, z, x)`.

## References

* L. C. Evans, *Partial Differential Equations*, 2nd ed., Graduate Studies in Mathematics 19,
  American Mathematical Society, 2010, §3.2.1, equation (1).
  <https://doi.org/10.1090/gsm/019>
-/

open PDE (PDEEquation PDEProblem SatisfiesPDEProblem)
open scoped Gradient

@[expose] public section

namespace NonlinearFirstOrder

open scoped RealInnerProductSpace

variable {n : ℕ}

/-- A nonlinear first-order PDE in the form `F(Du, u, x) = 0` on a domain `U`. -/
structure Equation (n : ℕ) [Fact (0 < n)] where
  /-- The nonlinearity `F(p, z, x)`; in a solution we substitute `p = Du(x)`, `z = u(x)`. -/
  F : ℝ^n → ℝ → ℝ^n → ℝ
  /-- The spatial domain where the PDE is imposed. -/
  domain : Set (ℝ^n) := Set.univ

section PositiveDimension

variable [Fact (0 < n)]

/-- Algebraic residual predicate `F(Du,u,x)=0` on the PDE domain, using the project's derivative
operator expression.

The field `u` need not be differentiable; `IsClassicalSolution` adds the analytic
classical-solution hypothesis. -/
def HasZeroResidual (pde : Equation n) (u : ℝ^n → ℝ) : Prop :=
  ∀ x ∈ pde.domain, pde.F (∇ u x) (u x) x = 0

/-- A more classical notion: `u` is differentiable on the domain and satisfies `F(Du,u,x)=0`. -/
def IsClassicalSolution
    (pde : Equation n) (u : ℝ^n → ℝ) : Prop :=
  ∀ x ∈ pde.domain, DifferentiableAt ℝ u x ∧ pde.F (∇ u x) (u x) x = 0

/-- A classical nonlinear first-order solution is differentiable at every point of the domain. -/
theorem IsClassicalSolution.differentiableAt {pde : Equation n} {u : ℝ^n → ℝ}
    (hu : IsClassicalSolution (n := n) pde u) {x : ℝ^n} (hx : x ∈ pde.domain) :
    DifferentiableAt ℝ u x :=
  (hu x hx).1

/-- A classical nonlinear first-order solution satisfies the residual equation. -/
theorem IsClassicalSolution.residual_eq_zero {pde : Equation n} {u : ℝ^n → ℝ}
    (hu : IsClassicalSolution (n := n) pde u) {x : ℝ^n} (hx : x ∈ pde.domain) :
    pde.F (∇ u x) (u x) x = 0 :=
  (hu x hx).2

/-- Every classical nonlinear first-order solution has zero residual. -/
theorem IsClassicalSolution.toHasZeroResidual {pde : Equation n} {u : ℝ^n → ℝ}
    (hu : IsClassicalSolution (n := n) pde u) :
    HasZeroResidual (n := n) pde u := by
  intro x hx
  exact hu.residual_eq_zero hx

/-- A constant function is a classical solution when its residual vanishes on the domain. -/
theorem isClassicalSolution_const (pde : Equation n) (c : ℝ)
    (h : ∀ x ∈ pde.domain, pde.F 0 c x = 0) :
    IsClassicalSolution (n := n) pde (fun _ ↦ c) := by
  intro x hx
  refine ⟨differentiableAt_const c, ?_⟩
  have hgrad : ∇ (fun _ : ℝ^n ↦ c) x = 0 := by
    ext i
    simp
  simpa [hgrad] using h x hx

/-- Turn a nonlinear first-order PDE into a `PDEProblem`. -/
noncomputable def toPDEProblem (pde : Equation n) :
    PDEProblem (ℝ^n) ℝ :=
  { eqns := [
      { Output := ℝ
        operator := fun u x ↦ pde.F (∇ u x) (u x) x
        rhs := fun _ ↦ 0
        domain := pde.domain }
    ]
    sideConditions := [] }

/-- Projection from the bundled `PDEProblem` generated by a nonlinear first-order PDE back to
the residual equation `F(Du, u, x) = 0`. -/
theorem toPDEProblem.residual_eq {pde : Equation n} {u : ℝ^n → ℝ}
    (hu : SatisfiesPDEProblem (toPDEProblem (n := n) pde) u) {x : ℝ^n} (hx : x ∈ pde.domain) :
    pde.F (∇ u x) (u x) x = 0 := by
  let eqn : PDEEquation (ℝ^n) ℝ :=
    { Output := ℝ
      operator := fun u x ↦ pde.F (∇ u x) (u x) x
      rhs := fun _ ↦ 0
      domain := pde.domain }
  have heqn : eqn ∈ (toPDEProblem (n := n) pde).eqns := by
    simp [eqn, toPDEProblem]
  have h := PDE.SatisfiesPDEProblem.eqn (pde := toPDEProblem (n := n) pde) (u := u) hu heqn hx
  simpa [eqn] using h

/-- Construct the bundled `PDEProblem` residual witness from the residual equation. -/
theorem toPDEProblem.of_residual {pde : Equation n} {u : ℝ^n → ℝ}
    (hu : HasZeroResidual (n := n) pde u) :
    SatisfiesPDEProblem (toPDEProblem (n := n) pde) u := by
  refine PDE.SatisfiesPDEProblem.mk ?_ ?_
  · intro eqn heqn x hx
    simp only [toPDEProblem, List.mem_cons, List.not_mem_nil, or_false] at heqn
    subst heqn
    exact hu x hx
  · intro eqn heqn
    simp [toPDEProblem] at heqn

/-- The `PDEProblem` encoding of a nonlinear first-order PDE is equivalent to the
residual predicate. -/
theorem satisfiesPDEProblem_toPDEProblem_iff {pde : Equation n} {u : ℝ^n → ℝ} :
    SatisfiesPDEProblem (toPDEProblem (n := n) pde) u ↔ HasZeroResidual (n := n) pde u := by
  constructor
  · intro hu x hx
    exact toPDEProblem.residual_eq (n := n) (pde := pde) (u := u) hu hx
  · intro hu
    exact toPDEProblem.of_residual (n := n) (pde := pde) (u := u) hu

end PositiveDimension

end NonlinearFirstOrder
