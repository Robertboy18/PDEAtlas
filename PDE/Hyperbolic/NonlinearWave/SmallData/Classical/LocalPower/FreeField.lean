module

public import PDE.Hyperbolic.NonlinearWave.SmallData.Classical.LocalPower.Operator
public import PDE.Hyperbolic.NonlinearWave.SmallData.Classical.LocalPower.FunctionSpace
public import PDE.Analysis.Normed.ContinuousMap.Bounded.Constant
import CAS.ExactTactic

/-!
# The free Kirchhoff field on normalized cones

The zero-displacement solution generated by the velocity is a C² function
of time and center with values in the uniform cone space. Its uniform
bound is `|t| ‖h‖∞`, so compactly supported velocity gives one positive
time interval valid at every spatial center.
-/

@[expose] public noncomputable section

open PDE.Analysis Set MeasureTheory BoundedContinuousFunction

namespace WaveEquation.SmallData.Classical.LocalPower

/-- The point on the initial slice reached from each cone point and direction. -/
def initialDirection : (Cone × Direction) →ᵇ ℝ^3 :=
  mkOfCompact ⟨fun p ↦ coneSpace p.1 + coneTime p.1 • (p.2 : ℝ^3),
    (continuous_subtype_val.snd.comp continuous_fst).add
      ((continuous_subtype_val.fst.comp continuous_fst).smul
        (continuous_subtype_val.comp continuous_snd))⟩

/-- The radius factor of the homogeneous Kirchhoff potential. -/
def timeWeight : Cone →ᵇ ℝ :=
  mkOfCompact ⟨coneTime, continuous_subtype_val.fst⟩

/-- Kirchhoff's potential, simultaneously on every point of a normalized
backward cone with physical time and center `p`. -/
def freeField (h : C(ℝ^3, ℝ)) (p : ℝ × ℝ^3) : Cone →ᵇ ℝ :=
  p.1 • (timeWeight *
    ((unitSphereArea 3)⁻¹ • partialIntegralCLM ((volume : Measure (ℝ^3)).toSphere)
      (composeCompact h (constCLM (Cone × Direction) ℝ (ℝ^3) p.2 +
        p.1 • initialDirection))))

/-- The free field is the usual radius-weighted spherical mean. -/
theorem freeField_apply (h : C(ℝ^3, ℝ)) (p : ℝ × ℝ^3) (q : Cone) :
    freeField h p q = (p.1 * coneTime q) *
      unitSphereAverage 3 h (p.2 + p.1 • coneSpace q) (p.1 * coneTime q) := by
  simp only [freeField, BoundedContinuousFunction.smul_apply,
    BoundedContinuousFunction.mul_apply, partialIntegralCLM_apply,
    composeCompact_apply, BoundedContinuousFunction.add_apply, constCLM_apply,
    const_apply, initialDirection, timeWeight, mkOfCompact_apply, smul_eq_mul]
  change p.1 * (coneTime q * ((unitSphereArea 3)⁻¹ *
    ∫ ω : Direction, h (p.2 + p.1 • (coneSpace q + coneTime q • (ω : ℝ^3)))
      ∂(volume : Measure (ℝ^3)).toSphere)) = _
  unfold unitSphereAverage
  simp only [smul_add, smul_smul, ← add_assoc, div_eq_mul_inv]
  cas

/-- Only the finite regularity of the velocity is used for the
uniform function-space regularity of the free field. -/
theorem contDiff_freeField {k : ℕ} {h : ℝ^3 → ℝ} (hh : ContDiff ℝ k h) :
    ContDiff ℝ k (freeField ⟨h, hh.continuous⟩) := by
  have ha : ContDiff ℝ k (fun p : ℝ × ℝ^3 ↦
      constCLM (Cone × Direction) ℝ (ℝ^3) p.2 + p.1 • initialDirection) :=
    ((constCLM (Cone × Direction) ℝ (ℝ^3)).contDiff.comp contDiff_snd).add
      (contDiff_fst.smul contDiff_const)
  have hc := (contDiff_composeCompact (α := Cone × Direction) hh).comp ha
  have hs : ContDiff ℝ k (fun p : ℝ × ℝ^3 ↦
      (unitSphereArea 3)⁻¹ • partialIntegralCLM ((volume : Measure (ℝ^3)).toSphere)
        (composeCompact ⟨h, hh.continuous⟩
          (constCLM (Cone × Direction) ℝ (ℝ^3) p.2 + p.1 • initialDirection))) :=
    (contDiff_const : ContDiff ℝ k (fun _ : ℝ × ℝ^3 ↦ (unitSphereArea 3)⁻¹)).smul
      ((partialIntegralCLM ((volume : Measure (ℝ^3)).toSphere)).contDiff.comp hc)
  exact contDiff_fst.smul (contDiff_const.mul hs)

/-- The uniform Kirchhoff bound gives a time interval independent of the
spatial center. -/
theorem norm_freeField_le (h : ℝ^3 →ᵇ ℝ) (p : ℝ × ℝ^3) :
    ‖freeField h.toContinuousMap p‖ ≤ |p.1| * ‖h‖ := by
  apply (BoundedContinuousFunction.norm_le (mul_nonneg (abs_nonneg _) (norm_nonneg _))).mpr
  intro q
  rw [freeField_apply]
  have harea : 0 < unitSphereArea 3 := unitSphereArea_pos
  have havg : ‖unitSphereAverage 3 h
      (p.2 + p.1 • coneSpace q) (p.1 * coneTime q)‖ ≤ ‖h‖ := by
    unfold unitSphereAverage
    rw [norm_div, Real.norm_of_nonneg harea.le]
    apply (div_le_iff₀ harea).mpr
    exact norm_integral_le_of_norm_le_const
      (Filter.Eventually.of_forall fun ω ↦ h.norm_coe_le_norm _)
  rw [norm_mul, norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (coneTime_mem q).1]
  calc
    |p.1| * coneTime q * ‖unitSphereAverage 3 h (p.2 + p.1 • coneSpace q) (p.1 * coneTime q)‖ ≤
        |p.1| * coneTime q * ‖h‖ := mul_le_mul_of_nonneg_left havg
        (mul_nonneg (abs_nonneg _) (coneTime_mem q).1)
    _ ≤ |p.1| * 1 * ‖h‖ := by
      gcongr
      exact (coneTime_mem q).2
    _ = |p.1| * ‖h‖ := by rw [mul_one]

/-- The free field restricts to the free field with the corresponding
physical time and center. -/
theorem restrictCone_freeField (h : C(ℝ^3, ℝ)) (p : ℝ × ℝ^3) (q : Cone) :
    restrictCone q (freeField h p) = freeField h (p.1 * coneTime q, p.2 + p.1 • coneSpace q) := by
  ext r
  simp only [restrictCone_apply, freeField_apply, coneTime_descend, coneSpace_descend,
    mul_assoc, smul_add, smul_smul, add_assoc]

end WaveEquation.SmallData.Classical.LocalPower
