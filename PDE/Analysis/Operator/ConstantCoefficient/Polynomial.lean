module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.LinearAlgebra.Matrix.Module
public import Mathlib.LinearAlgebra.Matrix.Adjugate

/-!
# Polynomials in commuting operators

A commuting family of endomorphisms gives an action of the multivariate
polynomial ring. The construction uses Mathlib's commutative subalgebra
generated by that family. Matrix adjugates then reduce a system of polynomial
operator equations to a scalar determinant equation for each component.

In the distributional application the endomorphisms are weak derivatives.
-/

@[expose] public noncomputable section

open scoped IsMulCommutative Matrix.Module

namespace PDE.Analysis

variable {R M ι κ : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- Polynomial evaluation at a commuting family of endomorphisms. -/
def commutingPolynomialEval (D : ι → Module.End R M)
    (hD : ∀ i j, Commute (D i) (D j)) :
    MvPolynomial ι R →ₐ[R] Module.End R M :=
  let S := Algebra.adjoin R (Set.range D)
  have hcomm : (Set.range D).Pairwise Commute := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _
    exact hD i j
  letI : IsMulCommutative S := Algebra.isMulCommutative_adjoin R hcomm
  S.val.comp (MvPolynomial.aeval fun i ↦
    (⟨D i, Algebra.subset_adjoin (Set.mem_range_self i)⟩ : S))

/-- A coordinate polynomial acts by the specified endomorphism. -/
@[simp]
theorem commutingPolynomialEval_X (D : ι → Module.End R M)
    (hD : ∀ i j, Commute (D i) (D j)) (i : ι) :
    commutingPolynomialEval D hD (MvPolynomial.X i) = D i := by
  simp [commutingPolynomialEval]

/-- The adjugate identity for polynomial operator systems on an arbitrary
module. Every component satisfies the determinant equation, without requiring
additional regularity of that component. -/
theorem polynomialDeterminant_annihilates
    [Fintype κ] [DecidableEq κ]
    (D : ι → Module.End R M) (hD : ∀ i j, Commute (D i) (D j))
    (P : Matrix κ κ (MvPolynomial ι R)) (u : κ → M)
    (hu : ∀ i, ∑ j, commutingPolynomialEval D hD (P i j) (u j) = 0) :
    ∀ i, commutingPolynomialEval D hD P.det (u i) = 0 := by
  let E := commutingPolynomialEval D hD
  let : Module (MvPolynomial ι R) M := Module.compHom M E.toRingHom
  have hsystem : P • u = 0 := funext hu
  have hdet := congrArg (fun v : κ → M ↦ P.adjugate • v) hsystem
  rw [← mul_smul, Matrix.adjugate_mul, smul_assoc, one_smul, smul_zero] at hdet
  exact fun i ↦ congrFun hdet i

end PDE.Analysis
