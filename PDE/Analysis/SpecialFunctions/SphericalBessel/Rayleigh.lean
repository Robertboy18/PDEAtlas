module

public import PDE.Analysis.SpecialFunctions.SphericalBessel.Basic
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Series
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv

/-!
# Rayleigh formulas for spherical Bessel functions

Comparing the series with the sine series gives `x j_0 x = sin x` at every real point, and
differentiating `sin x / x` gives `j_1 x = sin x / x ^ 2 - cos x / x` for `x ≠ 0`. The
three-term recurrence `j_{l+2} = (2l + 3) x⁻¹ j_{l+1} - j_l` then gives the Rayleigh form
`j_l x = P_l (1 / x) sin x + Q_l (1 / x) cos x` for `x ≠ 0`, with integer polynomials
generated by the same recurrence from `P_0 = X`, `P_1 = X ^ 2`, `Q_0 = 0` and `Q_1 = -X`.

## Main definitions

* `rayleighSin l`, `rayleighCos l`: the Rayleigh polynomials `P_l`, `Q_l` in `ℤ[X]`.
* `rayleighPair u l`: the values `((P_l u, Q_l u), (P_{l+1} u, Q_{l+1} u))` in any commutative
  ring, computed by the recurrence; over `ℚ` it is executable.

## Main results

* `mul_sphericalBesselJ_zero`: `x j_0 x = sin x`.
* `sphericalBesselJ_one_eq`: `j_1 x = sin x / x ^ 2 - cos x / x` for `x ≠ 0`.
* `sphericalBesselJ_eq_rayleigh`: `j_l x = P_l (x⁻¹) sin x + Q_l (x⁻¹) cos x` for `x ≠ 0`.
-/

@[expose] public noncomputable section

namespace PDE.Analysis.SpecialFunctions

open Nat Filter Set Polynomial
open scoped Topology

/-- `x t_{0,k} x` is the `k`-th term of the sine series. -/
theorem mul_sphericalBesselTerm_zero (k : ℕ) (x : ℝ) :
    x * sphericalBesselTerm 0 k x = (-1) ^ k * x ^ (2 * k + 1) / (2 * k + 1)! := by
  have hfac : ((2 * k + 1)! : ℝ) = ((2 * k + 1)‼ : ℕ) * (2 ^ k * k !) := by
    rw [Nat.factorial_eq_mul_doubleFactorial, Nat.doubleFactorial_two_mul]
    push_cast
    ring
  have hk : (0 : ℝ) < k ! := by exact_mod_cast Nat.factorial_pos k
  have hd : (0 : ℝ) < ((2 * k + 1)‼ : ℕ) := by exact_mod_cast Nat.doubleFactorial_pos _
  unfold sphericalBesselTerm
  rw [hfac, mul_zero, zero_add, div_pow, neg_pow, pow_add, pow_mul, pow_one]
  field_simp

/-- `x j_0 x = sin x` at every real point. -/
theorem mul_sphericalBesselJ_zero (x : ℝ) : x * sphericalBesselJ 0 x = Real.sin x := by
  have h := ((summable_sphericalBesselTerm 0 x).hasSum.mul_left x)
  simp only [mul_sphericalBesselTerm_zero] at h
  rw [sphericalBesselJ_zero_left]
  exact h.unique (Real.hasSum_sin x)

/-- `j_0 x = sin x / x` for `x ≠ 0`. -/
theorem sphericalBesselJ_zero_eq {x : ℝ} (hx : x ≠ 0) :
    sphericalBesselJ 0 x = Real.sin x / x := by
  rw [eq_div_iff hx, mul_comm, mul_sphericalBesselJ_zero]

/-- `j_1 x = sin x / x ^ 2 - cos x / x` for `x ≠ 0`. -/
theorem sphericalBesselJ_one_eq {x : ℝ} (hx : x ≠ 0) :
    sphericalBesselJ 1 x = Real.sin x / x ^ 2 - Real.cos x / x := by
  have hev : sphericalBesselJ 0 =ᶠ[𝓝 x] fun y ↦ Real.sin y / y := by
    filter_upwards [isOpen_ne.mem_nhds hx] with y hy using sphericalBesselJ_zero_eq hy
  have hq : HasDerivAt (fun y ↦ Real.sin y / y) ((Real.cos x * x - Real.sin x * 1) / x ^ 2) x :=
    (Real.hasDerivAt_sin x).div (hasDerivAt_id x) hx
  have h := (hasDerivAt_sphericalBesselJ_zero x).unique (hq.congr_of_eventuallyEq hev)
  rw [show sphericalBesselJ 1 x = -((Real.cos x * x - Real.sin x * 1) / x ^ 2) by linarith]
  field_simp
  ring

/-- The Rayleigh polynomial `P_l` multiplying `sin x`. -/
def rayleighSin : ℕ → ℤ[X]
  | 0 => X
  | 1 => X ^ 2
  | l + 2 => C (2 * (l : ℤ) + 3) * X * rayleighSin (l + 1) - rayleighSin l

/-- The Rayleigh polynomial `Q_l` multiplying `cos x`. -/
def rayleighCos : ℕ → ℤ[X]
  | 0 => 0
  | 1 => -X
  | l + 2 => C (2 * (l : ℤ) + 3) * X * rayleighCos (l + 1) - rayleighCos l

/-- The Rayleigh form at the point `x`, `P_l (x⁻¹) sin x + Q_l (x⁻¹) cos x`. -/
def rayleighForm (l : ℕ) (x : ℝ) : ℝ :=
  aeval x⁻¹ (rayleighSin l) * Real.sin x + aeval x⁻¹ (rayleighCos l) * Real.cos x

/-- The Rayleigh form satisfies the three-term recurrence of the spherical Bessel functions. -/
theorem rayleighForm_add_two (l : ℕ) (x : ℝ) :
    rayleighForm (l + 2) x = (2 * l + 3) * x⁻¹ * rayleighForm (l + 1) x - rayleighForm l x := by
  simp only [rayleighForm, rayleighSin, rayleighCos, map_sub, map_mul, map_add, map_ofNat,
    map_natCast, aeval_X]
  ring

/-- **Rayleigh's formula**: `j_l x = P_l (x⁻¹) sin x + Q_l (x⁻¹) cos x` for `x ≠ 0`. -/
theorem sphericalBesselJ_eq_rayleigh (l : ℕ) {x : ℝ} (hx : x ≠ 0) :
    sphericalBesselJ l x =
      aeval x⁻¹ (rayleighSin l) * Real.sin x + aeval x⁻¹ (rayleighCos l) * Real.cos x := by
  change sphericalBesselJ l x = rayleighForm l x
  have key : ∀ l, sphericalBesselJ l x = rayleighForm l x ∧
      sphericalBesselJ (l + 1) x = rayleighForm (l + 1) x := by
    intro l
    induction l with
    | zero =>
      constructor
      · rw [sphericalBesselJ_zero_eq hx]
        simp only [rayleighForm, rayleighSin, rayleighCos, aeval_X, map_zero, zero_mul,
          add_zero]
        field_simp
      · rw [sphericalBesselJ_one_eq hx]
        simp only [rayleighForm, rayleighSin, rayleighCos, aeval_X, map_pow, map_neg]
        field_simp
        ring
    | succ l ih =>
      refine ⟨ih.2, ?_⟩
      rw [rayleighForm_add_two, ← ih.1, ← ih.2]
      have h := mul_sphericalBesselJ_add_sphericalBesselJ l x
      field_simp
      linear_combination h
  exact (key l).1

/-- The values of `(P_l, Q_l)` and `(P_{l+1}, Q_{l+1})` at `u`, computed by the recurrence. -/
def rayleighPair {R : Type*} [CommRing R] (u : R) : ℕ → (R × R) × (R × R)
  | 0 => ((u, 0), (u ^ 2, -u))
  | l + 1 =>
    let p := rayleighPair u l
    (p.2, ((2 * (l : R) + 3) * u * p.2.1 - p.1.1, (2 * (l : R) + 3) * u * p.2.2 - p.1.2))

/-- `rayleighPair` evaluates the Rayleigh polynomials. -/
theorem rayleighPair_eq {R : Type*} [CommRing R] (u : R) (l : ℕ) :
    rayleighPair u l = ((aeval u (rayleighSin l), aeval u (rayleighCos l)),
      (aeval u (rayleighSin (l + 1)), aeval u (rayleighCos (l + 1)))) := by
  induction l with
  | zero => simp [rayleighPair, rayleighSin, rayleighCos]
  | succ l ih =>
    rw [rayleighPair, ih]
    simp only [rayleighSin, rayleighCos, map_sub, map_mul, map_add, map_ofNat, map_natCast,
      aeval_X]

/-- Ring homomorphisms commute with `rayleighPair`. -/
theorem map_rayleighPair {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (u : R)
    (l : ℕ) :
    rayleighPair (f u) l = (((f (rayleighPair u l).1.1, f (rayleighPair u l).1.2),
      (f (rayleighPair u l).2.1, f (rayleighPair u l).2.2))) := by
  induction l with
  | zero => simp [rayleighPair]
  | succ l ih =>
    rw [rayleighPair, rayleighPair, ih]
    simp only [map_sub, map_mul, map_add, map_ofNat, map_natCast]

end PDE.Analysis.SpecialFunctions
