module

public import PDE.Analysis.Evolution.Semigroup.Form.Resolvent
public import PDE.Analysis.Evolution.Semigroup.Generation.Identification

/-!
# Contraction semigroups generated by nonnegative forms

The resolvent and density proofs for an energy form feed the Hille–Yosida construction.
The resulting semigroup has exactly the weak form operator as its generator. This is the
abstract form of Evans §7.4.3, Theorem 5, for a nonnegative form, where the semigroup is a
contraction semigroup.
Its orbits from the operator domain solve the evolution equation in the pivot space,
and their derivatives agree with the weak energy equation.

## References

* L. C. Evans, *Partial Differential Equations*, 2nd ed., Graduate Studies in Mathematics 19,
  American Mathematical Society, 2010, §7.4.3, Theorem 5, p. 442. <https://doi.org/10.1090/gsm/019>
-/

@[expose] public section

noncomputable section

namespace PDE.Analysis.Evolution.GelfandTriple

open Filter Set
open scoped Topology InnerProductSpace

variable {V H : Type*}
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable (T : GelfandTriple (V := V) (H := H)) (B : V →L[ℝ] StrongDual ℝ V)
variable (hnonneg : ∀ u, 0 ≤ B u u) (hcoercive : IsCoercive (B + T.energyToDual))

/-- The semigroup constructed from the form's variational resolvents by Hille–Yosida. -/
def formSemigroup : StronglyContinuousSemigroup H :=
  (T.hasContractionResolvent_formOperator B hnonneg hcoercive).semigroup
    (T.dense_formOperator_domain B hcoercive)

/-- The constructed form semigroup is contractive in the pivot norm. -/
theorem formSemigroup_isContraction :
    (T.formSemigroup B hnonneg hcoercive).IsContraction :=
  (T.hasContractionResolvent_formOperator B hnonneg hcoercive).semigroup_isContraction
    (T.dense_formOperator_domain B hcoercive)

/-- The generator equality includes equality of domains, not merely an extension. -/
theorem generatorPMap_formSemigroup :
    (T.formSemigroup B hnonneg hcoercive).generatorPMap = T.formOperator B :=
  (T.hasContractionResolvent_formOperator B hnonneg hcoercive).generatorPMap_semigroup
    (T.dense_formOperator_domain B hcoercive)

include hnonneg hcoercive in
/-- The weak form operator is closed in the pivot space. -/
theorem isClosed_formOperator :
    (T.formOperator B).IsClosed := by
  rw [← T.generatorPMap_formSemigroup B hnonneg hcoercive]
  exact (T.formSemigroup B hnonneg hcoercive).isClosed_generatorPMap

/-- The infinitesimal generator relation is exactly the weak form equation. -/
theorem hasGeneratorAt_formSemigroup_iff (x f : H) :
    (T.formSemigroup B hnonneg hcoercive).HasGeneratorAt x f ↔
      ∃ u, T.inclusion u = x ∧ B u = -T.pivotToDual f := by
  rw [StronglyContinuousSemigroup.hasGeneratorAt_iff_mem_generatorPMap_graph,
    T.generatorPMap_formSemigroup, T.mem_formOperator_graph_iff]

/-- A form-domain vector with a pivot-valued weak operator has the expected generator value. -/
theorem hasGeneratorAt_formSemigroup (x : (T.formOperator B).domain) :
    (T.formSemigroup B hnonneg hcoercive).HasGeneratorAt x (T.formOperator B x) :=
  (T.hasGeneratorAt_formSemigroup_iff B hnonneg hcoercive _ _).2
    (T.formOperator_spec B x)

/-- An orbit from the operator domain has an energy representative satisfying the weak equation. -/
theorem formSemigroup_weakEquation (x : (T.formOperator B).domain) (t : NNReal) :
    ∃ u, T.inclusion u = T.formSemigroup B hnonneg hcoercive t x ∧
      ∀ v, ⟪T.formSemigroup B hnonneg hcoercive t (T.formOperator B x),
        T.inclusion v⟫_ℝ + B u v = 0 := by
  obtain ⟨u, hu, hBu⟩ :=
    (T.hasGeneratorAt_formSemigroup_iff B hnonneg hcoercive _ _).1
      ((T.hasGeneratorAt_formSemigroup B hnonneg hcoercive x).map t)
  refine ⟨u, hu, fun v ↦ ?_⟩
  have h := DFunLike.congr_fun hBu v
  change B u v = -⟪_, T.inclusion v⟫_ℝ at h
  rw [h, add_neg_cancel]

/-- The form semigroup preserves the exact operator domain. -/
theorem formSemigroup_mem_domain (x : (T.formOperator B).domain) (t : NNReal) :
    T.formSemigroup B hnonneg hcoercive t x ∈ (T.formOperator B).domain := by
  obtain ⟨u, hu, hBu⟩ :=
    (T.hasGeneratorAt_formSemigroup_iff B hnonneg hcoercive _ _).1
      ((T.hasGeneratorAt_formSemigroup B hnonneg hcoercive x).map t)
  exact (T.mem_formOperator_domain_iff B _).2 ⟨u, hu, _, hBu⟩

/-- At positive times, the orbit derivative is the evolved weak generator value. -/
theorem hasDerivAt_formSemigroup (x : (T.formOperator B).domain) {t : ℝ} (ht : 0 < t) :
    HasDerivAt ((T.formSemigroup B hnonneg hcoercive).realOrbit x)
      ((T.formSemigroup B hnonneg hcoercive).realOrbit (T.formOperator B x) t) t :=
  (T.hasGeneratorAt_formSemigroup B hnonneg hcoercive x).hasDerivAt_realOrbit ht

/-- Every initial pivot vector is attained strongly at time zero. -/
theorem tendsto_formSemigroup_zero (x : H) :
    Tendsto (fun t ↦ T.formSemigroup B hnonneg hcoercive t x) (𝓝 0) (𝓝 x) := by
  have h := ((T.formSemigroup B hnonneg hcoercive).continuousAt_orbit x 0).tendsto
  unfold StronglyContinuousSemigroup.orbit at h
  rwa [StronglyContinuousSemigroup.map_zero_apply] at h

end PDE.Analysis.Evolution.GelfandTriple
