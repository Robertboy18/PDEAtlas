module

public import PDE.Analysis.Evolution.Semigroup.ExponentialShift
public import PDE.Analysis.Evolution.Semigroup.Form.Generation

/-!
# Semigroups generated by forms satisfying a Gårding inequality

Coercivity after adding a pivot mass term gives a contraction semigroup for the shifted
form. Exponential rescaling removes the shift and identifies the entire original generator
graph. Symmetry is not required.
-/

@[expose] public section

noncomputable section

namespace PDE.Analysis.Evolution.GelfandTriple

open scoped InnerProductSpace

variable {V H : Type*}
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable (T : GelfandTriple (V := V) (H := H)) (B : V →L[ℝ] StrongDual ℝ V)
variable (ω : ℝ) (hcoercive : IsCoercive (B + ω • T.energyToDual))

include hcoercive

omit [CompleteSpace V] [CompleteSpace H] in
/-- A coercive mass shift makes the energy form nonnegative. -/
theorem shiftedForm_nonneg (u : V) :
    0 ≤ (B + ω • T.energyToDual) u u := by
  obtain ⟨β, hβ, hbound⟩ := hcoercive
  exact (mul_nonneg (mul_nonneg hβ.le (norm_nonneg u)) (norm_nonneg u)).trans (hbound u)

omit [CompleteSpace V] [CompleteSpace H] in
/-- Adding one more pivot mass term preserves coercivity. -/
theorem shiftedForm_add_energyToDual_isCoercive :
    IsCoercive ((B + ω • T.energyToDual) + T.energyToDual) := by
  obtain ⟨β, hβ, hbound⟩ := hcoercive
  refine ⟨β, hβ, fun u ↦ ?_⟩
  exact (hbound u).trans (le_add_of_nonneg_right real_inner_self_nonneg)

/-- The semigroup constructed from the coercive shifted form and its variational resolvents. -/
def shiftedFormSemigroup : StronglyContinuousSemigroup H :=
  (T.formSemigroup (B + ω • T.energyToDual)
    (T.shiftedForm_nonneg B ω hcoercive)
    (T.shiftedForm_add_energyToDual_isCoercive B ω hcoercive)).expRescale ω

/-- The mass shift is an exponential growth bound for the constructed semigroup. -/
theorem norm_shiftedFormSemigroup_le (t : NNReal) :
    ‖T.shiftedFormSemigroup B ω hcoercive t‖ ≤ Real.exp (ω * (t : ℝ)) :=
  (T.formSemigroup_isContraction (B + ω • T.energyToDual)
    (T.shiftedForm_nonneg B ω hcoercive)
    (T.shiftedForm_add_energyToDual_isCoercive B ω hcoercive)).norm_expRescale_le ω t

/-- Removing the mass shift gives precisely the original weak generator equation. -/
theorem hasGeneratorAt_shiftedFormSemigroup_iff (x f : H) :
    (T.shiftedFormSemigroup B ω hcoercive).HasGeneratorAt x f ↔
      ∃ u, T.inclusion u = x ∧ B u = -T.pivotToDual f := by
  rw [shiftedFormSemigroup, StronglyContinuousSemigroup.hasGeneratorAt_expRescale_iff,
    T.hasGeneratorAt_formSemigroup_iff]
  apply exists_congr
  intro u
  apply and_congr_right
  intro hu
  have hmass : T.energyToDual u = T.pivotToDual x := by
    change T.pivotToDual (T.inclusion u) = _
    rw [hu]
  change B u + ω • T.energyToDual u = -T.pivotToDual (f - ω • x) ↔ _
  rw [hmass, map_sub, map_smul, neg_sub, sub_eq_add_neg,
    add_comm (ω • T.pivotToDual x), add_right_cancel_iff]

/-- The constructed semigroup has the full weak form operator as its generator. -/
theorem generatorPMap_shiftedFormSemigroup :
    (T.shiftedFormSemigroup B ω hcoercive).generatorPMap = T.formOperator B := by
  apply LinearPMap.eq_of_eq_graph
  ext p
  rw [← StronglyContinuousSemigroup.hasGeneratorAt_iff_mem_generatorPMap_graph,
    T.hasGeneratorAt_shiftedFormSemigroup_iff, T.mem_formOperator_graph_iff]

/-- A form satisfying a Gårding inequality defines a closed pivot-space operator. -/
theorem isClosed_formOperator_of_shift :
    (T.formOperator B).IsClosed := by
  rw [← T.generatorPMap_shiftedFormSemigroup B ω hcoercive]
  exact (T.shiftedFormSemigroup B ω hcoercive).isClosed_generatorPMap

end PDE.Analysis.Evolution.GelfandTriple
