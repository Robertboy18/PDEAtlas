/-!
# Semigroups generated by bounded operators

The Banach-algebra exponential `NormedSpace.exp` constructs a strongly continuous semigroup
from any bounded linear operator; the semigroup law is Mathlib's `exp_add_of_commute` and the
derivative is `hasDerivAt_exp_smul_const`. If `B = c(C - I)` with `c ≥ 0` and `‖C‖ ≤ 1`, the
resulting semigroup is contractive. This supplies the approximate semigroups
`S_λ(t) = e^{tA_λ}` of step 4 of the proof of Evans §7.4.2, Theorem 4, and the comparison
estimate of step 5.

## References

* L. C. Evans, *Partial Differential Equations*, 2nd ed., Graduate Studies in Mathematics 19,
  American Mathematical Society, 2010, §7.4.2, proof of Theorem 4, steps 4-5, p. 440.
  <https://doi.org/10.1090/gsm/019>
-/

@[expose] public section

noncomputable section

open NormedSpace

namespace PDE.Analysis.Evolution

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- Rational scalars on bounded real endomorphisms, as required by the exponential series. -/
local instance normedAlgebraRatEndomorphism : NormedAlgebra ℚ (E →L[ℝ] E) :=
  NormedAlgebra.restrictScalars ℚ ℝ (E →L[ℝ] E)

namespace StronglyContinuousSemigroup

/-- The semigroup obtained by exponentiating a bounded operator. -/
def exponential (B : E →L[ℝ] E) : StronglyContinuousSemigroup E where
  toMonoidHom :=
    { toFun := fun t ↦ exp ((t.toAdd : ℝ) • B)
      map_one' := by simp
      map_mul' := by
        intro s t
        change exp (((s.toAdd + t.toAdd : NNReal) : ℝ) • B) =
          exp ((s.toAdd : ℝ) • B) * exp ((t.toAdd : ℝ) • B)
        rw [NNReal.coe_add, add_smul]
        exact exp_add_of_commute (((Commute.refl B).smul_left _).smul_right _) }
  continuous_toPointwise :=
    (ContinuousLinearMap.toPointwiseConvergenceCLM ℝ (RingHom.id ℝ) E E).continuous.comp
      (exp_continuous.comp (NNReal.continuous_coe.smul continuous_const))

/-- The bounded-generator semigroup evaluates to the operator exponential. -/
@[simp]
theorem exponential_apply (B : E →L[ℝ] E) (t : NNReal) :
    exponential B t = exp ((t : ℝ) • B) :=
  rfl

/-- Differentiating a bounded-operator exponential orbit gives `exp(tB)Bx`. -/
theorem hasDerivAt_exponential_apply (B : E →L[ℝ] E) (x : E) (t : ℝ) :
    HasDerivAt (fun s : ℝ ↦ exp (s • B) x) (exp (t • B) (B x)) t :=
  (ContinuousLinearMap.apply ℝ E x).hasFDerivAt.comp_hasDerivAt t
    (hasDerivAt_exp_smul_const B t)

/-- Every vector belongs to the generator domain of a bounded-operator semigroup. -/
theorem exponential_hasGeneratorAt (B : E →L[ℝ] E) (x : E) :
    (exponential B).HasGeneratorAt x (B x) := by
  have h : HasDerivAt (fun s : ℝ ↦ exp (s • B) x) (B x) 0 := by
    simpa using hasDerivAt_exponential_apply B x 0
  apply h.hasDerivWithinAt.congr_of_mem _ Set.self_mem_Ici
  intro t ht
  simp only [realOrbit, exponential_apply, Real.coe_toNNReal t ht]

/-- Exponentiating a nonnegative multiple of `C - I` gives contractions when `‖C‖ ≤ 1`. -/
theorem exponential_isContraction_of_norm_le_one (C : E →L[ℝ] E)
    (hC : ‖C‖ ≤ 1) {c : ℝ} (hc : 0 ≤ c) :
    (exponential (c • (C - 1))).IsContraction := by
  intro t
  rw [exponential_apply]
  have he : (t : ℝ) • (c • (C - 1)) =
      (-(t : ℝ) * c) • (1 : E →L[ℝ] E) + ((t : ℝ) * c) • C := by module
  rw [he, exp_add_of_commute (((Commute.one_left C).smul_left _).smul_right _)]
  have hscalar : exp ((-(t : ℝ) * c) • (1 : E →L[ℝ] E)) =
      Real.exp (-(t : ℝ) * c) • (1 : E →L[ℝ] E) := by
    simpa only [Algebra.algebraMap_eq_smul_one, Real.exp_eq_exp_ℝ] using
      (algebraMap_exp_comm (𝕂 := ℝ) (𝔸 := E →L[ℝ] E) (-(t : ℝ) * c)).symm
  rw [hscalar, smul_mul_assoc, one_mul, norm_smul,
    Real.norm_of_nonneg (Real.exp_nonneg _)]
  calc
    Real.exp (-(t : ℝ) * c) * ‖exp (((t : ℝ) * c) • C)‖ ≤
        Real.exp (-(t : ℝ) * c) * Real.exp ‖((t : ℝ) * c) • C‖ :=
      mul_le_mul_of_nonneg_left
        (norm_exp_le_exp_norm_of_norm_one_le
          (ContinuousLinearMap.norm_id_le (𝕜 := ℝ) (E := E)) _) (Real.exp_nonneg _)
    _ ≤ Real.exp (-(t : ℝ) * c) * Real.exp ((t : ℝ) * c) := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg _)
      apply Real.exp_le_exp.mpr
      rw [norm_smul, Real.norm_of_nonneg (mul_nonneg t.coe_nonneg hc)]
      exact mul_le_of_le_one_right (mul_nonneg t.coe_nonneg hc) hC
    _ = 1 := by rw [← Real.exp_add, neg_mul, neg_add_cancel, Real.exp_zero]

/-- Commuting bounded generators of contraction semigroups satisfy the comparison estimate
`‖e^{tB}x - e^{tC}x‖ ≤ t ‖Bx - Cx‖`. -/
theorem norm_exponential_sub_le (B C : E →L[ℝ] E) (hBC : Commute B C)
    (hB : (exponential B).IsContraction) (hC : (exponential C).IsContraction)
    (t : NNReal) (x : E) :
    ‖exponential B t x - exponential C t x‖ ≤ (t : ℝ) * ‖B x - C x‖ := by
  let f : ℝ → E := fun s ↦ exp (((t : ℝ) - s) • C) (exp (s • B) x)
  let f' : ℝ → E := fun s ↦ exp (((t : ℝ) - s) • C) (exp (s • B) (B x - C x))
  have hd (s : ℝ) : HasDerivAt f (f' s) s := by
    have hleft : HasDerivAt (fun r : ℝ ↦ exp (((t : ℝ) - r) • C))
        (-(exp (((t : ℝ) - s) • C) * C)) s := by
      simpa only [Function.comp_def, neg_smul, one_smul] using
        (hasDerivAt_exp_smul_const C ((t : ℝ) - s)).scomp s
          ((hasDerivAt_id s).const_sub (t : ℝ))
    have hcomm : C (exp (s • B) x) = exp (s • B) (C x) :=
      congrArg (fun M : E →L[ℝ] E ↦ M x) ((hBC.symm.smul_right s).exp_right.eq)
    apply (hleft.clm_apply (hasDerivAt_exponential_apply B x s)).congr_deriv
    change -(exp (((t : ℝ) - s) • C) (C (exp (s • B) x))) +
      exp (((t : ℝ) - s) • C) (exp (s • B) (B x)) = f' s
    rw [hcomm]
    simp only [f', map_sub]
    abel
  have hnorm (s : ℝ) (hs : s ∈ Set.Ico (0 : ℝ) (t : ℝ)) :
      ‖f' s‖ ≤ ‖B x - C x‖ := by
    have hs0 := hs.1
    have hts := sub_nonneg.mpr hs.2.le
    change ‖exp (((t : ℝ) - s) • C) (exp (s • B) (B x - C x))‖ ≤ _
    have h₁ := hC.norm_apply_le ⟨(t : ℝ) - s, hts⟩ (exp (s • B) (B x - C x))
    have h₂ := hB.norm_apply_le ⟨s, hs0⟩ (B x - C x)
    exact h₁.trans h₂
  have h := norm_image_sub_le_of_norm_deriv_le_segment'
    (fun s (_ : s ∈ Set.Icc (0 : ℝ) (t : ℝ)) ↦ (hd s).hasDerivWithinAt)
    hnorm (t : ℝ) ⟨t.coe_nonneg, le_rfl⟩
  simpa only [f, sub_self, sub_zero, zero_smul, exp_zero, one_apply_eq_self,
    exponential_apply, mul_comm] using h

end StronglyContinuousSemigroup

end PDE.Analysis.Evolution
