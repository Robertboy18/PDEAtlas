module

public import PDE.Spaces.Sobolev.Weighted.Density

/-!
# Parity subspaces of completed weighted Sobolev spaces

Fix a coordinate `i`, a sign `c` (in practice `c = ±1`), and a family of row weights `w`. The
completed parity space is the closed subspace of the weighted derivative-jet completion
`CompletedHkSpaceOn n k univ w` generated by those eligible smooth compactly supported functions
(elements of `smoothCoreOn w`) whose Sobolev graph lies in `sobolevReflectionParitySubmodule 2 i c`:
base function a reflection eigenfunction with eigenvalue `c`, derivative rows carrying the
corresponding signs.

The subspace is closed, hence a complete real Hilbert space; it has an isometric
continuous linear inclusion into the ambient completion; and the parity-compatible smooth core is
dense in it, so continuous maps out of it are determined by their values on the core.

If every row weight has a positive lower measure bound, forgetting the weights maps the
completion into the ordinary Sobolev graph space. Its reflection-parity subspace is closed,
so parity passes from the core to every completed jet. This argument does not require an
upper bound on a weight or comparability with its reflection: reflection acts on the
unweighted representatives.

Without these lower bounds, parity is imposed only on the generating core.
Whether an arbitrary completed weighted jet has a function representative is the separate
question addressed in `Weighted.Representation`.

## Main results

* `reflectionParitySmoothCore`: the parity-compatible smooth core, a submodule of
  `smoothCoreOn w`.
* `completedReflectionParitySubmodule`: the closed subspace it generates, complete by
  `completedReflectionParitySubmodule.instCompleteSpace`.
* `completedReflectionParitySubmodule.ofCoreLinearMap`: the map from the core; the canonical
  inclusion into the completion is `Submodule.subtypeL`.
* `completedReflectionParitySubmodule.denseRange_ofCore`,
  `completedReflectionParitySubmodule.continuous_ext`: density of the core and the resulting
  extensionality principle.
* `completedReflectionParitySubmodule.toHk_mem_sobolevReflectionParitySubmodule`:
  under lower measure bounds, every completed jet has the prescribed unweighted parity.
-/

@[expose] public section

noncomputable section

open Set
open scoped ENNReal Sobolev

namespace SobolevSpace
namespace Weighted

variable {n k : ℕ}

/-! ## Parity-compatible smooth core -/

/-- Eligible smooth compactly supported functions whose Sobolev derivative
rows have the parity induced by reflection in coordinate `i` with base
eigenvalue `c`. -/
def reflectionParitySmoothCore
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) :
    Submodule ℝ (smoothCoreOn (Ω := Set.univ) w) :=
  (sobolevReflectionParitySubmodule (n := n) (k := k) 2 i c).comap
    ((coordinatesMemL2WithDensitiesSubmodule
      (n := n) (k := k) (Ω := Set.univ) w).subtype.comp
        (smoothCoreToGraphLinearMap w))

/-- A smooth-core element is parity-compatible exactly when its Sobolev graph lies in
`sobolevReflectionParitySubmodule 2 i c`. -/
@[simp] theorem mem_reflectionParitySmoothCore_iff
    {w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞}
    {i : Fin n} {c : ℝ} {φ : smoothCoreOn (Ω := Set.univ) w} :
    φ ∈ reflectionParitySmoothCore w i c ↔
      (smoothCoreToGraphLinearMap w φ : W^{k,2}(ℝ^n)) ∈
        sobolevReflectionParitySubmodule 2 i c :=
  Iff.rfl

/-- The canonical map from the parity-compatible smooth core into the ambient
completed weighted Sobolev space. -/
def reflectionParitySmoothCoreToCompletedLinearMap
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) :
    reflectionParitySmoothCore w i c →ₗ[ℝ]
      CompletedHkSpaceOn n k Set.univ w :=
  (smoothCoreToCompletedLinearMap w).comp
    (reflectionParitySmoothCore w i c).subtype

/-- The map from the parity core to the completion is the restriction of
`smoothCoreToCompletedLinearMap`. -/
@[simp] theorem reflectionParitySmoothCoreToCompletedLinearMap_apply
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) (φ : reflectionParitySmoothCore w i c) :
    reflectionParitySmoothCoreToCompletedLinearMap w i c φ =
      smoothCoreToCompletedLinearMap w φ :=
  rfl

/-! ## Completed parity space -/

/-- The closed subspace of the weighted Sobolev completion generated by the
parity-compatible smooth core. -/
def completedReflectionParitySubmodule
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) :
    Submodule ℝ (CompletedHkSpaceOn n k Set.univ w) :=
  (reflectionParitySmoothCoreToCompletedLinearMap w i c).range.topologicalClosure

/-- The completed reflection-parity space is complete. -/
instance completedReflectionParitySubmodule.instCompleteSpace
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) :
    CompleteSpace (completedReflectionParitySubmodule w i c) :=
  Submodule.topologicalClosure.completeSpace
    (reflectionParitySmoothCoreToCompletedLinearMap w i c).range

/-- The canonical linear embedding of parity-compatible smooth-core elements
into the completed parity space. -/
def completedReflectionParitySubmodule.ofCoreLinearMap
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) :
    reflectionParitySmoothCore w i c →ₗ[ℝ]
      completedReflectionParitySubmodule w i c where
  toFun φ :=
    ⟨reflectionParitySmoothCoreToCompletedLinearMap w i c φ,
      Submodule.le_topologicalClosure _
        (LinearMap.mem_range_self
          (reflectionParitySmoothCoreToCompletedLinearMap w i c) φ)⟩
  map_add' φ ψ := by
    apply Subtype.ext
    exact (reflectionParitySmoothCoreToCompletedLinearMap w i c).map_add φ ψ
  map_smul' a φ := by
    apply Subtype.ext
    exact (reflectionParitySmoothCoreToCompletedLinearMap w i c).map_smul a φ

/-- Viewed in the ambient completion, the image of a parity-core element under
`ofCoreLinearMap` is its image under `reflectionParitySmoothCoreToCompletedLinearMap`. -/
@[simp] theorem completedReflectionParitySubmodule.ofCoreLinearMap_apply
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) (φ : reflectionParitySmoothCore w i c) :
    (completedReflectionParitySubmodule.ofCoreLinearMap w i c φ :
        CompletedHkSpaceOn n k Set.univ w) =
      reflectionParitySmoothCoreToCompletedLinearMap w i c φ :=
  rfl

/-- Parity-compatible smooth compactly supported functions are dense in the
completed reflection-parity space. -/
theorem completedReflectionParitySubmodule.denseRange_ofCore
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (i : Fin n) (c : ℝ) :
    DenseRange
      (completedReflectionParitySubmodule.ofCoreLinearMap w i c) := by
  rw [Metric.denseRange_iff]
  intro U ε hε
  have hU :
      (U : CompletedHkSpaceOn n k Set.univ w) ∈
        closure
          ((reflectionParitySmoothCoreToCompletedLinearMap w i c).range :
            Set (CompletedHkSpaceOn n k Set.univ w)) := by
    rw [← Submodule.topologicalClosure_coe]
    exact U.property
  obtain ⟨V, hV, hVU⟩ := (Metric.mem_closure_iff.1 hU) ε hε
  obtain ⟨φ, rfl⟩ := hV
  exact ⟨φ, hVU⟩

/-- Two continuous maps on the completed parity space are equal when they
agree on every parity-compatible smooth-core element. -/
theorem completedReflectionParitySubmodule.continuous_ext
    {β : Type*} [TopologicalSpace β] [T2Space β]
    {w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞}
    {i : Fin n} {c : ℝ}
    {F G : completedReflectionParitySubmodule w i c → β}
    (hF : Continuous F) (hG : Continuous G)
    (h_eq : ∀ φ : reflectionParitySmoothCore w i c,
      F (completedReflectionParitySubmodule.ofCoreLinearMap w i c φ) =
        G (completedReflectionParitySubmodule.ofCoreLinearMap w i c φ)) :
    F = G :=
  (completedReflectionParitySubmodule.denseRange_ofCore w i c).equalizer
    hF hG (funext h_eq)

/-- If `D a ≠ ∞` and `domainMeasure n univ ≤ D a • (domainMeasure n univ).withDensity (w a)` for
every row `a`, then the unweighted image `CompletedHkSpaceOn.toHkCLMOfMeasureLeSmul w D hD hlower U`
of every element `U` of the completed parity space lies in `sobolevReflectionParitySubmodule 2 i c`.
The map is continuous and the target is closed (`isClosed_sobolevReflectionParitySubmodule`), so
parity passes from the core to its closure. The weights need not be bounded above. -/
theorem completedReflectionParitySubmodule.toHk_mem_sobolevReflectionParitySubmodule
    (w : GraphSpace.DerivIndex n k → ℝ^n → ℝ≥0∞)
    (D : GraphSpace.DerivIndex n k → ℝ≥0∞)
    (hD : ∀ a, D a ≠ ∞)
    (hlower : ∀ a, domainMeasure n Set.univ ≤
      D a • (domainMeasure n Set.univ).withDensity (w a))
    (i : Fin n) (c : ℝ) (U : completedReflectionParitySubmodule w i c) :
    CompletedHkSpaceOn.toHkCLMOfMeasureLeSmul w D hD hlower U ∈
      sobolevReflectionParitySubmodule 2 i c := by
  have hmaps : Set.MapsTo
      (CompletedHkSpaceOn.toHkCLMOfMeasureLeSmul w D hD hlower)
      ((reflectionParitySmoothCoreToCompletedLinearMap w i c).range : Set _)
      (sobolevReflectionParitySubmodule (n := n) (k := k) 2 i c :
        Set (W^{k,2}(ℝ^n))) := by
    rintro _ ⟨φ, rfl⟩
    change CompletedHkSpaceOn.toHkCLMOfMeasureLeSmul w D hD hlower
      (CompletedHkSpaceOn.ofGraph w (smoothCoreToGraphLinearMap w φ)) ∈ _
    rw [CompletedHkSpaceOn.toHkCLMOfMeasureLeSmul_ofGraph]
    exact φ.property
  exact hmaps.closure_left
    (CompletedHkSpaceOn.toHkCLMOfMeasureLeSmul w D hD hlower).continuous
    (isClosed_sobolevReflectionParitySubmodule 2 i c) U.property

end Weighted
end SobolevSpace
