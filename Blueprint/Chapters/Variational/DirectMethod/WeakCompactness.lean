# Weak compactness toolkit

:::theorem "analysis.weak_compactness.hilbert_reflexive" (parent := "methods.direct_method") (lean := "PDE.Analysis.inclusionInDoubleDual_surjective")
%%%
source := {
  document := "evans-pde"
  spans := #[{
